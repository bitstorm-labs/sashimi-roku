{
  "rootDir": ".",
  "stagingDir": "out",
  "retainStagingDir": true,
  "files": [
    "manifest",
    "source/**/*",
    "components/**/*",
    "images/**/*",
    "locale/**/*",
    "fonts/**/*"
  ],
  "autoImportComponentScript": true,
  "sourceMap": false,
  "diagnosticFilters": [
    {
      "src": "tests/**/*"
    }
  ],
  "outFile": "out/sashimi-roku.zip"
}
