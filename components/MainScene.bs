import "pkg:/source/utils/Registry.bs"
import "pkg:/source/utils/Servers.bs"
import "pkg:/source/utils/AppSettings.bs"

' tvOS-parity navigation: persistent top TabBar (Home/Library/Search/Settings)
' with root screens kept alive, plus a push stack for detail/grid screens.
' Back: pop stack -> non-Home tab returns Home -> Home exits app (tvOS Menu behavior).

sub init()
    m.navStack = []
    m.currentScreen = invalid
    m.rootScreens = {}          ' keyed by selection id: "home"/"search"/"settings"/"lib:<id>"
    m.activeSelection = "home"
    m.railWidth = 136           ' collapsed rail; root screens sit to its right

    budget = readMemoryBudget()
    m.global.addFields({
        serverUrl: ""
        authToken: ""
        userId: ""
        deviceId: ""
        toastMessage: {}
        measuredBitrate: 0
        showQualityBadges: (AppSettings.read("showQualityBadges", "true") = "true")
        showReviewRatings: (AppSettings.read("showReviewRatings", "true") = "true")
        useEpisodeRatings: (AppSettings.read("useEpisodeRatings", "false") = "true")
        playThemeSongs: (AppSettings.read("playThemeSongs", "true") = "true")
        memoryTier: budget.tier
        memoryLimitKb: budget.limitKb
        reminderShowing: false
    })

    initDeviceId()

    ' Left pullout sidebar (created up front, shown after login)
    m.sidebar = createObject("roSGNode", "Sidebar")
    m.sidebar.visible = false
    m.sidebar.observeFieldScoped("navChoice", "onNavChoice")
    m.sidebar.observeFieldScoped("descend", "onSidebarDescend")
    m.sidebar.observeFieldScoped("switchServer", "onSidebarSwitchServer")

    ' Global toast overlay (always on top)
    m.toast = createObject("roSGNode", "ToastOverlay")

    ' Guide reminders ring over whatever screen is up.
    m.reminderBanner = createObject("roSGNode", "ReminderBanner")
    m.reminderBanner.observeFieldScoped("playItem", "onReminderPlay")
    m.global.observeFieldScoped("toastMessage", "onGlobalToast")

    ' Deep-link cover. A direct-play deep link keeps its detail screen hidden
    ' until it hands off to the player (see processDeepLink), and pushScreen
    ' hides the previous screen and the sidebar — so against an unreachable
    ' server NOTHING was drawn until the request expired. Up to 30s of pure
    ' black is the dead-end shape cert 3.4 is written against, on the exact path
    ' reviewers test. Painted in the manifest's splash colour so the handover
    ' from the OS splash is seamless.
    m.deepLinkCover = createObject("roSGNode", "Group")
    m.deepLinkCover.visible = false
    coverBg = m.deepLinkCover.createChild("Rectangle")
    coverBg.width = 1920
    coverBg.height = 1080
    coverBg.color = "#1a1a2e"
    coverLabel = m.deepLinkCover.createChild("Label")
    coverLabel.text = "Loading..."
    coverLabel.color = "#8C8C8C"
    coverLabel.horizAlign = "center"
    coverLabel.width = 1920
    coverLabel.translation = [0, 520]
    m.top.appendChild(m.deepLinkCover)

    ' ...and don't sit behind it for the full HTTP timeout either. 15s matches
    ' cert 3.2's own "something on screen by now" number and still leaves ample
    ' room for a single getItem against a slow remote server.
    m.deepLinkTimer = CreateObject("roSGNode", "Timer")
    m.deepLinkTimer.repeat = false
    m.deepLinkTimer.duration = 15
    m.deepLinkTimer.observeFieldScoped("fire", "onDeepLinkTimeout")
    m.top.appendChild(m.deepLinkTimer)

    ' Theme songs. The player and the per-show visit state live here, at the one
    ' place that already knows what is current, so screens only ever report
    ' intent -- no screen starts or stops audio itself. Non-visual, so its
    ' position among the scene's children does not matter.
    m.themePlayer = createObject("roSGNode", "ThemeSongPlayer")
    m.top.appendChild(m.themePlayer)

    ' Multi-server: migrate legacy single auth, observe switch requests
    Servers.migrate()
    m.global.addFields({ switchServerId: "" })
    ' Set by detail screens after a watched-state mutation; Home consumes it to
    ' refresh immediately on return (bypassing the 20s debounce) so Continue
    ' Watching never shows a stale just-dismissed show.
    m.global.addFields({ watchStateDirty: false })
    ' Session-scoped subtitle memory (tvOS parity): the chosen track TITLE
    ' ("" = nothing chosen yet, "OFF" = explicitly disabled). Raw stream
    ' indexes are per-file, so the player re-matches by title each episode.
    m.global.addFields({ sessionSubtitleTitle: "" })
    ' Session-scoped view mode (#135): the ViewMode key picked in the player
    ' ("" = none this session, so the Default View Mode setting applies). Lasts
    ' until the app exits, across videos, channels and stream restarts.
    m.global.addFields({ sessionViewMode: "" })
    ' Physical folder roots of libraries NAMED "youtube" (from VirtualFolders,
    ' e.g. /media/pf/shows). A Continue Watching item "came from the YouTube
    ' library" iff its Path sits under one of these — the reliable signal, since
    ' Pinchflat channel names only sometimes carry the " - Videos" suffix the
    ' old heuristic keyed on. Empty when unknown (non-admin token) → detection
    ' falls back to the name/suffix heuristics with no regression.
    m.global.addFields({ youtubePaths: [] })
    ' Set by any screen that gets a 401/403 back: the stored token is no longer
    ' valid, so the only correct move is to sign out and re-authenticate.
    m.global.addFields({ sessionExpired: false })
    ' Cert 3.2: AppLaunchComplete marks a fully rendered first screen. Screens
    ' report "home" (rows or the can't-reach-server message are up) and
    ' "playback" (video is playing); onLaunchMilestone fires the beacon once.
    m.global.addFields({ launchMilestone: "" })
    m.global.observeFieldScoped("launchMilestone", "onLaunchMilestone")
    m.launchBeaconSent = false
    m.homeRendered = false
    ' A direct-play deep link at launch must fire on playback, not on the Home
    ' rendering behind it.
    m.awaitingLaunchPlayback = false
    m.global.observeField("sessionExpired", "onSessionExpired")
    m.global.observeFieldScoped("switchServerId", "onSwitchServer")

    m.pendingDeepLink = invalid

    ' Discarded screens waiting for their API task to be stopped (see
    ' retireScreen). The timer only runs while that list is non-empty.
    m.pendingReap = []
    m.reapTimer = CreateObject("roSGNode", "Timer")
    m.reapTimer.repeat = true
    m.reapTimer.duration = 1
    m.reapTimer.observeFieldScoped("fire", "onReapTick")
    m.top.appendChild(m.reapTimer)

    ' Server the user just switched away from: the preferred way back if the
    ' one they switched to turns out to have an expired login (#163).
    m.switchedFromId = ""

    ' No active login, but another saved server may still have one -- the
    ' active one's was cleared when its server rejected it. Never strand the
    ' user on sign-in while a saved server can still be restored (#163).
    if not hasSavedSession()
        fallback = Servers.usableFallback(Servers.getActiveId())
        if fallback <> invalid then Servers.activate(fallback.id)
    end if

    if hasSavedSession()
        restoreSession()
        enterMainUI()
        processDeepLink()
    else
        ' Nothing to restore. If the last server is still saved, offer to sign
        ' back in to it rather than a blank form.
        showAuthScreen(Servers.get(Servers.getActiveId()))
    end if
end sub

' ---------- Launch beacon (cert 3.2) ----------
sub onLaunchMilestone()
    milestone = m.global.launchMilestone
    if milestone = "home" then m.homeRendered = true
    if milestone = "home" and m.awaitingLaunchPlayback then return
    if milestone = "home" or milestone = "playback" then signalLaunchComplete()
end sub

sub signalLaunchComplete()
    if m.launchBeaconSent then return
    m.launchBeaconSent = true
    m.awaitingLaunchPlayback = false
    m.top.signalBeacon("AppLaunchComplete")
end sub

' ---------- Deep linking (cert 5.2) ----------
' contentId = Jellyfin item id. movie/episode play directly; everything
' else opens the item's detail screen. Links arriving before auth are
' processed right after login.
sub onLaunchArgs()
    args = m.top.launchArgs
    if args = invalid or not args.doesExist("contentId") then return
    m.pendingDeepLink = { contentId: args.contentId, mediaType: LCase(args.lookup("mediaType") ?? "") }
    if m.rootScreens.DoesExist("home") then processDeepLink()
end sub

' Roku's deep-linking spec defines eight mediaTypes. All of them must begin
' playback immediately (cert 5.2, Direct to Play) EXCEPT "season", which is
' explicitly allowed to open a springboard highlighting the season's episodes.
' Only movie/episode played before; series, shortFormVideo, tvSpecial, liveFeed
' and sportsEvent all wrongly stopped at the springboard.
function isDirectPlayType(mediaType as string) as boolean
    if mediaType = "" then return false
    playTypes = {
        movie: true,
        episode: true,
        series: true,
        shortformvideo: true,
        tvspecial: true,
        livefeed: true,
        sportsevent: true
    }
    return (playTypes[mediaType] = true)
end function

sub processDeepLink()
    dl = m.pendingDeepLink
    if dl = invalid then return
    m.pendingDeepLink = invalid
    if dl.contentId = invalid or dl.contentId = ""
        failDeepLink()
        return
    end if
    ' Pop anything stacked so the link lands in a predictable place
    while m.navStack.count() > 0
        popScreen()
    end while
    ' _deepLink lets the detail resolve YouTube-ness from the library ancestor
    ' (no originating flag exists on a deep-link / Top Shelf entry).
    item = { Id: dl.contentId, _deepLink: true }
    screen = createObject("roSGNode", "MediaDetailScreen")
    if screen = invalid then return
    screen.observeFieldScoped("selectedItem", "onItemSelected")
    screen.observeFieldScoped("playItem", "onPlayItem")
    screen.observeFieldScoped("selectedPerson", "onPersonSelected")
    screen.observeFieldScoped("deepLinkFailed", "onDeepLinkFailed")
    if isDirectPlayType(dl.mediaType)
        screen.autoPlay = true
        if not m.launchBeaconSent then m.awaitingLaunchPlayback = true
        ' Direct to Play means the viewer goes from the voice command straight
        ' into video. Keep the springboard hidden until it hands off to the
        ' player; the detail screen reveals itself at that moment so backing
        ' out of playback still lands somewhere sensible.
        screen.visible = false
    end if
    pushScreen(screen)
    if isDirectPlayType(dl.mediaType)
        ' Only the hidden path needs covering; a season springboard is visible
        ' and draws its own "Loading..." while it resolves. pushScreen has
        ' already lifted the cover above the new screen.
        m.deepLinkCover.visible = true
        m.deepLinkTimer.control = "start"
    end if
    screen.itemData = item
end sub

' The link resolved (or failed) — take the cover down and disarm the watchdog.
sub endDeepLinkWait()
    m.deepLinkTimer.control = "stop"
    m.deepLinkCover.visible = false
end sub

sub onDeepLinkTimeout()
    ' Reached only while the cover is still up, i.e. the item never resolved.
    failDeepLink()
end sub

' Invalid contentId / unavailable content: the spec requires an error message
' and a return to the home screen.
sub onDeepLinkFailed(event as object)
    if event.getData() <> true then return
    failDeepLink()
end sub

sub failDeepLink()
    endDeepLinkWait()
    ' Nothing will play, so the launch ends at Home instead.
    m.awaitingLaunchPlayback = false
    if m.homeRendered then signalLaunchComplete()
    while m.navStack.count() > 0
        popScreen()
    end while
    m.global.toastMessage = { message: "That content isn't available" }
end sub

' Settings/home ask for a server switch via m.global.switchServerId.
sub showServerSwitchDialog()
    m.svChoices = Servers.getAll()
    dialog = createObject("roSGNode", "StandardMessageDialog")
    dialog.title = "Switch Server"
    buttons = []
    activeId = Servers.getActiveId()
    for each s in m.svChoices
        label = s.userName + " " + Chr(8226) + " " + s.name
        if s.id = activeId then label = label + " (active)"
        buttons.push(label)
    end for
    buttons.push("Add Server")
    buttons.push("Cancel")
    dialog.buttons = buttons
    dialog.observeFieldScoped("buttonSelected", "onServerDialogButton")
    m.top.getScene().dialog = dialog
end sub

sub onServerDialogButton()
    dialog = m.top.getScene().dialog
    if dialog = invalid then return
    idx = dialog.buttonSelected
    dialog.close = true
    if idx < m.svChoices.count()
        m.global.switchServerId = m.svChoices[idx].id
    else if idx = m.svChoices.count()
        m.global.switchServerId = "__add__"
    end if
end sub

sub onSwitchServer()
    id = m.global.switchServerId
    if id = invalid or id = "" then return
    ' addFields() cannot declare alwaysNotify, so SceneGraph only notifies on a
    ' CHANGE: leaving the consumed id in place made an identical second request
    ' ("Add Server" twice, or re-picking the already-active server) a silent
    ' no-op. Clearing it here re-arms the field. The write below re-enters this
    ' handler with "", which the guard above drops.
    m.global.switchServerId = ""
    if id = "__add__"
        showAuthScreen()
        return
    end if
    target = Servers.get(id)
    if target = invalid then return
    if target.token = invalid or target.token = ""
        ' Already known to be expired (#163): straight to a prefilled re-auth
        ' for it. The current server stays active underneath, so Cancel/Back
        ' returns to it and a relaunch restores it.
        showAuthScreen(target)
        return
    end if
    previousId = Servers.getActiveId()
    if previousId <> id then m.switchedFromId = previousId
    entry = Servers.activate(id)
    if entry = invalid then return
    clearAllScreens()
    restoreSession()
    enterMainUI()
end sub

' ---------- Memory budget ----------
' Roku gives a channel a fixed heap and this app is artwork-heavy: rows of
' posters, 1280px hero backdrops, 1920x1080 trickplay sheets. Older models get a
' markedly smaller budget than a current one, so read it once at launch and let
' the screens decide from it how much artwork they may keep while it is off
' screen (see HomeScreen.applyAutoRefresh). Guarded like the subscription in
' Main.bs: an invalid here would take the whole channel down at launch.
function readMemoryBudget() as object
    appMem = CreateObject("roAppMemoryMonitor")
    if appMem = invalid then return { tier: "normal", limitKb: 0 }
    ' GetChannelMemoryLimit answers with an AA of KB budgets, NOT a scalar --
    ' { maxForegroundMemory, maxBackgroundMemory, maxRokuManagedHeapMemory } --
    ' so it has to be unpacked before it can be compared to anything. The dev
    ' soundbar reports 331776 KB foreground / ~302000 KB available at launch.
    limits = appMem.GetChannelMemoryLimit()
    limitKb = 0
    if type(limits) = "roAssociativeArray" and limits.maxForegroundMemory <> invalid
        limitKb = limits.maxForegroundMemory
    end if
    availKb = appMem.GetChannelAvailableMemory()
    #if DEBUG
        print "[Mem] limitKB "; limitKb; " availKB "; availKb; " used% "; appMem.GetMemoryLimitPercent()
    #end if
    ' 192 MB splits the current 4K models (200 MB and up) from the older ones
    ' this is really aimed at, and a launch that already starts with under
    ' 128 MB of headroom counts as constrained whatever the nominal budget is.
    tier = "normal"
    if limitKb > 0 and limitKb <= 196608
        tier = "low"
    else if availKb > 0 and availKb <= 131072
        tier = "low"
    end if
    return { tier: tier, limitKb: limitKb }
end function

' ---------- Memory pressure ----------
' Main.bs raises m.top.lowMemory from the main thread's message loop. Hand it to
' everything that holds bulk artwork; each screen frees only what the viewer
' cannot currently see (a hidden root screen's whole grid, the player's
' trickplay sheet) and restores itself when it comes back on screen, so this
' never takes artwork off the screen being looked at.
sub onLowMemory()
    if not m.top.lowMemory then return
    m.top.lowMemory = false
    #if DEBUG
        print "[Mem] low memory reported -- releasing off-screen artwork"
    #end if
    for each key in m.rootScreens
        releaseArtwork(m.rootScreens[key])
    end for
    for each screen in m.navStack
        releaseArtwork(screen)
    end for
end sub

' callFunc against a component that does not declare the function is an error,
' so the screens that do are named rather than probed.
sub releaseArtwork(screen as object)
    if screen = invalid then return
    kind = screen.subtype()
    if kind = "HomeScreen" or kind = "LibraryScreen" or kind = "PlayerScreen"
        screen.callFunc("releaseArtwork", "pressure")
    end if
end sub

sub initDeviceId()
    deviceId = Registry.read("device", "deviceId")
    if deviceId = ""
        deviceId = CreateObject("roDeviceInfo").GetChannelClientId()
        Registry.write("device", "deviceId", deviceId)
    end if
    m.global.deviceId = deviceId
end sub

function hasSavedSession() as boolean
    return Registry.hasAuth()
end function

sub restoreSession()
    m.global.serverUrl = Registry.getServerUrl()
    m.global.authToken = Registry.getAuthToken()
    m.global.userId = Registry.getUserId()
end sub

' An expired/revoked token cannot be retried around -- clear the stored auth
' and send the user back to sign-in rather than leaving a dead UI up.
'
' That used to be the whole story, and with more than one saved server it
' stranded people (#163): picking a server whose login had expired cleared the
' active auth, so the sign-in screen had no Cancel (Back exited the app) and a
' relaunch found no session -- while another saved server's login was still
' perfectly good. Now the dead login is dropped from its saved entry only, a
' server that may still work (preferably the one just switched away from)
' becomes active underneath, and sign-in opens prefilled for the expired server
' with Cancel back to it, as on Apple.
sub onSessionExpired()
    if not m.global.sessionExpired then return
    m.global.sessionExpired = false
    expiredId = Servers.getActiveId()
    expired = Servers.get(expiredId)
    if expired <> invalid then Servers.expire(expiredId)
    Registry.clearAuth()
    m.global.serverUrl = ""
    m.global.authToken = ""
    m.global.userId = ""
    fallback = Servers.usableFallback(expiredId, m.switchedFromId)
    m.switchedFromId = ""
    if fallback <> invalid then Servers.activate(fallback.id)
    m.global.toastMessage = { message: "Session expired. Please sign in again." }
    showAuthScreen(expired)
end sub

sub onGlobalToast()
    msg = m.global.toastMessage
    if msg <> invalid and msg.message <> invalid and msg.message <> ""
        m.toast.showToast = msg
    end if
end sub

' ---------- Auth ----------

' prefill: a saved server entry to sign back in to (its url and user name
' fill the form), or invalid for a blank form.
sub showAuthScreen(prefill = invalid as dynamic)
    m.top.signalBeacon("AppDialogInitiate")
    clearAllScreens()
    ' A second login screen appended over the first is full-screen, unfocused
    ' and unreachable — only the newest is ever removed on success, so the dead
    ' one stays on top of the app forever. Never keep more than one.
    dismissAuthScreen()
    screen = createObject("roSGNode", "ServerConnectionScreen")
    ' Adding a server while already signed in — let the user cancel back to
    ' the current server instead of being stranded (or exiting the app).
    screen.canCancel = hasSavedSession()
    if prefill <> invalid and prefill.url <> invalid and prefill.url <> ""
        userName = ""
        if prefill.userName <> invalid then userName = prefill.userName
        screen.prefill = { serverUrl: prefill.url, userName: userName }
    end if
    screen.observeFieldScoped("loginSuccess", "onLoginSuccess")
    screen.observeFieldScoped("cancelled", "onAuthCancelled")
    m.top.appendChild(screen)
    m.authScreen = screen
    screen.setFocus(true)
end sub

sub dismissAuthScreen()
    if m.authScreen = invalid then return
    m.top.removeChild(m.authScreen)
    retireScreen(m.authScreen)
    m.authScreen = invalid
end sub

sub onAuthCancelled()
    m.top.signalBeacon("AppDialogComplete")
    dismissAuthScreen()
    ' Restore the still-active session's main UI.
    restoreSession()
    enterMainUI()
end sub

sub onLoginSuccess()
    m.top.signalBeacon("AppDialogComplete")
    ' Record/refresh this login in the multi-server list
    Servers.addFromCurrentAuth()
    m.switchedFromId = ""
    dismissAuthScreen()
    enterMainUI()
    processDeepLink()
end sub

sub onSignOut()
    showAuthScreen()
end sub

' ---------- Main tabbed UI ----------

sub measureConnection()
    ' Background bandwidth probe so the first play uses a link-appropriate
    ' Auto bitrate (no stall on weak remote downstreams).
    ' enterMainUI() runs again on every login, auth-cancel and server switch, so
    ' drop any earlier probe first — its thread would otherwise sit in wait()
    ' for the life of the channel.
    stopBandwidthProbe()
    task = createObject("roSGNode", "JellyfinApi")
    task.observeFieldScoped("response", "onBandwidthMeasured")
    m.bwTask = task
    task.control = "RUN"
    task.request = { action: "measureBandwidth" }
end sub

sub stopBandwidthProbe()
    if m.bwTask = invalid then return
    m.bwTask.control = "stop"
    m.bwTask = invalid
end sub

sub onBandwidthMeasured()
    if m.bwTask = invalid then return
    r = m.bwTask.response
    if r <> invalid and r.action = "measureBandwidth" and r.bitrate > 0
        m.global.measuredBitrate = r.bitrate
        #if DEBUG
            print "[BW] measured " + str(Int(r.bitrate / 1000000)).Trim() + " Mbps"
        #end if
    end if
    ' One-shot probe: nothing else is ever asked of this task.
    stopBandwidthProbe()
end sub

sub enterMainUI()
    measureConnection()
    switchSelection({ kind: "home" })
    ' Every way in (session restore, either sign-in path, auth cancel, server
    ' switch) now has its final credentials in place, so this is the moment the
    ' rail's libraries and avatar can load. The sidebar used to key that only
    ' off m.global.serverUrl CHANGING -- which, on a sign-in from an empty
    ' session, happens when the sign-in screen first probes the address, before
    ' any token exists. That load got a 401 and no user, and the real sign-in
    ' rewrote the same url, so nothing reloaded: no Movies/TV/YouTube and a "?"
    ' avatar until a relaunch (#162).
    m.sidebar.callFunc("reloadSession")

    liftOverlays()
    m.sidebar.visible = true
    m.reminderBanner.active = true

    ' Focus the content so the app opens with the rail resting (collapsed);
    ' LEFT from content reveals/expands the rail (Plex behavior).
    screen = m.rootScreens["home"]
    if screen <> invalid then screen.setFocus(true)
end sub

function choiceId(choice as object) as string
    if choice.kind = "library" and choice.library <> invalid then return "lib:" + choice.library.id
    return choice.kind
end function

' Create/fetch a cached root screen for a nav choice. Root screens sit to the
' right of the collapsed rail so the sidebar overlays them cleanly.
function getOrCreateRootScreen(choice as object) as object
    id = choiceId(choice)
    if m.rootScreens.DoesExist(id) then return m.rootScreens[id]

    screen = invalid
    kind = choice.kind
    if kind = "home"
        screen = createObject("roSGNode", "HomeScreen")
        screen.observeFieldScoped("selectedItem", "onItemSelected")
        screen.observeFieldScoped("playItem", "onPlayItem")
    else if kind = "fintv"
        screen = createObject("roSGNode", "GuideScreen")
        screen.observeFieldScoped("playItem", "onPlayItem")
    else if kind = "search"
        screen = createObject("roSGNode", "SearchScreen")
        screen.observeFieldScoped("selectedItem", "onItemSelected")
    else if kind = "settings"
        screen = createObject("roSGNode", "SettingsScreen")
        screen.observeFieldScoped("signOut", "onSignOut")
    else if kind = "library"
        screen = createObject("roSGNode", "LibraryScreen")
        screen.observeFieldScoped("selectedItem", "onItemSelected")
        screen.observeFieldScoped("playItem", "onPlayItem")
    end if

    if screen <> invalid
        ' Shift right of the rail; append above the OS scene background
        ' (never insert at 0 — the OS background poster lives there).
        screen.translation = [m.railWidth, 0]
        m.top.appendChild(screen)
        m.rootScreens[id] = screen
        if kind = "library" then screen.libraryData = choice.library
        liftOverlays()
    end if
    return screen
end function

' The one place the shown root screen changes, so the one place the rail is
' told. Every way back to Home -- sign-in, restore, auth cancel, server switch,
' Back from a root screen -- comes through here; the rail used to keep its own
' last roamed row and went on highlighting Settings or TV over Home.
sub switchSelection(choice as object)
    m.activeSelection = choiceId(choice)
    m.sidebar.selectedId = m.activeSelection
    for each key in m.rootScreens
        m.rootScreens[key].visible = false
    end for
    screen = getOrCreateRootScreen(choice)
    if screen <> invalid
        screen.visible = true
        m.currentScreen = screen
    end if
end sub

' Keep the deep-link cover, sidebar and toast as the topmost scene children, in
' that order.
' Re-parenting a focused node orphans remote focus — preserve and restore it.
sub liftOverlays()
    hadFocus = m.sidebar.isInFocusChain()
    m.top.removeChild(m.deepLinkCover)
    m.top.appendChild(m.deepLinkCover)
    m.top.removeChild(m.sidebar)
    m.top.appendChild(m.sidebar)
    m.top.removeChild(m.toast)
    m.top.appendChild(m.toast)
    m.top.removeChild(m.reminderBanner)
    m.top.appendChild(m.reminderBanner)
    if hadFocus then m.sidebar.setFocus(true)
end sub

sub onNavChoice()
    choice = m.sidebar.navChoice
    if choice = invalid or choice.kind = invalid then return
    switchSelection(choice)
    ' User is roaming the rail — keep focus on it (descend via OK/right)
    m.sidebar.setFocus(true)
end sub

sub onSidebarDescend()
    screen = m.rootScreens[m.activeSelection]
    if screen <> invalid then screen.setFocus(true)
end sub

sub onSidebarSwitchServer()
    showServerSwitchDialog()
end sub

' ---------- Push stack (grid + detail) ----------

sub onItemSelected(event as object)
    item = event.getData()
    if item <> invalid and item.Name <> invalid
        ' Item titles are the user's personal library — debug builds only
        #if DEBUG
            print "[Nav] Item selected"
        #end if
        showDetailScreen(item)
    end if
end sub

' A cast/crew member on a detail screen. PersonScreen stacks on top of that
' detail, so Back returns to it; a title picked from the filmography opens as
' a normal detail screen on top of the person.
sub onPersonSelected(event as object)
    person = event.getData()
    if person = invalid or person.Id = invalid then return
    screen = createObject("roSGNode", "PersonScreen")
    if screen = invalid then return
    screen.observeFieldScoped("selectedItem", "onItemSelected")
    pushScreen(screen)
    screen.personData = person
end sub

' "Switch to <server>" on a detail screen showing another saved server's title
' (#120), after the viewer confirmed it. Same path as the sidebar's server
' switch, then the title reopens on the now-active server, playable. The stack
' built on the old server (home, the person) goes with the switch, as it does
' for any server switch: its ids belong to the old server.
sub onDetailSwitchServer(event as object)
    req = event.getData()
    if req = invalid or req.serverId = invalid or req.item = invalid then return
    entry = Servers.activate(req.serverId)
    if entry = invalid
        m.global.toastMessage = { message: "That server is no longer saved." }
        return
    end if
    clearAllScreens()
    restoreSession()
    enterMainUI()
    showDetailScreen(req.item)
end sub

sub pushScreen(screen as object)
    if m.currentScreen <> invalid
        m.currentScreen.visible = false
    end if
    m.sidebar.visible = false
    m.top.appendChild(screen)
    m.navStack.push(screen)
    liftOverlays()
    m.currentScreen = screen
    screen.setFocus(true)
end sub

sub showDetailScreen(itemData as object)
    screen = createObject("roSGNode", "MediaDetailScreen")
    if screen = invalid then return

    screen.observeFieldScoped("selectedItem", "onItemSelected")
    screen.observeFieldScoped("playItem", "onPlayItem")
    screen.observeFieldScoped("selectedPerson", "onPersonSelected")
    screen.observeFieldScoped("switchServer", "onDetailSwitchServer")

    ' Remember which show this screen counts towards, so popScreen can close the
    ' visit without re-deriving it from an item the screen may have replaced by
    ' then. addField keeps the bookkeeping here rather than putting a
    ' MainScene-only field on MediaDetailScreen's public interface.
    key = themeKeyFor(itemData)
    screen.addField("themeKey", "string", false)
    screen.themeKey = key

    pushScreen(screen)
    screen.itemData = itemData
    enterTheme(key)
end sub

' ---------- Theme songs ----------
' See ThemeSongPlayer for the visit model (and for why Roku cannot fade).

' The show a detail screen belongs to. A series is its own key; a season or an
' episode uses its parent series, which is what makes drilling down inside one
' show a continuation of the same visit instead of a new one. Everything else
' -- movies, and deep links that arrive as a bare id with no Type -- has no key
' and never plays.
function themeKeyFor(item as object) as string
    if item = invalid then return ""
    ' A title on another saved server (#120): the theme player fetches from the
    ' active session, where this id means nothing.
    if item._server <> invalid then return ""
    itemType = ""
    if item.Type <> invalid then itemType = item.Type
    if itemType = "Series"
        if item.Id <> invalid then return item.Id
    else if itemType = "Season" or itemType = "Episode"
        if item.SeriesId <> invalid then return item.SeriesId
    end if
    return ""
end function

sub enterTheme(key as string)
    if key = "" then return
    m.themePlayer.callFunc("enterSeries", key)
end sub

' Screens that never carried a key (library grids, the player, deep-link
' springboards) have no themeKey field at all, hence the hasField guard.
sub exitTheme(screen as object)
    if screen = invalid then return
    if not screen.hasField("themeKey") then return
    key = screen.themeKey
    if key = "" then return
    m.themePlayer.callFunc("exitSeries", key)
end sub

sub onPlayItem(event as object)
    playData = event.getData()
    if playData = invalid or playData.item = invalid then return
    ' A screen that has already been discarded — a deep link the watchdog gave
    ' up on, say — can still land a late response and ask for playback. Its
    ' observers outlive its parenting, so the parent is the reliable test: a
    ' retired screen has been removeChild'd and must not open a player behind
    ' the home screen the viewer was just returned to.
    src = event.getRoSGNode()
    if src <> invalid and src.getParent() = invalid then return
    ' The player only knows the active session, so a detail screen browsing
    ' another saved server must never reach it (#120). Its Play controls are
    ' already replaced by "Switch to"; this backs that up for any late
    ' response that would otherwise start playback.
    if src <> invalid and src.hasField("pinnedServerId") and src.pinnedServerId <> "" then return
    ' Whatever it was waiting on has arrived — including a deep link handing off.
    endDeepLinkWait()
    #if DEBUG
        print "[Nav] Play requested: " + playData.action
    #end if

    ' Every path that starts video or a trailer -- Play, Resume, Shuffle, the
    ' resolved series/season target, the local trailer, the library grid's
    ' direct play and both deep-link paths -- funnels through here, so this is
    ' the one place the theme has to be stopped.
    m.themePlayer.callFunc("stopPlayback", "playback")

    screen = createObject("roSGNode", "PlayerScreen")
    if screen = invalid then return
    screen.observeFieldScoped("done", "onPlayerDone")
    pushScreen(screen)
    screen.playAction = playData.action
    ' Set before itemData: onItemDataChanged is what starts the stream, and a
    ' channel has to know it is a channel before the first byte is requested,
    ' or it reports a play session it should never have opened.
    if playData.channelContext <> invalid then screen.channelContext = playData.channelContext
    screen.itemData = playData.item
end sub

sub onPlayerDone()
    ' Pop the player; refresh the underlying detail item's progress via reload
    popScreen()
end sub

sub popScreen()
    if m.navStack.count() = 0 then return
    ' Backing out of a still-resolving deep link must take its cover with it,
    ' or the app is left staring at an unattached "Loading...".
    endDeepLinkWait()

    screen = m.navStack.pop()
    exitTheme(screen)
    m.top.removeChild(screen)
    retireScreen(screen)

    if m.navStack.count() > 0
        m.currentScreen = m.navStack.peek()
    else
        m.currentScreen = m.rootScreens[m.activeSelection]
        m.sidebar.visible = true
    end if
    if m.currentScreen <> invalid
        m.currentScreen.visible = true
        m.currentScreen.setFocus(true)
    end if
end sub

' A reminder tuned in. Whatever is playing gives way first: a second player
' pushed over the first would leave the first one's audio running underneath.
sub onReminderPlay(event as object)
    top = invalid
    if m.navStack.count() > 0 then top = m.navStack.peek()
    if top <> invalid and top.subtype() = "PlayerScreen"
        top.callFunc("stopForHandoff")
        popScreen()
    end if
    onPlayItem(event)
end sub

sub clearAllScreens()
    ' Sign-out and server switch both land here. Cached theme URLs carry the
    ' outgoing server's token, so the whole session's state goes with them.
    m.themePlayer.callFunc("resetSession", "session")
    m.reminderBanner.active = false
    endDeepLinkWait()
    while m.navStack.count() > 0
        screen = m.navStack.pop()
        m.top.removeChild(screen)
        retireScreen(screen)
    end while
    for each key in m.rootScreens
        m.top.removeChild(m.rootScreens[key])
        retireScreen(m.rootScreens[key])
    end for
    m.rootScreens = {}
    m.currentScreen = invalid
    m.sidebar.visible = false
end sub

' ---------- Task reaping ----------
' Every screen owns a JellyfinApi task whose loop parks in wait(). A parked
' task holds a reference to its own node, so removeChild alone can never free
' the screen graph it belongs to — browsing leaked a thread and a full screen
' per navigation. Only control="stop" releases it.
'
' The stop is deferred rather than immediate because screens fire a last
' request on their way out (the player sets reportStopped in the same tick as
' done, and the task only picks the field up on the next one) and stopping a
' task kills whatever it is holding, in flight or queued.
sub retireScreen(screen as object)
    if screen = invalid then return
    m.pendingReap.push({ screen: screen, ticks: 5 })
    ' Only on the empty -> non-empty edge: "start" restarts a running timer, so
    ' a fast run of navigations would keep pushing the tick out.
    if m.pendingReap.count() = 1 then m.reapTimer.control = "start"
end sub

sub onReapTick()
    remaining = []
    for each pending in m.pendingReap
        pending.ticks = pending.ticks - 1
        if pending.ticks > 0
            remaining.push(pending)
        else
            task = pending.screen.findNode("apiTask")
            if task <> invalid then task.control = "stop"
        end if
    end for
    m.pendingReap = remaining
    if m.pendingReap.count() = 0 then m.reapTimer.control = "stop"
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' Play belongs to a showing reminder; screens let it through while one is up.
    if key = "play" and m.global.reminderShowing = true
        m.reminderBanner.callFunc("tune")
        return true
    end if

    if key = "back"
        if m.navStack.count() > 0
            popScreen()
            return true
        else if m.sidebar.visible and m.sidebar.isInFocusChain()
            ' From the rail, back drops into content
            onSidebarDescend()
            return true
        else if m.activeSelection <> "home" and m.sidebar.visible
            ' Menu on a non-Home selection returns to Home
            switchSelection({ kind: "home" })
            screen = m.rootScreens["home"]
            if screen <> invalid then screen.setFocus(true)
            return true
        end if
        ' On Home root: let the OS exit the channel
        return false
    else if key = "options"
        ' The login screen leaves navStack empty, so this used to offer the
        ' switcher there — and "Add Server" from it re-entered showAuthScreen().
        if m.navStack.count() = 0 and m.authScreen = invalid
            showServerSwitchDialog()
            return true
        end if
    else if key = "left"
        ' Unconsumed Left from a root screen reveals/expands the rail
        if m.sidebar.visible and m.navStack.count() = 0 and not m.sidebar.isInFocusChain()
            m.sidebar.setFocus(true)
            return true
        end if
    end if
    return false
end function
