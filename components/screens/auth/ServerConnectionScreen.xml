<?xml version="1.0" encoding="UTF-8" ?>
<component name="ServerConnectionScreen" extends="Group">
    <interface>
        <field id="loginSuccess" type="boolean" value="false" alwaysNotify="true" />
        <!-- When true (adding a server while already signed in), the form shows
             a Cancel button and Back returns to the main UI instead of exiting. -->
        <field id="canCancel" type="boolean" value="false" />
        <field id="cancelled" type="boolean" value="false" alwaysNotify="true" />
    </interface>
    <children>
        <!-- Background -->
        <Rectangle width="1920" height="1080" color="#121215" />

        <!-- Centered title -->
        <Label
            text="Sashimi"
            font="font:LargeBoldSystemFont"
            color="#FFFFFF"
            horizAlign="center"
            width="1920"
            translation="[0, 140]"
        />
        <Label
            text="Connect to your Jellyfin server"
            font="font:MediumSystemFont"
            color="#666666"
            horizAlign="center"
            width="1920"
            translation="[0, 210]"
        />

        <!-- Form card -->
        <Rectangle
            id="formBg"
            translation="[560, 300]"
            width="800"
            height="440"
            color="#101420"
        />

        <!-- Form buttons -->
        <ButtonGroup
            id="formButtons"
            translation="[600, 330]"
            minWidth="720"
            buttonHeight="64"
            itemSpacings="[14]"
            textFont="font:MediumSystemFont"
            focusedTextFont="font:MediumBoldSystemFont"
            textColor="#888888"
            focusedTextColor="#FFFFFF"
            focusBitmapUri="pkg:/images/button_focus.png"
            focusFootprintBitmapUri="pkg:/images/button_unfocus.png"
        />

        <!-- Status -->
        <Label
            id="statusLabel"
            text=""
            font="font:SmallSystemFont"
            color="#FF6666"
            horizAlign="center"
            width="1920"
            translation="[0, 790]"
        />

        <!-- Loading -->
        <Label
            id="loadingLabel"
            text="Connecting..."
            font="font:MediumSystemFont"
            color="#888888"
            horizAlign="center"
            width="1920"
            translation="[0, 500]"
            visible="false"
        />

        <!-- Discovery panel -->
        <Rectangle
            id="discoveryBg"
            translation="[560, 300]"
            width="800"
            height="440"
            color="#101420"
            visible="false"
        />
        <Label
            id="discoveryTitle"
            text="Select a Server"
            font="font:MediumBoldSystemFont"
            color="#FFFFFF"
            translation="[600, 320]"
            visible="false"
        />
        <LabelList
            id="serverList"
            translation="[600, 380]"
            itemSize="[720, 52]"
            numRows="6"
            visible="false"
        />

        <!-- Quick Connect panel: covers the form while a code is live. Nothing
             in it is focusable — the screen itself holds focus so Back is the
             only key that does anything. -->
        <Group id="qcPanel" visible="false">
            <Rectangle translation="[510, 280]" width="900" height="480" color="#101420" />
            <Label
                text="Quick Connect"
                color="#FFFFFF"
                horizAlign="center"
                width="900"
                translation="[510, 316]"
            >
                <Font role="font" uri="pkg:/fonts/Roboto-Bold.ttf" size="38" />
            </Label>
            <Label
                text="On your phone or computer, sign in to Jellyfin, open Quick Connect from the user menu, and enter this code:"
                color="#AAAAAA"
                horizAlign="center"
                width="780"
                wrap="true"
                translation="[570, 378]"
            >
                <Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="26" />
            </Label>
            <Label
                id="qcCodeLabel"
                text=""
                color="#FFFFFF"
                horizAlign="center"
                width="900"
                translation="[510, 496]"
            >
                <Font role="font" uri="pkg:/fonts/Roboto-Bold.ttf" size="80" />
            </Label>
            <Label
                id="qcStatusLabel"
                text=""
                color="#888888"
                horizAlign="center"
                width="900"
                translation="[510, 622]"
            >
                <Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="26" />
            </Label>
            <Label
                text="Press Back to cancel"
                font="font:SmallSystemFont"
                color="#666666"
                horizAlign="center"
                width="900"
                translation="[510, 690]"
            />
        </Group>
        <!-- Poll interval. One-shot: ServerConnectionScreen re-arms it after
             each answer so polls cannot stack up. -->
        <Timer id="qcTimer" repeat="false" duration="3" />

        <ErrorDialog id="errorDialog" />
        <JellyfinApi id="apiTask" />
        <ServerDiscoveryTask id="discoveryTask" />
    </children>
</component>
