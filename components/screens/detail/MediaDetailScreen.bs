import "pkg:/source/utils/ImageUrl.bs"
import "pkg:/source/utils/YouTube.bs"
import "pkg:/source/utils/TimeFormat.bs"

' tvOS MediaDetailView parity with a Roku-native focus model:
'  - Fixed header (backdrop/logo/title/meta/ratings/badges/overview)
'  - Capsule action buttons (screen-managed left/right)
'  - ONE multi-row RowList (Seasons / Episodes / Cast) — the RowList handles
'    vertical nav BETWEEN its rows natively and only bubbles at the top edge,
'    which is where we hand focus back up to the buttons. (Separate RowLists
'    fight this; a single multi-row list is the working pattern.)

sub init()
    m.backdropImage = m.top.findNode("backdropImage")
    m.backdropMask = m.top.findNode("backdropMask")
    ' Snap the feather mask to the fitted image once its decoded size is known.
    m.backdropImage.observeFieldScoped("loadStatus", "onBackdropStatus")
    m.logoImage = m.top.findNode("logoImage")
    m.moviePosterMask = m.top.findNode("moviePosterMask")
    m.moviePoster = m.top.findNode("moviePoster")
    m.channelMask = m.top.findNode("channelMask")
    m.channelImage = m.top.findNode("channelImage")
    m.channelLabel = m.top.findNode("channelLabel")
    m.titleLabel = m.top.findNode("titleLabel")
    m.metaLabel = m.top.findNode("metaLabel")
    m.endsAtLabel = m.top.findNode("endsAtLabel")
    m.ratingsGroup = m.top.findNode("ratingsGroup")
    m.tmdbLogo = m.top.findNode("tmdbLogo")
    m.tmdbScore = m.top.findNode("tmdbScore")
    m.tomatoIcon = m.top.findNode("tomatoIcon")
    m.tomatoScore = m.top.findNode("tomatoScore")
    m.badgesGroup = m.top.findNode("badgesGroup")
    m.tagsGroup = m.top.findNode("tagsGroup")
    m.titleFontBig = CreateObject("roSGNode", "Font")
    m.titleFontBig.uri = "pkg:/fonts/Inter-Bold.ttf"
    m.titleFontBig.size = 52
    m.titleFontStd = CreateObject("roSGNode", "Font")
    m.titleFontStd.uri = "pkg:/fonts/Inter-Bold.ttf"
    m.titleFontStd.size = 38
    m.overviewLabel = m.top.findNode("overviewLabel")
    m.detailButtons = m.top.findNode("detailButtons")
    m.rowList = m.top.findNode("rowList")
    m.loadingLabel = m.top.findNode("loadingLabel")
    m.errorLabel = m.top.findNode("errorLabel")
    m.errorRetry = m.top.findNode("errorRetry")
    m.apiTask = m.top.findNode("apiTask")

    rowFont = CreateObject("roSGNode", "Font")
    rowFont.uri = "pkg:/fonts/Inter-Bold.ttf"
    rowFont.size = 28
    m.rowList.rowLabelFont = rowFont

    m.apiTask.observeFieldScoped("response", "onApiResponse")
    m.apiTask.control = "RUN"
    m.rowList.observeFieldScoped("rowItemSelected", "onRowItemSelected")
    m.detailButtons.observeFieldScoped("activatedKind", "onButtonActivated")
    m.detailButtons.observeFieldScoped("goDown", "onButtonsGoDown")
    m.logoImage.observeFieldScoped("loadStatus", "onLogoStatus")

    m.item = invalid
    m.itemType = ""
    m.requestedItemId = ""      ' kept for Retry after a failed load
    m.isYouTube = false
    m.forceYouTube = false
    m.isDeepLink = false
    m.seasons = []
    m.selectedSeasonIndex = 0
    m.playTarget = invalid      ' resolved episode a Series/Season Play button launches
    m.pendingPlay = false       ' Play pressed before the target resolved
    m.zone = "buttons"          ' buttons | rows
    m.rowKinds = []             ' kind per RowList row, e.g. ["season","episode","cast"]
    m.rowContent = invalid
    m.reqQueue = []             ' serialized API requests (avoid coalescing)
    m.reqActive = false

    m.top.observeField("focusedChild", "onFocusDelegate")
end sub

' ---------- Serialized request queue ----------
' apiTask reads only the LATEST request per tick; setting two in one tick drops
' the first. Queue guarantees one in flight at a time.

sub enqueue(req as object)
    m.reqQueue.push(req)
    pumpQueue()
end sub

sub pumpQueue()
    if m.reqActive then return
    if m.reqQueue.count() = 0 then return
    m.reqActive = true
    m.apiTask.request = m.reqQueue.shift()
end sub

sub onApiResponse()
    response = m.apiTask.response
    if response = invalid then return
    m.reqActive = false

    action = response.action
    if action = "getItem"
        if response.context <> invalid and response.context = "seriesMeta"
            onSeriesMetaLoaded(response)
        else
            onItemLoaded(response)
        end if
    else if action = "getAncestors"
        onAncestorsLoaded(response)
    else if action = "getPlaybackInfo"
        onPlaybackInfoLoaded(response)
    else if action = "getSeasons"
        onSeasonsLoaded(response)
    else if action = "getNextUp"
        if response.context <> invalid and response.context = "deepLinkPlay"
            onDeepLinkNextUp(response)
        else if response.context <> invalid and response.context = "playTargetNextUp"
            onPlayTargetNextUp(response)
        end if
    else if action = "getEpisodes"
        if response.context <> invalid and response.context = "deepLinkPlay"
            onDeepLinkFirstEpisode(response)
        else
            onEpisodesLoaded(response)
        end if
    else if action = "markPlayed" or action = "markUnplayed"
        if response.success and m.item <> invalid
            m.global.toastMessage = { message: "Updated" }
            ' Home must refresh on return even inside its 20s debounce —
            ' the just-toggled show otherwise lingers in Continue Watching.
            m.global.watchStateDirty = true
            enqueue({ action: "getItem", itemId: m.item.Id })
        else if not response.success
            ' These writes used to report success unconditionally, so "Updated"
            ' appeared over a row the server had never changed. Say so instead.
            m.global.toastMessage = { message: watchStateFailureMessage() }
        end if
    else if action = "markFavorite" or action = "removeFavorite"
        ' The re-fetch that repaints the row is already queued by the caller;
        ' only the failure needs saying out loud.
        if not response.success
            m.global.toastMessage = { message: watchStateFailureMessage() }
        end if
    else if action = "getItems"
        if response.context <> invalid and response.context = "playTargetUnwatched"
            onPlayTargetUnwatched(response)
        else if response.context <> invalid and response.context = "playTargetFirst"
            onPlayTargetFirst(response)
        else
            ' Shuffle result — play the random episode
            if response.success and response.items <> invalid and response.items.count() > 0
                m.top.playItem = { item: response.items[0], action: "play" }
            end if
        end if
    else if action = "getLocalTrailers"
        ' Play the local trailer
        if response.success and response.items <> invalid and response.items.count() > 0
            m.top.playItem = { item: response.items[0], action: "play" }
        end if
    end if
    pumpQueue()
end sub

function watchStateFailureMessage() as string
    return "Couldn't update. Check your connection."
end function

' What a deep link is allowed to resolve to: something this screen can play, or
' one of the two container types it can draw a springboard for. Anything else
' (a library, the Media Folders root, a playlist) is treated as an invalid
' contentId. Roku's eight deep-link mediaTypes all land on one of these.
function isDeepLinkableType(itemType as string) as boolean
    allowed = {
        Movie: true,
        Episode: true,
        Video: true,
        MusicVideo: true,
        Trailer: true,
        Program: true,
        Recording: true,
        TvChannel: true,
        LiveTvChannel: true,
        Series: true,
        Season: true
    }
    return (allowed[itemType] = true)
end function

sub onFocusDelegate()
    if not m.top.hasFocus() then return
    ' Retry is the only focusable node while the error panel is up (m.item is
    ' invalid there, so focusZone has nothing to focus).
    if m.errorRetry.visible
        m.errorRetry.setFocus(true)
    else if m.item <> invalid
        focusZone(m.zone)
    end if
end sub

sub onItemDataChanged()
    data = m.top.itemData
    if data = invalid then return
    ' forceYouTubeStyle threaded from the originating screen (tvOS parity) —
    ' the fresh getItem result loses the flag, so remember it here.
    m.forceYouTube = (data._forceYouTube <> invalid and data._forceYouTube = true)
    hideLoadError()
    m.loadingLabel.visible = true
    itemId = ""
    if data.Id <> invalid then itemId = data.Id
    if itemId = "" then return
    m.requestedItemId = itemId
    ' An item that arrives without the originating screen's YouTube flag may
    ' not self-identify (Pinchflat channel not named "… - Videos", path without
    ' "youtube"). Deep links / Top Shelf never carry the flag — and neither
    ' does Continue Watching, because the resume payload has no library
    ' context, which is why the SAME episode rendered as a channel from the
    ' library and as a plain episode with an empty (logo-less) header from the
    ' CW row. Resolve it from the library ancestor FIRST, whichever row opened
    ' it, so the header renders right the first time: isYouTube also drives the
    ' backdrop, title format and episode rows, so it has to be settled before
    ' the item renders rather than patched afterwards. Screens that know the
    ' library thread the flag and skip this; movies never use the channel
    ' header, so they skip it too (no extra request in either case).
    isDeepLink = (data._deepLink <> invalid and data._deepLink = true)
    m.isDeepLink = isDeepLink
    itemType = ""
    if data.Type <> invalid then itemType = data.Type
    if itemType <> "Movie" and not m.forceYouTube and not m.top.autoPlay
        m.pendingItemId = itemId
        enqueue({ action: "getAncestors", itemId: itemId })
    else
        enqueue({ action: "getItem", itemId: itemId })
    end if
end sub

' ---------- Item load ----------

' Library-context YouTube resolution: if the item's library ancestor is a
' YouTube library, force YouTube styling before the item loads/renders, so a
' Top Shelf or Continue Watching item whose channel isn't named "… - Videos"
' still gets the channel header.
sub onAncestorsLoaded(response as object)
    if response.success and response.items <> invalid
        for each anc in response.items
            name = ""
            if anc.Name <> invalid then name = anc.Name
            if YT.isLibraryName(name)
                m.forceYouTube = true
                exit for
            end if
        end for
    end if
    itemId = m.pendingItemId
    m.pendingItemId = invalid
    if itemId <> invalid and itemId <> "" then enqueue({ action: "getItem", itemId: itemId })
end sub

sub onItemLoaded(response as object)
    m.loadingLabel.visible = false
    if not response.success
        ' Cert 5.2: an invalid/unavailable contentId must pop an error and land
        ' on the home screen. Silently returning left a blank detail screen.
        if m.top.autoPlay or m.isDeepLink
            m.top.deepLinkFailed = true
        else if m.item <> invalid
            ' A re-fetch after a watched-state toggle failing changes nothing
            ' that is already on screen — keep the detail and just say so.
            m.global.toastMessage = { message: "Couldn't reach the server. Try again." }
        else
            ' In-app navigation has a screen to go back to, so stay put and
            ' offer a retry instead of popping the user home.
            showLoadError()
        end if
        return
    end if
    hideLoadError()

    m.item = response.item
    item = m.item
    m.itemType = ""
    if item.Type <> invalid then m.itemType = item.Type

    ' Cert 5.2: an invalid contentId must show an error and land on home. A
    ' nonexistent id normally 404s and the failure branch above handles it --
    ' but a WELL-FORMED one need not. Jellyfin answers an all-zeros GUID with
    ' HTTP 200 and the Media Folders root (Type "UserRootFolder"), which used
    ' to be handed straight to the player and produced the player's own
    ' "Can't play this item" dialog instead of the home screen a reviewer
    ' inventing a fake id is entitled to see.
    if m.isDeepLink and not isDeepLinkableType(m.itemType)
        m.top.autoPlay = false
        m.top.deepLinkFailed = true
        return
    end if

    m.isYouTube = YT.isItem(item, m.forceYouTube)

    setBackdrop(item)
    setHeader(item)
    if not m.isYouTube
        setRatings(item)
    else
        ' YouTube videos never carry TMDB/critic scores worth showing; hide
        ' the row and anchor the media badges where the ratings would start.
        m.tmdbLogo.visible = false
        m.tmdbScore.visible = false
        m.tomatoIcon.visible = false
        m.tomatoScore.visible = false
        m.badgesGroup.translation = m.ratingsGroup.translation
    end if
    buildTags(item)

    overview = ""
    if item.Overview <> invalid then overview = item.Overview
    m.overviewLabel.text = overview

    reflowHeader()

    buildButtons()

    m.rowContent = CreateObject("roSGNode", "ContentNode")
    m.rowKinds = []
    m.seasons = []
    m.currentEpIndex = invalid
    m.playTarget = invalid
    m.pendingPlay = false

    if m.itemType = "Series"
        enqueue({ action: "getSeasons", seriesId: item.Id })
        ' Resolve the episode the Play button will launch, so it can label
        ' itself "Play S1:E1" / "Resume S1:E2" like the other clients.
        enqueue({ action: "getNextUp", seriesId: item.Id, limit: 1, context: "playTargetNextUp" })
    else if m.itemType = "Season"
        enqueue({ action: "getItems", parentId: item.Id, includeItemTypes: "Episode", sortBy: "ParentIndexNumber,IndexNumber", limit: 1, isPlayed: false, context: "playTargetUnwatched" })
        ' Cert 5.2 allows mediaType=season to show a springboard instead of
        ' playing, but only one "highlighting the season's episodes" — and this
        ' branch used to resolve the Play target and stop, leaving a title, a
        ' backdrop and three buttons over nothing. A Season is only ever reached
        ' by deep link (in-app browsing swaps episodes into the Series screen's
        ' inline Seasons row), so this is the sole path that builds one.
        if item.SeriesId <> invalid and item.SeriesId <> ""
            enqueue({ action: "getEpisodes", seriesId: item.SeriesId, seasonId: item.Id })
        else
            buildCastRow(item)
            commitRows()
        end if
    else if m.itemType = "Movie"
        enqueue({ action: "getPlaybackInfo", itemId: item.Id })
        buildCastRow(item)
        commitRows()
    else if m.itemType = "Episode"
        enqueue({ action: "getPlaybackInfo", itemId: item.Id })
    end if

    focusZone("buttons")

    ' Deep link with a playable mediaType: start playback immediately (cert
    ' 5.2 Direct to Play). The screen was created hidden so the springboard and
    ' its Resume/Play buttons never flash; reveal it now that the player is
    ' about to be pushed on top, so backing out of the player lands on a fully
    ' rendered detail screen instead of a blank one.
    if m.top.autoPlay
        m.top.autoPlay = false
        if m.itemType = "Series"
            ' mediaType="series" must launch the episode the viewer is up to,
            ' not the series itself. NextUp scoped to this series is Jellyfin's
            ' equivalent of Roku's "smart bookmark"; DisableFirstEpisode=false
            ' means a never-started show resolves to S1E1.
            enqueue({ action: "getNextUp", seriesId: item.Id, limit: 1, context: "deepLinkPlay" })
        else
            m.top.visible = true
            m.top.playItem = { item: item, action: "resume" }
        end if
    end if
end sub

' ---------- Failed load ----------

sub showLoadError()
    m.errorLabel.text = "Couldn't load this title."
    m.errorLabel.visible = true
    m.errorRetry.visible = true
    if m.top.isInFocusChain() then m.errorRetry.setFocus(true)
end sub

sub hideLoadError()
    m.errorLabel.visible = false
    m.errorRetry.visible = false
end sub

sub retryLoad()
    if m.requestedItemId = "" then return
    hideLoadError()
    m.loadingLabel.visible = true
    enqueue({ action: "getItem", itemId: m.requestedItemId })
end sub

' Deep-link series resolution (cert 5.2). NextUp comes back empty for a fully
' watched series, so fall back to the first episode rather than dead-ending.
sub onDeepLinkNextUp(response as object)
    if response.success and response.items <> invalid and response.items.count() > 0
        m.top.visible = true
        m.top.playItem = { item: response.items[0], action: "resume" }
        return
    end if
    if m.item = invalid
        m.top.deepLinkFailed = true
        return
    end if
    enqueue({ action: "getEpisodes", seriesId: m.item.Id, context: "deepLinkPlay" })
end sub

sub onDeepLinkFirstEpisode(response as object)
    if response.success and response.items <> invalid and response.items.count() > 0
        m.top.visible = true
        m.top.playItem = { item: response.items[0], action: "resume" }
    else
        m.top.deepLinkFailed = true
    end if
end sub

' ---------- Play-button container resolution ----------
' A Series/Season Play button must launch an EPISODE, not the container. The
' target is resolved at load — so the button can show "Play S1:E1" / "Resume
' S1:E2" like the other clients — and cached in m.playTarget. Resolution order
' mirrors resolvePlayableItem:
'   Series -> Next Up -> first unwatched -> first episode
'   Season ->            first unwatched -> first episode
' Each fallback is a separate async request keyed by context; onApiResponse
' routes the results here.

sub onPlayTargetNextUp(response as object)
    if response.success and response.items <> invalid and response.items.count() > 0
        setPlayTarget(response.items[0])
        return
    end if
    ' No Next Up (fully watched, or a never-started show NextUp didn't surface):
    ' fall through to the first unwatched episode.
    if m.item = invalid then return
    enqueue({ action: "getItems", parentId: m.item.Id, includeItemTypes: "Episode", sortBy: "ParentIndexNumber,IndexNumber", limit: 1, isPlayed: false, context: "playTargetUnwatched" })
end sub

sub onPlayTargetUnwatched(response as object)
    if response.success and response.items <> invalid and response.items.count() > 0
        setPlayTarget(response.items[0])
        return
    end if
    ' Fully-watched season/series: fall back to the first episode.
    if m.item = invalid then return
    enqueue({ action: "getItems", parentId: m.item.Id, includeItemTypes: "Episode", sortBy: "ParentIndexNumber,IndexNumber", limit: 1, context: "playTargetFirst" })
end sub

sub onPlayTargetFirst(response as object)
    if response.success and response.items <> invalid and response.items.count() > 0
        setPlayTarget(response.items[0])
    else if m.pendingPlay
        ' Nothing playable and the viewer already pressed Play.
        m.pendingPlay = false
        m.global.toastMessage = { message: "No episodes to play" }
    end if
end sub

' Cache the resolved episode, relabel the Play button to match it, and — if the
' viewer pressed Play while resolution was still in flight — launch it now.
sub setPlayTarget(ep as object)
    m.playTarget = ep
    buildButtons()
    if m.pendingPlay
        m.pendingPlay = false
        playResolvedTarget()
    end if
end sub

sub playResolvedTarget()
    if m.playTarget = invalid then return
    act = "play"
    if m.playTarget.UserData <> invalid and m.playTarget.UserData.PlaybackPositionTicks <> invalid and m.playTarget.UserData.PlaybackPositionTicks > 0 then act = "resume"
    m.top.playItem = { item: m.playTarget, action: act }
end sub

' tvOS movie detail: poster on the left, text column beside it — the shared
' text stack otherwise overlaps the 200x300 poster (title sat at y250 inside
' the poster's y60-360 box, squishing everything together).
sub layoutHeader()
    if m.itemType = "Movie"
        m.moviePosterMask.maskSize = [260, 390]
        m.moviePoster.width = 260
        m.moviePoster.height = 390
        m.titleLabel.font = m.titleFontBig
        m.titleLabel.translation = [360, 84]
        m.metaLabel.translation = [360, 172]
        m.ratingsGroup.translation = [360, 224]
        m.tagsGroup.translation = [360, 274]
        m.detailButtons.translation = [60, 466]   ' full-width row under the cover (tvOS parity)
        m.overviewLabel.translation = [60, 562]
        m.overviewLabel.width = 1200
        m.overviewLabel.maxLines = 3
    else
        m.titleLabel.font = m.titleFontStd
        m.titleLabel.translation = [60, 296]
        m.metaLabel.translation = [60, 358]
        m.ratingsGroup.translation = [60, 398]
        m.tagsGroup.translation = [60, 446]
        ' Buttons ABOVE the overview (tvOS parity — movies already do this;
        ' series/episodes had Play below the description).
        m.detailButtons.translation = [60, 500]
        m.overviewLabel.translation = [60, 596]
        m.overviewLabel.width = 940
        m.overviewLabel.maxLines = 2
    end if
end sub

' Collapse the header's fixed slots onto the measured content. layoutHeader()'s
' y positions assume the worst case (2-line title + a ratings row); a 1-line
' title or a ratings-less item (YouTube) left dead bands between rows. Stack
' each row under the real top anchor and give the freed space to the overview.
'
' The top anchor differs by type:
'  - Movie: the measured title in the right-of-poster column. Rows stack under
'    it; buttons stay poster-bottom-aligned; overview runs full width below the
'    poster.
'  - Series: the LOGO replaces the title (onLogoStatus hides it). scaleToFit
'    centers the decoded logo in its 760x210 box, so anchor to the logo's real
'    rendered bottom — NOT the hidden title's box at y296, which left a ~90px
'    void. Runs from onLogoStatus once bitmap dims are known.
'  - Episode: the title stays visible below the logo — anchor to it.
' Park the purple "Ends at" label immediately after the meta line, on the same
' baseline. Must run after both the meta text and the meta label's final
' translation are set — reflowHeader/reflowMovieHeader move the meta label per
' layout, so this is called again from there, not just from setHeader.
sub positionEndsAt()
    if m.endsAtLabel.text = ""
        m.endsAtLabel.visible = false
        return
    end if
    r = m.metaLabel.boundingRect()
    m.endsAtLabel.translation = [m.metaLabel.translation[0] + r.width + 8, m.metaLabel.translation[1]]
    m.endsAtLabel.visible = true
end sub

sub reflowHeader()
    if m.itemType = "Movie"
        reflowMovieHeader()
        return
    end if

    if m.itemType = "Series" and m.logoImage.loadStatus = "ready"
        topY = seriesLogoBottom() + 20
    else
        titleH = Int(m.titleLabel.boundingRect().height)
        topY = 296 + titleH + 16
    end if

    metaY = topY
    m.metaLabel.translation = [60, metaY]
    positionEndsAt()
    y = metaY + 38
    ' The ratings/badges row takes space only when something renders in it: a
    ' rating visible now, or media badges once getPlaybackInfo lands (of the
    ' non-movie types, only episodes request playback info).
    hasRating = m.tmdbScore.visible or m.tomatoScore.visible
    if hasRating or m.itemType = "Episode"
        m.ratingsGroup.translation = [60, y]
        m.badgesGroup.translation = [m.badgesGroup.translation[0], y]
        y += 40
    end if
    m.detailButtons.translation = [60, y + 20]
    overviewY = y + 20 + 52 + 24
    m.overviewLabel.translation = [60, overviewY]
    applyOverviewLines(overviewY)
end sub

' Movies stack meta/ratings/tags under the measured title in the right column,
' put the buttons in a full-width row under the cover, and run the overview
' full width below that. Measuring the title closes the dead band the fixed
' y=172 left under a 1-line title while still clearing a 2-line one.
sub reflowMovieHeader()
    titleY = 84
    titleH = Int(m.titleLabel.boundingRect().height)
    y = titleY + titleH + 8
    m.metaLabel.translation = [360, y]
    positionEndsAt()
    y += 40
    m.ratingsGroup.translation = [360, y]
    m.badgesGroup.translation = [m.badgesGroup.translation[0], y]
    y += 40
    m.tagsGroup.translation = [360, y]
    ' Buttons sit in a full-width row under the cover (tvOS parity — the detail
    ' controls moved out from beside the poster to under it). Poster is 260x390
    ' at y60 => bottom 450; the row starts just below.
    m.detailButtons.translation = [60, 466]
    ' Overview runs full width below the button row.
    overviewY = 562
    m.overviewLabel.translation = [60, overviewY]
    m.overviewLabel.width = 1200
    applyOverviewLines(overviewY)
end sub

' Real rendered bottom of the series logo. scaleToFit fits the decoded bitmap
' inside the 760x210 box at [60,60] and centers it vertically, so the bottom
' depends on the logo's aspect. Falls back to the full box bottom before the
' bitmap is known.
function seriesLogoBottom() as integer
    boxTop = 60
    boxH = 210
    bw = m.logoImage.bitmapWidth
    bh = m.logoImage.bitmapHeight
    renderedH = boxH
    if bw > 0 and bh > 0
        scale = 760.0 / bw
        if (boxH * 1.0) / bh < scale then scale = (boxH * 1.0) / bh
        renderedH = bh * scale
    end if
    return boxTop + Int((boxH + renderedH) / 2)
end function

' Give the overview a 4th line when there's room to the RowList at y=734,
' a 3rd when there's less, else 2. ~30px per 24pt line.
sub applyOverviewLines(overviewY as integer)
    room = 734 - overviewY
    if room >= 140
        m.overviewLabel.maxLines = 4
    else if room >= 110
        m.overviewLabel.maxLines = 3
    else
        m.overviewLabel.maxLines = 2
    end if
end sub

' Fit the feather mask to the image's real rendered rect. scaleToFit CENTERS
' the decoded image inside the poster's region, so a fixed-size mask feathers
' the region's edges, not the image's — leaving hard top/bottom lines on 16:9
' art (same bug class as the hero fixes). The decoded bitmap preserves aspect,
' so refit poster + mask to the aspect-correct size, anchored top-right (tvOS).
sub onBackdropStatus()
    if m.backdropImage.loadStatus <> "ready" then return
    bw = m.backdropImage.bitmapWidth
    bh = m.backdropImage.bitmapHeight
    if bw = invalid or bh = invalid or bw <= 0 or bh <= 0 then return
    rw = m.backdropRegionW
    rh = m.backdropRegionH
    if bw * rh > bh * rw
        fw = rw
        fh = Int(rw * bh / bw)
    else
        fh = rh
        fw = Int(rh * bw / bh)
    end if
    m.backdropImage.width = fw
    m.backdropImage.height = fh
    m.backdropMask.maskSize = [fw, fh]
    m.backdropMask.translation = [m.backdropRight - fw, 60]
end sub

sub setBackdrop(item as object)
    frac = 0.45
    if m.itemType = "Series"
        frac = 0.55
        if m.isYouTube then frac = 0.65
    end if
    ' Region the image fits INTO (tvOS width fractions, right margin 140).
    ' onBackdropStatus shrinks poster + feather mask to the fitted image and
    ' re-anchors top-right once the decoded size is known.
    m.backdropRegionW = Int(1920 * frac)
    m.backdropRegionH = 580
    m.backdropRight = 1920 - 140
    m.backdropMask.translation = [m.backdropRight - m.backdropRegionW, 60]
    m.backdropMask.maskSize = [m.backdropRegionW, m.backdropRegionH]
    m.backdropImage.width = m.backdropRegionW
    m.backdropImage.height = m.backdropRegionH
    m.backdropImage.translation = [0, 0]

    itemId = item.Id
    uri = ""
    if m.itemType = "Episode"
        uri = ImageUrl.primary(itemId, 1280)              ' episode thumbnail (own id)
    else if m.isYouTube and m.itemType = "Series"
        uri = m.global.serverUrl + "/Items/" + itemId + "/Images/Banner?maxWidth=1280&quality=90"
    else if item.BackdropImageTags <> invalid and item.BackdropImageTags.count() > 0
        uri = ImageUrl.backdrop(itemId, 1280)
    else if item.ParentBackdropItemId <> invalid
        uri = ImageUrl.backdrop(item.ParentBackdropItemId, 1280)
    end if
    m.backdropImage.uri = uri
end sub

sub setHeader(item as object)
    m.endsAtText = ""
    m.logoImage.visible = false
    m.moviePosterMask.visible = false
    m.channelMask.visible = false
    m.channelLabel.visible = false
    m.titleLabel.visible = true
    layoutHeader()

    title = ""
    if item.Name <> invalid then title = item.Name
    if m.itemType = "Series" then title = YT.cleanTitle(title)
    ' S:E prefix only for regular (non-YouTube) episodes
    if m.itemType = "Episode" and not m.isYouTube and item.ParentIndexNumber <> invalid and item.IndexNumber <> invalid
        title = "S" + str(item.ParentIndexNumber).Trim() + ":E" + str(item.IndexNumber).Trim() + " " + Chr(8226) + " " + title
    end if
    m.titleLabel.text = title

    ' tvOS meta line: date  -  runtime  -  Ends at H:MM
    meta = []
    if m.itemType = "Episode"
        if item.PremiereDate <> invalid and Len(item.PremiereDate) >= 10 then meta.push(YT.formatDateLong(item.PremiereDate))
        if item.RunTimeTicks <> invalid and item.RunTimeTicks > 0
            mins = Int(item.RunTimeTicks / 600000000)
            if mins > 0 then meta.push(str(mins).Trim() + " min")
            dt = CreateObject("roDateTime")
            dt.ToLocalTime()
            totalMin = dt.GetHours() * 60 + dt.GetMinutes() + Int(item.RunTimeTicks / 600000000)
            eh = (totalMin \ 60) mod 24
            em = totalMin mod 60
            ' 24-Hour Time setting honored via shared helper
            m.endsAtText = "Ends at " + TimeFormat.clock(eh, em)
        end if
    else if m.itemType = "Series"
        if item.ProductionYear <> invalid then meta.push(str(item.ProductionYear).Trim())
        if item.ChildCount <> invalid and item.ChildCount > 0
            if item.ChildCount = 1
                meta.push("1 Season")
            else
                meta.push(str(item.ChildCount).Trim() + " Seasons")
            end if
        end if
    else
        ' Movies: release year + runtime + Ends at (cert/genres live in the tags row)
        if item.ProductionYear <> invalid then meta.push(str(item.ProductionYear).Trim())
        if item.RunTimeTicks <> invalid and item.RunTimeTicks > 0
            minutes = Int(item.RunTimeTicks / 600000000)
            if minutes > 0
                hours = Int(minutes / 60)
                mins2 = minutes mod 60
                if hours > 0
                    meta.push(str(hours).Trim() + "h " + str(mins2).Trim() + "m")
                else
                    meta.push(str(mins2).Trim() + "m")
                end if
            end if
            dt2 = CreateObject("roDateTime")
            dt2.ToLocalTime()
            totalMin2 = dt2.GetHours() * 60 + dt2.GetMinutes() + Int(item.RunTimeTicks / 600000000)
            eh2 = (totalMin2 \ 60) mod 24
            em2 = totalMin2 mod 60
            ' 24-Hour Time setting honored via shared helper
            m.endsAtText = "Ends at " + TimeFormat.clock(eh2, em2)
        end if
    end if
    metaStr = ""
    for i = 0 to meta.count() - 1
        if i > 0 then metaStr += " " + Chr(8226) + " "
        metaStr += meta[i]
    end for
    ' Trailing separator so the purple "Ends at" reads as one more item on the
    ' same line as year/runtime — a dot in front of it, matching the others.
    if m.endsAtText <> "" and metaStr <> "" then metaStr += " " + Chr(8226)
    m.metaLabel.text = metaStr
    m.endsAtLabel.text = m.endsAtText
    positionEndsAt()

    if m.itemType = "Movie"
        m.moviePosterMask.visible = true
        m.moviePoster.uri = ImageUrl.primary(item.Id, 400)
    else if m.isYouTube
        m.channelMask.visible = true
        channelId = item.Id
        if item.SeriesId <> invalid
            ' YouTube episode: avatar = the channel (series) art, and show the
            ' channel name beside it (tvOS parity — the episode/video title
            ' stays in titleLabel below). Channel-page items keep their name in
            ' titleLabel, so only episodes need the extra label.
            channelId = item.SeriesId
            cname = ""
            if item.SeriesName <> invalid then cname = YT.cleanTitle(item.SeriesName)
            if cname <> ""
                m.channelLabel.text = cname
                m.channelLabel.visible = true
            end if
        end if
        m.channelImage.uri = ImageUrl.primary(channelId, 240)
    else if m.itemType = "Series"
        ' Series swap the title text for the logo (onLogoStatus hides title).
        m.logoImage.uri = m.global.serverUrl + "/Items/" + item.Id + "/Images/Logo?maxWidth=1240&quality=90"
        m.logoImage.visible = true
    else if m.itemType = "Episode" and item.SeriesId <> invalid
        ' Episodes show the series logo ABOVE the title (tvOS parity) — the
        ' title stays visible because onLogoStatus only hides it for Series.
        m.logoImage.uri = m.global.serverUrl + "/Items/" + item.SeriesId + "/Images/Logo?maxWidth=1240&quality=90"
        m.logoImage.visible = true
    end if
end sub

sub onLogoStatus()
    if m.logoImage.loadStatus = "ready" and m.itemType = "Series"
        m.titleLabel.visible = false
        ' The metadata was anchored to the hidden title's box; now that the
        ' logo's real rendered height is known, re-anchor under the logo.
        reflowHeader()
    else if m.logoImage.loadStatus = "failed"
        m.titleLabel.visible = true
    end if
end sub

sub setRatings(item as object)
    community = item.CommunityRating
    critic = item.CriticRating
    if community <> invalid
        m.tmdbLogo.visible = true
        m.tmdbScore.visible = true
        m.tmdbScore.text = str(Int(community * 10) / 10.0).Trim()
    else
        m.tmdbLogo.visible = false
        m.tmdbScore.visible = false
    end if
    if critic <> invalid
        m.tomatoIcon.visible = true
        m.tomatoScore.visible = true
        m.tomatoScore.text = str(Int(critic)).Trim() + "%"
        if community = invalid
            m.tomatoIcon.translation = [0, 0]
            m.tomatoScore.translation = [32, 0]
        else
            ' measured: tmdb logo(34) + score width + gap — not a fixed 140
            tomX = 44 + Int(m.tmdbScore.boundingRect().width) + 24
            m.tomatoIcon.translation = [tomX, 0]
            m.tomatoScore.translation = [tomX + 32, 0]
        end if
    else
        m.tomatoIcon.visible = false
        m.tomatoScore.visible = false
    end if
    ' Place badges right after the visible ratings — measured, not guessed
    endX = 0
    if critic <> invalid
        endX = m.tomatoScore.translation[0] + m.tomatoScore.boundingRect().width + 20
    else if community <> invalid
        endX = 44 + m.tmdbScore.boundingRect().width + 20
    end if
    rt = m.ratingsGroup.translation
    m.badgesGroup.translation = [rt[0] + endX, rt[1]]
end sub

' Episodes rarely carry their own ratings — fall back to the series (tvOS).
sub onSeriesMetaLoaded(response as object)
    if not response.success then return
    series = response.item
    if series = invalid then return
    if m.item.CommunityRating = invalid and m.item.CriticRating = invalid then setRatings(series)
    ' The donated rating may have made the ratings row appear — restack.
    reflowHeader()
end sub

' ---------- Media info badges ----------

sub onPlaybackInfoLoaded(response as object)
    if response.success and response.mediaSource <> invalid and response.mediaSource.MediaStreams <> invalid
        buildBadges(response.mediaSource)
    end if
    if m.itemType = "Episode"
        if m.item.SeriesId <> invalid and m.item.SeasonId <> invalid
            enqueue({ action: "getEpisodes", seriesId: m.item.SeriesId, seasonId: m.item.SeasonId })
        else
            buildCastRow(m.item)
            commitRows()
        end if
        ' YouTube: the "series" is a Pinchflat channel — its metadata must not
        ' donate TMDB/critic scores to individual videos.
        needSeriesMeta = (m.item.CommunityRating = invalid) and (m.item.CriticRating = invalid) and (m.item.SeriesId <> invalid) and (not m.isYouTube)
        if needSeriesMeta then enqueue({ action: "getItem", itemId: m.item.SeriesId, context: "seriesMeta" })
    end if
end sub

' Outlined chips: certification + up to 3 genres (tvOS tags row)
sub buildTags(item as object)
    while m.tagsGroup.getChildCount() > 0
        m.tagsGroup.removeChildIndex(0)
    end while
    ' Tag chips (rating + genres) are movie-only. TV shows (series and
    ' episodes) omit them entirely per design.
    tags = []
    if m.itemType = "Movie"
        if item.OfficialRating <> invalid and item.OfficialRating <> "" then tags.push(item.OfficialRating)
        if item.Genres <> invalid
            for each g in item.Genres
                if tags.count() < 4 then tags.push(g)
            end for
        end if
    end if
    tx = 0
    for each t in tags
        bw = 24 + Len(t) * 10
        bg = CreateObject("roSGNode", "Poster")
        bg.uri = "pkg:/images/badge_r6.9.png"
        bg.width = bw
        bg.height = 30
        bg.opacity = 0.55
        bg.translation = [tx, 0]
        m.tagsGroup.appendChild(bg)
        lbl = CreateObject("roSGNode", "Label")
        lbl.text = t
        lbl.width = bw
        lbl.height = 30
        lbl.horizAlign = "center"
        lbl.vertAlign = "center"
        lbl.color = "#D9D9D9"
        f = CreateObject("roSGNode", "Font")
        f.uri = "pkg:/fonts/Inter-Medium.ttf"
        f.size = 17
        lbl.font = f
        lbl.translation = [tx, 0]
        m.tagsGroup.appendChild(lbl)
        tx += bw + 10
    end for
end sub

sub buildBadges(src as object)
    while m.badgesGroup.getChildCount() > 0
        m.badgesGroup.removeChildIndex(0)
    end while
    badges = []
    for each st in src.MediaStreams
        if st.Type = "Video" and badges.count() = 0
            if st.Width <> invalid
                w = st.Width
                if w >= 3200
                    badges.push("4K")
                else if w >= 1800
                    badges.push("1080p")
                else if w >= 1200
                    badges.push("720p")
                else
                    badges.push("SD")
                end if
            end if
            if st.Codec <> invalid then badges.push(formatCodec(st.Codec))
        end if
    end for
    audioLogo = ""
    for each st in src.MediaStreams
        if st.Type = "Audio"
            c = ""
            if st.Codec <> invalid then c = UCase(st.Codec)
            if c = "AC3"
                audioLogo = "pkg:/images/dolby_digital.png"
            else if c = "EAC3"
                audioLogo = "pkg:/images/dolby_digital_plus.png"
            else if c = "TRUEHD"
                audioLogo = "pkg:/images/dolby_truehd.png"
            end if
            if audioLogo = ""
                a = ""
                if st.Codec <> invalid then a = formatCodec(st.Codec)
                if st.Channels <> invalid
                    ch = formatChannels(st.Channels)
                    if ch <> "" then a += " " + ch
                end if
                if a <> "" then badges.push(a)
            end if
            exit for
        end if
    end for

    x = 0
    for each text in badges
        bw = 22 + Len(text) * 10
        bg = CreateObject("roSGNode", "Poster")
        bg.uri = "pkg:/images/badge_r6.9.png"
        bg.width = bw
        bg.height = 24
        bg.translation = [x, 0]
        m.badgesGroup.appendChild(bg)
        lbl = CreateObject("roSGNode", "Label")
        lbl.text = text
        lbl.width = bw
        lbl.height = 24
        lbl.horizAlign = "center"
        lbl.vertAlign = "center"
        lbl.color = "#FFFFFF"
        f = CreateObject("roSGNode", "Font")
        f.uri = "pkg:/fonts/Inter-Bold.ttf"
        f.size = 15
        lbl.font = f
        lbl.translation = [x, 0]
        m.badgesGroup.appendChild(lbl)
        x += bw + 14
    end for
    if audioLogo <> ""
        ' tvOS: real Dolby wordmark instead of a text capsule (assets are
        ' ~4:1, render at 24px tall to match the chip line)
        lw = 96
        if Instr(1, audioLogo, "plus") > 0 then lw = 64
        logo = CreateObject("roSGNode", "Poster")
        logo.uri = audioLogo
        logo.width = lw
        logo.height = 24
        logo.loadDisplayMode = "scaleToFit"
        logo.translation = [x, 0]
        m.badgesGroup.appendChild(logo)
    end if
end sub

function formatCodec(codec as string) as string
    c = UCase(codec)
    if c = "HEVC" or c = "H265" then return "HEVC"
    if c = "H264" or c = "AVC" then return "H.264"
    if c = "AV1" then return "AV1"
    if c = "AC3" then return "Dolby Digital"
    if c = "EAC3" then return "Dolby Digital+"
    if c = "TRUEHD" then return "Dolby TrueHD"
    if c = "DTS" or c = "DCA" then return "DTS"
    if c = "AAC" then return "AAC"
    if c = "FLAC" then return "FLAC"
    return c
end function

function formatChannels(channels as integer) as string
    if channels = 1 then return "Mono"
    if channels = 2 then return "Stereo"
    if channels = 6 then return "5.1"
    if channels = 8 then return "7.1"
    return str(channels).Trim() + "ch"
end function

' ---------- Action buttons ----------

sub buildButtons()
    item = m.item
    isContainer = (m.itemType = "Series" or m.itemType = "Season")

    ' The primary button reflects what will actually play: for a container that's
    ' the resolved episode (m.playTarget) — its progress and S:E number — so the
    ' label reads "Play S1:E1" / "Resume S1:E2". Until the target resolves it's a
    ' plain "Play". Movie/Episode reflect the item itself.
    primary = item
    if isContainer and m.playTarget <> invalid then primary = m.playTarget

    hasProgress = false
    if primary.UserData <> invalid and primary.UserData.PlaybackPositionTicks <> invalid
        if primary.UserData.PlaybackPositionTicks > 0 then hasProgress = true
    end if

    epSuffix = ""
    if isContainer and m.playTarget <> invalid and m.playTarget.ParentIndexNumber <> invalid and m.playTarget.IndexNumber <> invalid
        epSuffix = " S" + str(m.playTarget.ParentIndexNumber).Trim() + ":E" + str(m.playTarget.IndexNumber).Trim()
    end if

    ' Whole-item watched state (the Mark Watched toggle) always reads the detail
    ' item itself, never the resolved episode.
    isPlayed = false
    if item.UserData <> invalid and item.UserData.Played <> invalid then isPlayed = item.UserData.Played

    defs = []
    if hasProgress
        defs.push({ kind: "resume", label: "Resume" + epSuffix, primary: true })
        ' "Start Over" only makes sense for a concrete playable item.
        if not isContainer then defs.push({ kind: "play", label: "Start Over", primary: false })
    else
        defs.push({ kind: "play", label: "Play" + epSuffix, primary: true })
    end if
    if isPlayed
        defs.push({ kind: "markUnplayed", label: "Watched", primary: false })
    else
        defs.push({ kind: "markPlayed", label: "Mark Watched", primary: false })
    end if
    if m.itemType = "Episode" and item.SeriesId <> invalid
        defs.push({ kind: "series", label: "Series", primary: false })
    end if
    if m.itemType = "Series"
        defs.push({ kind: "shuffle", label: "Shuffle", primary: false })
    end if
    if item.LocalTrailerCount <> invalid and item.LocalTrailerCount > 0
        defs.push({ kind: "trailer", label: "Trailer", primary: false })
    end if
    defs.push({ kind: "more", label: "More", primary: false })
    m.detailButtons.buttonDefs = defs
end sub


sub onButtonActivated(event as object)
    kind = event.getData()
    item = m.item
    if item = invalid then return
    if kind = "play" or kind = "resume"
        ' Series/Season are containers, not playable. The target episode is
        ' resolved at load (m.playTarget) so the button already reflects it —
        ' just launch it. If the viewer beat the resolution, remember the intent
        ' and launch the moment it lands. Movie/Episode play directly.
        if m.itemType = "Series" or m.itemType = "Season"
            if m.playTarget <> invalid
                playResolvedTarget()
            else
                m.pendingPlay = true
            end if
        else
            m.top.playItem = { item: item, action: kind }
        end if
    else if kind = "markPlayed" or kind = "markUnplayed"
        enqueue({ action: kind, itemId: item.Id })
    else if kind = "series"
        enqueue({ action: "getItem", itemId: item.SeriesId })
    else if kind = "shuffle"
        ' Play a random episode of this series
        enqueue({ action: "getItems", parentId: item.Id, includeItemTypes: "Episode", sortBy: "Random", limit: 1 })
    else if kind = "trailer"
        ' Fetch + play the local trailer
        enqueue({ action: "getLocalTrailers", itemId: item.Id })
    else if kind = "more"
        showMoreDialog()
    end if
end sub

' More menu: Favorite toggle (Trailer is not portable — Roku channels are
' sandboxed and cannot launch the YouTube app for remote trailers)
sub showMoreDialog()
    favLabel = "Add to Favorites"
    if m.item.UserData <> invalid and m.item.UserData.IsFavorite = true then favLabel = "Remove from Favorites"
    ' Surface the full overview here — the header label is capped at 2-3 lines,
    ' so this is how the rest of a long description is read.
    overview = ""
    if m.item.Overview <> invalid then overview = m.item.Overview
    dialog = createObject("roSGNode", "StandardMessageDialog")
    dialog.title = m.item.Name
    ' Leave message unset when there is no overview -- [""] renders as a blank
    ' line above the buttons, which looks like a label that failed to load.
    if overview <> "" then dialog.message = [overview]
    dialog.buttons = [favLabel, "Cancel"]
    dialog.observeFieldScoped("buttonSelected", "onMoreDialogButton")
    m.top.getScene().dialog = dialog
end sub

sub onMoreDialogButton()
    dialog = m.top.getScene().dialog
    if dialog = invalid then return
    idx = dialog.buttonSelected
    dialog.close = true
    if idx = 0
        act = "markFavorite"
        if m.item.UserData <> invalid and m.item.UserData.IsFavorite = true then act = "removeFavorite"
        enqueue({ action: act, itemId: m.item.Id })
        enqueue({ action: "getItem", itemId: m.item.Id })
    end if
    focusZone("buttons")
end sub

sub onButtonsGoDown()
    if m.rowList.visible then focusZone("rows")
end sub

' ---------- Seasons ----------

sub onSeasonsLoaded(response as object)
    if not response.success then return
    m.seasons = response.items

    meta = ""
    if m.item.ProductionYear <> invalid then meta = str(m.item.ProductionYear).Trim()
    if m.seasons.count() > 0
        if meta <> "" then meta += " " + Chr(8226) + " "
        meta += str(m.seasons.count()).Trim() + " Seasons"
    end if
    m.metaLabel.text = meta

    if m.seasons.count() > 0
        m.selectedSeasonIndex = 0
        enqueue({ action: "getEpisodes", seriesId: m.item.Id, seasonId: m.seasons[0].Id })
    else
        buildCastRow(m.item)
        commitRows()
    end if
end sub

' ---------- Episodes ----------

sub onEpisodesLoaded(response as object)
    episodes = []
    if response.success and response.items <> invalid then episodes = response.items

    ' Rebuild the whole rowContent so the RowList stays a single multi-row list.
    m.rowContent = CreateObject("roSGNode", "ContentNode")
    m.rowKinds = []

    if m.itemType = "Series" and m.seasons.count() > 0
        srow = m.rowContent.createChild("ContentNode")
        srow.title = "Seasons"
        for i = 0 to m.seasons.count() - 1
            s = m.seasons[i]
            child = srow.createChild("ContentNode")
            child.addFields({ kind: "season", isSelected: false })
            child.kind = "season"
            name = "Season"
            if s.Name <> invalid then name = s.Name
            child.title = name
            child.isSelected = (i = m.selectedSeasonIndex)
        end for
        m.rowKinds.push("season")
    end if

    erow = m.rowContent.createChild("ContentNode")
    if m.itemType = "Episode" then erow.title = "More Episodes" else erow.title = "Episodes"
    currentId = ""
    if m.itemType = "Episode" then currentId = m.item.Id
    for each ep in episodes
        child = erow.createChild("ContentNode")
        child.addFields({ kind: "episode", itemJson: "", isPlayed: false, playedPercentage: 0, isCurrent: false })
        child.kind = "episode"
        name = ""
        if ep.Name <> invalid then name = ep.Name
        child.title = name
        sub_ = ""
        if m.isYouTube
            if ep.PremiereDate <> invalid and Len(ep.PremiereDate) >= 10 then sub_ = Left(ep.PremiereDate, 10)
        else if ep.ParentIndexNumber <> invalid and ep.IndexNumber <> invalid
            sub_ = "S" + str(ep.ParentIndexNumber).Trim() + ":E" + str(ep.IndexNumber).Trim()
        end if
        if ep.RunTimeTicks <> invalid
            mins = Int(ep.RunTimeTicks / 600000000)
            if mins > 0
                if sub_ <> "" then sub_ += " " + Chr(8226) + " "
                sub_ += str(mins).Trim() + " min"
            end if
        end if
        child.description = sub_
        if ep.Id <> invalid and ep.ImageTags <> invalid and ep.ImageTags.Primary <> invalid
            child.HDPosterUrl = ImageUrl.primary(ep.Id, 480)
        else if ep.SeriesId <> invalid
            child.HDPosterUrl = ImageUrl.primary(ep.SeriesId, 480)
        end if
        ' Carry the YouTube flag into each episode so opening one from a
        ' channel's detail keeps the channel avatar + name header (the fetched
        ' episode alone may not self-detect as YouTube).
        if m.isYouTube then ep._forceYouTube = true
        child.itemJson = FormatJSON(ep)
        if ep.UserData <> invalid
            if ep.UserData.Played <> invalid then child.isPlayed = ep.UserData.Played
            if ep.UserData.PlayedPercentage <> invalid then child.playedPercentage = ep.UserData.PlayedPercentage
        end if
        if currentId <> "" and ep.Id = currentId
            child.isCurrent = true
            m.currentEpIndex = erow.getChildCount() - 1
        end if
    end for
    m.rowKinds.push("episode")

    buildCastRow(m.item)
    commitRows()
end sub
sub buildCastRow(item as object)
    if item.People = invalid or item.People.count() = 0 then return
    crow = m.rowContent.createChild("ContentNode")
    crow.title = "Cast"
    count = 0
    for each person in item.People
        pType = ""
        if person.Type <> invalid then pType = person.Type
        if pType = "Actor"
            if count >= 20 then exit for
            child = crow.createChild("ContentNode")
            child.addFields({ kind: "cast" })
            child.kind = "cast"
            child.title = person.Name
            desc = ""
            if person.Role <> invalid then desc = person.Role
            child.description = desc
            if person.Id <> invalid and person.PrimaryImageTag <> invalid
                child.HDPosterUrl = ImageUrl.primary(person.Id, 200)
            end if
            count = count + 1
        end if
    end for
    if crow.getChildCount() > 0 then m.rowKinds.push("cast")
end sub

' Apply per-row item sizes and push content into the single RowList.
sub commitRows()
    if m.rowContent = invalid or m.rowContent.getChildCount() = 0
        m.rowList.visible = false
        return
    end if

    sizes = []
    spacings = []
    heights = []
    for each kind in m.rowKinds
        if kind = "season"
            sizes.push([200, 100])
            spacings.push([16, 0])
            heights.push(150.0)    ' label + chip; default 300 left a dead gap
        else if kind = "episode"
            sizes.push([240, 250])
            spacings.push([30, 0])
            heights.push(300.0)
        else
            ' Cast: 168w so most names fit one line; extra height for 2-line wraps
            sizes.push([168, 248])
            spacings.push([20, 0])
            heights.push(296.0)
        end if
    end for
    m.rowList.rowItemSize = sizes
    m.rowList.rowItemSpacing = spacings
    m.rowList.rowHeights = heights
    m.rowList.content = m.rowContent
    m.rowList.visible = true

    ' tvOS parity: scroll the episode strip to the CURRENT episode so its
    ' breathing ring is on-screen (it was always drawn, but for episodes deep
    ' in a season it sat scrolled off to the right where nobody saw it).
    ' jumpToRowItem also pre-positions descent focus onto that episode; if the
    ' episode row isn't the first row, jump back vertically so the layout
    ' still opens at the top.
    if m.currentEpIndex <> invalid
        epRow = -1
        for i = 0 to m.rowKinds.count() - 1
            if m.rowKinds[i] = "episode" then epRow = i : exit for
        end for
        if epRow >= 0
            m.rowList.jumpToRowItem = [epRow, m.currentEpIndex]
            if epRow > 0 then m.rowList.jumpToItem = 0
        end if
    end if
end sub

sub onRowItemSelected()
    sel = m.rowList.rowItemSelected
    if sel = invalid or sel.count() < 2 then return
    rowIndex = sel[0]
    itemIndex = sel[1]
    if rowIndex >= m.rowKinds.count() then return
    kind = m.rowKinds[rowIndex]

    if kind = "season"
        if itemIndex <> m.selectedSeasonIndex
            m.selectedSeasonIndex = itemIndex
            season = m.seasons[itemIndex]
            enqueue({ action: "getEpisodes", seriesId: m.item.Id, seasonId: season.Id })
        end if
    else if kind = "episode"
        row = m.rowContent.getChild(rowIndex)
        if row = invalid then return
        child = row.getChild(itemIndex)
        if child = invalid or child.itemJson = "" then return
        itemData = ParseJSON(child.itemJson)
        if itemData <> invalid then m.top.selectedItem = itemData
    end if
end sub

' ---------- Focus zones ----------

sub focusZone(zone as string)
    m.zone = zone
    if zone = "rows" and m.rowList.visible
        m.rowList.setFocus(true)
    else
        m.zone = "buttons"
        m.detailButtons.setFocus(true)
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' Must precede the m.item guard: a failed load never sets m.item, which is
    ' exactly when the Retry button is the only thing on screen.
    if key = "OK" and m.errorRetry.hasFocus()
        retryLoad()
        return true
    end if

    if m.item = invalid then return false

    ' The RowList and DetailButtons handle their own keys; the screen only
    ' handles the RowList -> buttons boundary when the list bubbles Up at row 0.
    if m.rowList.isInFocusChain()
        if key = "up"
            focusZone("buttons")
            return true
        end if
        return false
    end if
    return false
end function
