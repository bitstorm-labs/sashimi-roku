<?xml version="1.0" encoding="UTF-8" ?>
<component name="MediaDetailScreen" extends="Group">
    <interface>
        <field id="itemData" type="assocarray" onChange="onItemDataChanged" />
        <field id="selectedItem" type="assocarray" alwaysNotify="true" />
        <field id="playItem" type="assocarray" alwaysNotify="true" />
        <!-- A cast/crew cell was selected: MainScene pushes PersonScreen. -->
        <field id="selectedPerson" type="assocarray" alwaysNotify="true" />
        <!-- Set when the title is on a saved server other than the active one
             (itemData._server, #120). MainScene refuses playItem from such a
             screen; the Play controls are hidden there anyway. -->
        <field id="pinnedServerId" type="string" value="" />
        <!-- "Switch to <server>" confirmed: { serverId, item }. MainScene makes
             that server active and reopens the item there. -->
        <field id="switchServer" type="assocarray" alwaysNotify="true" />
        <!-- Add to Channel (administrators): { mode: "add", target }. MainScene
             pushes ChannelManagerScreen. -->
        <field id="manageChannels" type="assocarray" alwaysNotify="true" />
        <!-- DetailNav.key of the item on screen, so MainScene can find a
             series already on the stack. -->
        <field id="navKey" type="string" value="" />
        <!-- Series button / Go to Series: { id, key }. MainScene pops back to
             that series if it is underneath, else calls showInPlace. -->
        <field id="goToSeries" type="assocarray" alwaysNotify="true" />
        <function name="showInPlace" />
        <field id="autoPlay" type="boolean" value="false" />
        <!-- Deep link (cert 5.2) could not be resolved: MainScene pops to home
             and shows an error rather than stranding the user on a blank
             springboard. -->
        <field id="deepLinkFailed" type="boolean" value="false" alwaysNotify="true" />
        <!-- Whose local trailer the hero plays ("" for none), set once the item
             loads. MainScene forwards it to HeroTrailerPlayer, which ignores an
             unchanged value, so alwaysNotify only matters for "" after "". -->
        <field id="trailerSourceId" type="string" value="" alwaysNotify="true" />
        <!-- Whether that trailer plays to its end (a movie) rather than the
             30 s clip. Written just before trailerSourceId. -->
        <field id="trailerToEnd" type="boolean" value="false" />
        <!-- HeroTrailerPlayer lends this screen its Video node while it owns the
             trailer. -->
        <function name="heroTrailerAttach" />
        <function name="heroTrailerShow" />
        <function name="heroTrailerDetach" />
    </interface>
    <children>
        <!-- Background (matches app gradient) -->
        <Poster uri="pkg:/images/bg_gradient.png" width="1920" height="1080" />

        <!-- Hero trailer (HeroTrailerPlayer). The Video node sits UNDER the
             backdrop so the image cross-fades over it, and the image coming
             back is just its opacity returning to 1. A MaskGroup can't mask a
             Video, so trailerFeather -- the backdrop mask inverted and painted
             in the page gradient's colours row by row, since a flat colour
             can't feather against a gradient -- fades its left and bottom
             edges into the page exactly as the mask fades the image's
             (scripts/make-detail-fades.sh builds both). -->
        <Group id="trailerSlot" />
        <Poster id="trailerFeather" uri="pkg:/images/trailer_feather.png"
                width="1056" height="594" translation="[864, 0]" visible="false" />

        <!-- Backdrop / episode thumbnail, laid out like the home hero
             (HeroBanner) and the Apple MediaDetailView: ~half the screen wide,
             flush against the top and right screen edges, fading only on its
             LEFT edge (into the title text) and BOTTOM edge (into the rows).
             The mask + poster are resized in onBackdropStatus to hug the
             FITTED image: scaleToFit centers the image inside its region, so a
             mask sized to the region would fade the region's edges, not the
             image's -- the hero seam bug. -->
        <MaskGroup id="backdropMask" maskUri="pkg:/images/backdrop_feather.png"
                   maskSize="[1056, 594]" translation="[864, 0]">
            <Poster id="backdropImage" width="1056" height="594" loadWidth="1280" loadHeight="720"
                    loadDisplayMode="scaleToFit" />
        </MaskGroup>

        <!-- ===== Fixed header ===== -->
        <Poster id="logoImage" width="760" height="210" loadDisplayMode="scaleToFit"
                translation="[60, 60]" visible="false" />
        <MaskGroup id="moviePosterMask" maskUri="pkg:/images/poster_mask_r12.png"
                   maskSize="[200, 300]" translation="[60, 60]" visible="false">
            <Poster id="moviePoster" width="200" height="300" loadWidth="400" loadHeight="600"
                    loadDisplayMode="scaleToZoom" />
        </MaskGroup>
        <MaskGroup id="channelMask" maskUri="pkg:/images/circle_mask.png"
                   maskSize="[120, 120]" translation="[60, 60]" visible="false">
            <Poster id="channelImage" width="120" height="120" loadWidth="240" loadHeight="240"
                    loadDisplayMode="scaleToZoom" />
        </MaskGroup>

        <!-- YouTube channel name beside the avatar (tvOS parity). Vertically
             centered on the 120px avatar (y 60-180): height 48 at y=96. -->
        <Label id="channelLabel" text="" color="#BFBFBF" width="1100" maxLines="1"
               height="48" vertAlign="center" translation="[210, 96]" visible="false">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="32" />
        </Label>

        <Label id="titleLabel" text="" color="#FFFFFF" width="1000" maxLines="2" wrap="true" translation="[60, 250]">
            <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="38" />
        </Label>
        <Label id="endsAtLabel" text="" color="#8C5CC7" maxLines="1" translation="[60, 312]">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="22" />
        </Label>
        <Label id="metaLabel" text="" color="#BFBFBF" maxLines="1" translation="[60, 312]">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="22" />
        </Label>

        <Group id="ratingsGroup" translation="[60, 352]">
            <Poster id="tmdbLogo" uri="pkg:/images/tmdb_logo_tv.png" width="34" height="24"
                    loadDisplayMode="scaleToFit" visible="false" />
            <Label id="tmdbScore" text="" color="#FFFFFF" height="24" vertAlign="center" translation="[44, 0]" visible="false">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="20" />
            </Label>
            <Poster id="tomatoIcon" uri="pkg:/images/tomato.png" width="24" height="24"
                    translation="[140, 0]" visible="false" />
            <Label id="tomatoScore" text="" color="#FFFFFF" height="24" vertAlign="center" translation="[172, 0]" visible="false">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="20" />
            </Label>
        </Group>

        <!-- Season page info row: "2026 • TV-MA", the status badge after it. -->
        <Label id="seasonInfoLabel" text="" color="#BFBFBF" maxLines="1" height="24"
               vertAlign="center" translation="[360, 224]" visible="false">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="22" />
        </Label>

        <Group id="badgesGroup" translation="[280, 352]" />
        <Group id="tagsGroup" translation="[60, 446]" />

        <Label id="overviewLabel" text="" color="#BFBFBF" width="940" maxLines="2"
               wrap="true" translation="[60, 596]">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="24" />
        </Label>

        <!-- Action buttons (focusable component) -->
        <DetailButtons id="detailButtons" translation="[60, 500]" />

        <!-- ===== One multi-row RowList: seasons / episodes / cast =====
             floatingFocus: a row only scrolls once focus would leave the
             visible width. fixedFocus pinned the focused item to the left
             edge, so picking Season 5 of The 100 pushed Seasons 1-4 off
             screen even though all seven chips fit. -->
        <RowList
            id="rowList"
            translation="[60, 734]"
            itemSize="[1800, 300]"
            numRows="2"
            itemSpacing="[0, 20]"
            showRowLabel="[true]"
            showRowCounter="[false]"
            drawFocusFeedback="false"
            rowLabelColor="#FFFFFF"
            rowLabelOffset="[[0, 8]]"
            rowFocusAnimationStyle="floatingFocus"
            itemComponentName="DetailRowItem"
            visible="false"
        />

        <Label id="loadingLabel" text="Loading..." color="#8C8C8C"
               horizAlign="center" width="1920" translation="[0, 500]" visible="false">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="28" />
        </Label>

        <!-- Failed item load. m.item stays invalid, so nothing else on this
             screen is focusable or even rendered — Retry is a real focusable
             node so the screen is not a dead blank rectangle. -->
        <Label id="errorLabel" text="" color="#888888"
               horizAlign="center" width="1920" translation="[0, 470]" visible="false">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="28" />
        </Label>
        <Group id="errorRetry" translation="[860, 560]" visible="false">
            <Rectangle width="200" height="56" color="#8C5CC7FF" />
            <Label text="Retry" color="#FFFFFF" width="200" height="56" horizAlign="center" vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="26" />
            </Label>
        </Group>

        <Animation id="heroFade" duration="0.6" easeFunction="inOutQuad" repeat="false">
            <FloatFieldInterpolator id="heroFadeInterp" key="[0.0, 1.0]" keyValue="[1.0, 0.0]"
                                    fieldToInterp="backdropMask.opacity" />
        </Animation>

        <JellyfinApi id="apiTask" />
    </children>
</component>
