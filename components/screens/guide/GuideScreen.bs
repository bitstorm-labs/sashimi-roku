import "pkg:/source/utils/ImageUrl.bs"
import "pkg:/source/utils/Reminders.bs"
' The Stations guide: channels down, time across.
'
' Focus is managed by hand rather than by a RowList. The cells are not uniform —
' a 22-minute sitcom and a two-hour film are the same programme to the grid but
' wildly different widths — and a RowList wants a fixed item size per row. The
' screen therefore owns m.rowIndex/m.colIndex and repaints focus itself, the
' same shape SettingsScreen uses.

' Geometry. Three hours at 7.5px/minute is 1350px, which fits beside the rail
' and the channel column without scrolling sideways.
' 14px a minute, not the 7.5 that fits three hours on one screen. At 7.5 a
' 22-minute episode is 165px and its title is an ellipsis; the grid is worth
' more when you can read it, so it is wider than the screen and scrolls.
const PX_PER_MIN = 14
' Root screens are already positioned to the right of the 136px rail, so these
' are relative to the content area (1784 wide), not the screen. Indenting from
' 1920 as well pushed the timeline off the right edge.
const GRID_X = 396
const GRID_TOP = 196
const ROW_H = 96
const ROW_GAP = 12
const CHANNEL_X = 40
const CHANNEL_W = 340
const RULER_Y = 150
const CONTENT_W = 1784
const WINDOW_HOURS = 3
' What is fetched: a week, the horizon a printed guide had. Only WINDOW_HOURS
' of it is drawn at once — a week at PX_PER_MIN would be thousands of nodes —
' and the window slides as focus moves past its edges or a day is picked.
const FETCH_HOURS = 168
' Where the window slides to when focus runs off its right edge.
const SLIDE_HOURS = 2
const CHIPS_X = 230
const CHIPS_Y = 54
' Wide enough for a title, always. The programme a row opens with is usually
' the one part-way through — often with a minute left, which is 14px — and that
' is the cell a viewer most wants to read and tune into. Given the choice
' between an ellipsis and a row that runs further right, this takes the row.
'
' The cost is honest: a block widened to this minimum pushes everything after it
' along, so past that point the ruler is approximate rather than exact. It only
' happens to programmes too short to label at all.
const MIN_BLOCK_W = 240

sub init()
    m.apiTask = m.top.findNode("apiTask")
    m.grid = m.top.findNode("grid")
    m.viewport = m.top.findNode("viewport")
    m.scroller = m.top.findNode("scroller")
    m.rulerGroup = m.top.findNode("rulerGroup")
    m.channelGroup = m.top.findNode("channelGroup")
    m.rowsGroup = m.top.findNode("rowsGroup")
    m.nowLine = m.top.findNode("nowLine")
    m.statusLabel = m.top.findNode("statusLabel")
    m.clockLabel = m.top.findNode("clockLabel")
    m.detailOverlay = m.top.findNode("detailOverlay")
    m.tickTimer = m.top.findNode("tickTimer")

    m.rows = []
    m.cells = []
    m.rowIndex = 0
    m.colIndex = 0
    m.windowStart = 0
    m.detailUp = false
    m.detailRow = invalid
    m.detailProg = invalid
    m.scrollX = 0
    m.chipsFocused = false
    m.chipIndex = 0
    m.jumpIndex = 0
    m.chips = []
    m.chipNodes = []
    m.chipsGroup = m.top.createChild("Group")
    m.chipsGroup.translation = [CHIPS_X, CHIPS_Y]
    m.viewportW = CONTENT_W - GRID_X - 20
    m.viewport.clippingRect = [GRID_X - 8, 0, m.viewportW + 8, 1080]

    m.apiTask.observeFieldScoped("response", "onApiResponse")
    ' The task is a long-running message loop; without this it never reads a
    ' request and the screen waits on a response that cannot come.
    m.apiTask.control = "RUN"
    m.tickTimer.observeFieldScoped("fire", "onTick")
    m.top.observeFieldScoped("focusedChild", "onFocusGained")

    load()
end sub

sub load()
    m.statusLabel.visible = true
    m.statusLabel.text = "Loading guide..."
    m.grid.visible = false
    m.apiTask.request = { action: "getGuide", hours: FETCH_HOURS }
end sub

sub onApiResponse()
    r = m.apiTask.response
    if r = invalid then return
    if r.action = "getGuide"
        onGuideLoaded(r)
    else if r.action = "getChannelNowPlaying"
        onTuneResolved(r)
    else if r.action = "getItem" and r.context = "guideTune"
        onTuneItemLoaded(r)
    end if
end sub

sub onGuideLoaded(r as object)
    if not r.success or r.rows = invalid or r.rows.count() = 0
        m.statusLabel.text = "No channels yet. Channels are created in Jellyfin under Dashboard -> Plugins -> Channels."
        return
    end if
    m.rows = r.rows
    m.windowStart = nowEpoch()
    m.jumpIndex = 0
    buildChips()
    buildGrid()
    m.statusLabel.visible = false
    m.grid.visible = true
    m.tickTimer.control = "start"
    updateFocus()
end sub

' ---------- Building ----------

sub buildGrid()
    m.rulerGroup.removeChildrenIndex(m.rulerGroup.getChildCount(), 0)
    m.channelGroup.removeChildrenIndex(m.channelGroup.getChildCount(), 0)
    m.rowsGroup.removeChildrenIndex(m.rowsGroup.getChildCount(), 0)
    m.cells = []

    buildRuler()

    m.contentW = 0
    for i = 0 to m.rows.count() - 1
        y = GRID_TOP + i * (ROW_H + ROW_GAP)
        buildChannelLabel(m.rows[i], i, y)
        cells = buildRow(m.rows[i], y)
        m.cells.push(cells)
        if cells.count() > 0
            last = cells[cells.count() - 1]
            right = last.group.translation[0] + last.width
            if right > m.contentW then m.contentW = right
        end if
    end for
    m.scrollX = 0
    applyScroll()

    m.nowLine.height = m.rows.count() * (ROW_H + ROW_GAP) + 46
    m.nowLine.translation = [GRID_X, RULER_Y]
    m.nowLine.visible = true
    positionNowLine()
    updateClock()
end sub

' Half-hour ticks across the window, in round numbers rather than starting at
' whatever minute it happens to be.
sub buildRuler()
    first = Int(m.windowStart / 1800) * 1800
    if first < m.windowStart then first = first + 1800
    for i = 0 to WINDOW_HOURS * 2
        t = first + i * 1800
        label = m.rulerGroup.createChild("Label")
        label.color = "#8C8C8C"
        label.text = clockText(t)
        label.font = fontOf("pkg:/fonts/Inter-Medium.ttf", 20)
        label.translation = [GRID_X + offsetFor(t), RULER_Y]
    end for
end sub

sub buildChannelLabel(row as object, index as integer, y as integer)
    rail = m.channelGroup.createChild("Rectangle")
    rail.width = 4
    rail.height = ROW_H - 8
    rail.color = railColour(index)
    rail.translation = [CHANNEL_X, y]

    ' Number, logo, then name — each vertically centred in the row, the
    ' number leading at the left the way a printed guide set its columns.
    rowH = ROW_H - 8
    x = CHANNEL_X + 14
    hasNumber = (row.number <> invalid and row.number > 0)
    if hasNumber
        num = m.channelGroup.createChild("Label")
        num.color = railColour(index)
        num.text = row.number.toStr()
        num.font = fontOf("pkg:/fonts/Inter-Bold.ttf", 26)
        num.width = 40
        num.height = rowH
        num.vertAlign = "center"
        num.translation = [x, y]
        x = x + 46
    end if
    textX = x
    ' The logo travels with the name, on its line; the description runs under both.
    nameX = textX
    logoUri = ImageUrl.channelLogo(row.id, row.logo)
    if logoUri <> ""
        logo = m.channelGroup.createChild("Poster")
        logo.uri = logoUri
        logo.width = 28
        logo.height = 28
        logo.loadDisplayMode = "scaleToFit"
        logo.translation = [textX, y]
        nameX = textX + 36
    end if

    name = m.channelGroup.createChild("Label")
    name.color = "#FFFFFF"
    name.text = UCase(row.name)
    name.font = fontOf("pkg:/fonts/Inter-Bold.ttf", 22)
    name.width = CHANNEL_W - 4 - nameX + CHANNEL_X
    name.maxLines = 1
    name.ellipsizeOnBoundary = true
    name.translation = [nameX, y]

    if row.description <> invalid and row.description <> ""
        desc = m.channelGroup.createChild("Label")
        desc.color = "#8C8C8C"
        desc.text = row.description
        desc.font = fontOf("pkg:/fonts/Inter-Regular.ttf", 17)
        desc.width = CHANNEL_W - 4 - textX + CHANNEL_X
        desc.maxLines = 2
        desc.wrap = true
        desc.ellipsizeOnBoundary = true
        desc.translation = [textX, y + 30]
    end if
end sub

function buildRow(row as object, y as integer) as object
    reminded = {}
    for each r in Reminders.all()
        reminded[r.key] = true
    end for
    cells = []
    windowEnd = m.windowStart + WINDOW_HOURS * 3600
    cursor = 0

    for each prog in row.programs
        if prog.endEpoch <= m.windowStart then continue for
        if prog.startEpoch >= windowEnd then continue for

        ' Proportional to the part inside the window: the guide includes the
        ' programme straddling the right-hand edge, and drawing it at full
        ' length would push the row past the ruler.
        visibleStart = prog.startEpoch
        if visibleStart < m.windowStart then visibleStart = m.windowStart
        visibleEnd = prog.endEpoch
        if visibleEnd > windowEnd then visibleEnd = windowEnd

        w = Int(((visibleEnd - visibleStart) / 60.0) * PX_PER_MIN) - 6
        if w < MIN_BLOCK_W then w = MIN_BLOCK_W
        x = GRID_X + offsetFor(visibleStart)
        ' Blocks are placed at their true time, EXCEPT where the one before was
        ' widened to the readable minimum — then it would be drawn underneath
        ' its neighbour. Pushing right keeps the row legible and non-overlapping;
        ' the distortion only ever affects programmes too short to label anyway,
        ' and it is gone again by the next full-width block.
        if x < cursor then x = cursor
        cursor = x + w + 6

        group = m.rowsGroup.createChild("Group")
        group.translation = [x, y]

        bg = group.createChild("Poster")
        bg.uri = "pkg:/images/card_r16.9.png"
        bg.width = w
        bg.height = ROW_H

        dot = group.createChild("Rectangle")
        dot.width = 8
        dot.height = 8
        dot.color = "#FF3B30"
        dot.translation = [14, 20]

        title = group.createChild("Label")
        title.color = "#FFFFFF"
        title.text = prog.title
        title.font = fontOf("pkg:/fonts/Inter-Bold.ttf", 20)
        title.width = w - 28
        title.maxLines = 1
        title.ellipsizeOnBoundary = true
        title.translation = [14, 14]

        sub_ = group.createChild("Label")
        sub_.color = "#BFBFBF"
        sub_.text = prog.subtitle
        sub_.font = fontOf("pkg:/fonts/Inter-Medium.ttf", 17)
        sub_.width = w - 28
        sub_.maxLines = 1
        sub_.ellipsizeOnBoundary = true
        sub_.translation = [14, 42]

        start = group.createChild("Label")
        start.color = "#8C8C8C"
        start.text = metaText(row, prog, reminded.doesExist(Reminders.keyFor(row.id, prog.startEpoch)))
        start.font = fontOf("pkg:/fonts/Inter-Regular.ttf", 16)
        start.width = w - 28
        start.maxLines = 1
        start.translation = [14, 66]

        cells.push({ group: group, bg: bg, dot: dot, title: title, meta: start, row: row, prog: prog, width: w })
    end for
    return cells
end function

' The small line under a programme: its start time, then what is special
' about it. NEW = added to the library this week; REMINDER = set on this
' device with the options (*) key.
function metaText(row as object, prog as object, reminded as boolean) as string
    text = startText(prog.startEpoch)
    if prog.isNew = true then text += "  ·  NEW"
    if reminded then text += "  ·  REMINDER SET"
    return text
end function

' ---------- Focus ----------

sub onFocusGained()
    updateFocus()
end sub

sub updateFocus()
    ensureFocusVisible()
    hasFocus = m.top.isInFocusChain() and not m.detailUp and not m.chipsFocused
    now = nowEpoch()

    for r = 0 to m.cells.count() - 1
        for c = 0 to m.cells[r].count() - 1
            cell = m.cells[r][c]
            airing = (cell.prog.startEpoch <= now and now < cell.prog.endEpoch)
            focused = (hasFocus and r = m.rowIndex and c = m.colIndex)

            ' What is on now reads as filled; everything later is a quieter
            ' surface, so the eye lands on the present first. There is no
            ' separate "now" asset — the ordinary card is tinted, which keeps
            ' the corner radius identical across all three states.
            if focused
                cell.bg.uri = "pkg:/images/card_r16_focus.9.png"
                cell.bg.blendColor = "#FFFFFF"
            else
                cell.bg.uri = "pkg:/images/card_r16.9.png"
                if airing
                    cell.bg.blendColor = "#6E4F9E"
                else
                    cell.bg.blendColor = "#FFFFFF"
                end if
            end if
            cell.dot.visible = airing
            ' The dot takes the title's left edge, so the title shifts when one
            ' is showing rather than running underneath it.
            if airing
                cell.title.translation = [28, 14]
                cell.title.width = cell.width - 42
            else
                cell.title.translation = [14, 14]
                cell.title.width = cell.width - 28
            end if
        end for
    end for
end sub

' Keep the focused block fully on screen, with a margin so the next one is
' visibly there to move to rather than appearing out of nowhere.
sub ensureFocusVisible()
    if m.cells.count() = 0 then return
    if m.cells[m.rowIndex].count() = 0 then return
    cell = m.cells[m.rowIndex][m.colIndex]
    margin = 60
    left = cell.group.translation[0]
    right = left + cell.width

    if left - margin < GRID_X + m.scrollX
        m.scrollX = left - margin - GRID_X
    else if right + margin > GRID_X + m.scrollX + m.viewportW
        m.scrollX = right + margin - GRID_X - m.viewportW
    end if

    maxScroll = m.contentW - GRID_X - m.viewportW
    if maxScroll < 0 then maxScroll = 0
    if m.scrollX > maxScroll then m.scrollX = maxScroll
    if m.scrollX < 0 then m.scrollX = 0
    applyScroll()
end sub

sub applyScroll()
    m.scroller.translation = [-m.scrollX, 0]
end sub

sub onTick()
    positionNowLine()
    updateClock()
    updateFocus()
end sub

sub positionNowLine()
    now = nowEpoch()
    m.nowLine.translation = [GRID_X + offsetFor(now), RULER_Y]
    m.nowLine.visible = (now >= m.windowStart)
end sub

sub updateClock()
    dt = CreateObject("roDateTime")
    dt.ToLocalTime()
    ' Short form: the long one overran its label and ran off the screen edge.
    m.clockLabel.text = dt.AsDateStringNoParam() + "  " + clockText(nowEpoch())
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if m.detailUp
        if key = "options"
            toggleReminder(m.detailRow, m.detailProg)
            updateDetailHint()
            return true
        end if
        if key = "back" or key = "OK"
            m.detailOverlay.visible = false
            m.detailUp = false
            updateFocus()
            return true
        end if
        return true
    end if

    if m.cells.count() = 0 then return false

    if m.chipsFocused then return onChipKey(key)

    if key = "right"
        if m.colIndex < m.cells[m.rowIndex].count() - 1
            m.colIndex = m.colIndex + 1
            updateFocus()
        else
            slideForward()
        end if
        return true
    else if key = "left"
        if m.colIndex > 0
            m.colIndex = m.colIndex - 1
            updateFocus()
            return true
        end if
        if slideBack() then return true
        ' At the first programme and the window is at now: let the press fall
        ' through so the rail can take focus, the way every other screen behaves.
        return false
    else if key = "down"
        if m.rowIndex < m.cells.count() - 1
            m.rowIndex = m.rowIndex + 1
            clampColumn()
            updateFocus()
        end if
        return true
    else if key = "up"
        if m.rowIndex > 0
            m.rowIndex = m.rowIndex - 1
            clampColumn()
            updateFocus()
        else
            m.chipsFocused = true
            m.chipIndex = m.jumpIndex
            updateChips()
            updateFocus()
        end if
        return true
    else if key = "OK"
        activate()
        return true
    else if key = "options"
        cell = m.cells[m.rowIndex][m.colIndex]
        if cell <> invalid and cell.prog.startEpoch > nowEpoch() then toggleReminder(cell.row, cell.prog)
        return true
    end if
    return false
end function

' ---------- Reminders ----------

sub toggleReminder(row as object, prog as object)
    Reminders.toggle({
        key: Reminders.keyFor(row.id, prog.startEpoch),
        channelId: row.id,
        channelName: row.name,
        channelNumber: row.number,
        title: prog.title,
        startEpoch: prog.startEpoch,
        endEpoch: prog.endEpoch
    })
    refreshReminderMarks()
end sub

' Redraws the marks in place — rebuilding the grid would throw away focus.
sub refreshReminderMarks()
    marked = {}
    for each r in Reminders.all()
        marked[r.key] = true
    end for
    for each rowCells in m.cells
        for each cell in rowCells
            cell.meta.text = metaText(cell.row, cell.prog, marked.doesExist(Reminders.keyFor(cell.row.id, cell.prog.startEpoch)))
        end for
    end for
    buildChips()
end sub

sub updateDetailHint()
    hint = m.top.findNode("detailHint")
    if Reminders.has(Reminders.keyFor(m.detailRow.id, m.detailProg.startEpoch))
        hint.text = "Reminder set — you'll get a banner 5 minutes before.   * to clear   Back to close"
    else
        hint.text = "Airs later.   * to remind me   Back to close"
    end if
end sub

' ---------- Days ----------

' Now, Tonight (only while 18:00 is still ahead), and the next six days at
' 18:00 — the way a printed guide was read.
sub buildChips()
    m.chipsGroup.removeChildrenIndex(m.chipsGroup.getChildCount(), 0)
    m.chips = []
    m.chipNodes = []
    now = nowEpoch()
    midnight = localMidnight(now)
    m.chips.push({ label: "Now", target: now })
    tonight = midnight + 18 * 3600
    if tonight > now then m.chips.push({ label: "Tonight", target: tonight })
    for d = 1 to 6
        t = localDayAt(midnight, d, 18)
        m.chips.push({ label: weekdayShort(t), target: t })
    end for
    ' Only there while something is set; it is the way to clear them all.
    reminderCount = Reminders.all().count()
    if reminderCount > 0
        m.chips.push({ label: "Clear reminders (" + reminderCount.toStr() + ")", clearReminders: true })
    end if
    if m.chipIndex > m.chips.count() - 1 then m.chipIndex = m.chips.count() - 1

    x = 0
    for i = 0 to m.chips.count() - 1
        label = m.chips[i].label
        w = 34 + Len(label) * 13
        group = m.chipsGroup.createChild("Group")
        group.translation = [x, 0]
        bg = group.createChild("Poster")
        bg.uri = "pkg:/images/pill_selected.9.png"
        bg.width = w
        bg.height = 44
        text = group.createChild("Label")
        text.text = label
        text.font = fontOf("pkg:/fonts/Inter-Bold.ttf", 21)
        text.width = w
        text.height = 44
        text.horizAlign = "center"
        text.vertAlign = "center"
        m.chipNodes.push({ bg: bg, text: text })
        x = x + w + 10
    end for
    updateChips()
end sub

sub updateChips()
    for i = 0 to m.chipNodes.count() - 1
        n = m.chipNodes[i]
        focused = (m.chipsFocused and i = m.chipIndex)
        picked = (i = m.jumpIndex)
        if focused
            n.bg.uri = "pkg:/images/pill_selected_focus.9.png"
            n.bg.blendColor = "#FFFFFF"
            n.text.color = "#000000"
        else if picked
            n.bg.uri = "pkg:/images/pill_selected.9.png"
            n.bg.blendColor = "#8C5CC7"
            n.text.color = "#FFFFFF"
        else
            n.bg.uri = "pkg:/images/pill_selected.9.png"
            n.bg.blendColor = "#2A2A2A"
            n.text.color = "#D9D9D9"
        end if
    end for
end sub

function onChipKey(key as string) as boolean
    if key = "right"
        if m.chipIndex < m.chips.count() - 1 then m.chipIndex = m.chipIndex + 1
    else if key = "left"
        if m.chipIndex > 0 then m.chipIndex = m.chipIndex - 1
    else if key = "down"
        m.chipsFocused = false
    else if key = "OK" and m.chips[m.chipIndex].doesExist("clearReminders")
        Reminders.clearAll()
        refreshReminderMarks()
        m.chipIndex = m.jumpIndex
    else if key = "OK"
        m.jumpIndex = m.chipIndex
        m.windowStart = m.chips[m.chipIndex].target
        m.chipsFocused = false
        m.colIndex = 0
        buildGrid()
    else if key = "back"
        m.chipsFocused = false
    else
        return false
    end if
    updateChips()
    updateFocus()
    return true
end function

' ---------- Sliding the window ----------

' Focus ran off the right edge: move the window so the focused programme is
' at the left and focus lands on the one after it.
sub slideForward()
    row = m.cells[m.rowIndex]
    if row.count() = 0 then return
    focused = row[m.colIndex].prog
    newStart = focused.startEpoch
    if newStart <= m.windowStart then newStart = m.windowStart + SLIDE_HOURS * 3600
    if not hasProgramsAfter(focused.endEpoch) then return
    m.windowStart = newStart
    buildGrid()
    m.colIndex = indexAfter(m.cells[m.rowIndex], focused.endEpoch)
    updateFocus()
end sub

' Focus ran off the left edge: slide back, never earlier than now.
function slideBack() as boolean
    now = nowEpoch()
    if m.windowStart <= now then return false
    edge = m.windowStart
    newStart = m.windowStart - SLIDE_HOURS * 3600
    if newStart < now then newStart = now
    m.windowStart = newStart
    if newStart = now then m.jumpIndex = 0
    updateChips()
    buildGrid()
    ' Land on the last programme that started before the old left edge.
    cells = m.cells[m.rowIndex]
    m.colIndex = 0
    for c = 0 to cells.count() - 1
        if cells[c].prog.startEpoch < edge then m.colIndex = c
    end for
    updateFocus()
    return true
end function

function hasProgramsAfter(epoch as integer) as boolean
    for each prog in m.rows[m.rowIndex].programs
        if prog.startEpoch >= epoch then return true
    end for
    return false
end function

function indexAfter(cells as object, epoch as integer) as integer
    for c = 0 to cells.count() - 1
        if cells[c].prog.endEpoch > epoch then return c
    end for
    if cells.count() = 0 then return 0
    return cells.count() - 1
end function

function localOffset() as integer
    utc = CreateObject("roDateTime")
    local = CreateObject("roDateTime")
    local.ToLocalTime()
    return local.AsSeconds() - utc.AsSeconds()
end function

' Epoch of the local midnight that starts the day containing `epoch`.
function localMidnight(epoch as integer) as integer
    off = localOffset()
    return Int((epoch + off) / 86400) * 86400 - off
end function

' Epoch of `hour`:00 local, `days` after the day starting at `midnight`.
' Recomputes the offset for that day so a DST change mid-week does not put
' Saturday's prime time at 17:00 or 19:00.
function localDayAt(midnight as integer, days as integer, hour as integer) as integer
    guess = midnight + days * 86400 + hour * 3600
    return localMidnight(guess) + hour * 3600
end function

function weekdayShort(epoch as integer) as string
    dt = CreateObject("roDateTime")
    dt.FromSeconds(epoch)
    dt.ToLocalTime()
    return Left(dt.GetWeekday(), 3)
end function

' Rows have different numbers of programmes; moving between them must not land
' on a column that does not exist.
sub clampColumn()
    count = m.cells[m.rowIndex].count()
    if count = 0
        m.colIndex = 0
    else if m.colIndex > count - 1
        m.colIndex = count - 1
    end if
end sub

' ---------- Selection ----------

sub activate()
    if m.cells[m.rowIndex].count() = 0 then return
    cell = m.cells[m.rowIndex][m.colIndex]
    prog = cell.prog
    now = nowEpoch()

    ' Only what is on right now can be tuned to; anything later opens its
    ' detail instead, because you cannot watch what has not aired.
    if prog.startEpoch > now or now >= prog.endEpoch
        showDetail(m.rows[m.rowIndex], prog)
        return
    end if

    m.pendingChannel = m.rows[m.rowIndex]
    m.apiTask.request = { action: "getChannelNowPlaying", channelId: m.rows[m.rowIndex].id }
end sub

sub showDetail(row as object, prog as object)
    m.detailRow = row
    m.detailProg = prog
    channel = UCase(row.name)
    if row.number <> invalid and row.number > 0 then channel = row.number.toStr() + "  " + channel
    m.top.findNode("detailChannel").text = channel
    updateDetailHint()
    m.top.findNode("detailTitle").text = prog.title
    timing = clockText(prog.startEpoch) + " - " + clockText(prog.endEpoch)
    if prog.subtitle <> "" then timing += "   " + prog.subtitle
    m.top.findNode("detailTiming").text = timing
    m.detailOverlay.visible = true
    m.detailUp = true
    updateFocus()
end sub

sub onTuneResolved(r as object)
    channel = m.pendingChannel
    m.pendingChannel = invalid
    if channel = invalid then return
    ' Went off air between the guide being drawn and the press. Reload so the
    ' grid tells the truth rather than appearing to do nothing.
    if r.offAir = true or r.nowPlaying = invalid
        load()
        return
    end if

    itemId = ""
    if r.nowPlaying.ItemId <> invalid then itemId = r.nowPlaying.ItemId
    if itemId = "" then return

    start = 0
    if r.nowPlaying.StartPositionSeconds <> invalid then start = Int(r.nowPlaying.StartPositionSeconds)
    m.pendingContext = {
        channelId: channel.id,
        channelName: channel.name,
        startPositionSeconds: start,
        nextItemId: ""
    }
    if r.nowPlaying.NextItemId <> invalid then m.pendingContext.nextItemId = r.nowPlaying.NextItemId
    m.apiTask.request = { action: "getItem", itemId: itemId, context: "guideTune" }
end sub

sub onTuneItemLoaded(r as object)
    context = m.pendingContext
    m.pendingContext = invalid
    if context = invalid then return
    if not r.success or r.item = invalid
        load()
        return
    end if
    m.top.playItem = { action: "play", item: r.item, channelContext: context }
end sub

' ---------- Helpers ----------

function offsetFor(epoch as integer) as integer
    return Int(((epoch - m.windowStart) / 60.0) * PX_PER_MIN)
end function

function nowEpoch() as integer
    return CreateObject("roDateTime").AsSeconds()
end function

function clockText(epoch as integer) as string
    dt = CreateObject("roDateTime")
    dt.FromSeconds(epoch)
    dt.ToLocalTime()
    return dt.AsTimeStringLoc("short")
end function

' "13:55" today; "Sat 18:00" any other day — a week of guide makes a bare
' time ambiguous.
function startText(epoch as integer) as string
    if localMidnight(epoch) = localMidnight(nowEpoch()) then return clockText(epoch)
    return weekdayShort(epoch) + " " + clockText(epoch)
end function

function fontOf(uri as string, size as integer) as object
    f = CreateObject("roSGNode", "Font")
    f.uri = uri
    f.size = size
    return f
end function

' Cycled by row so the palette reads as an index down the screen and
' neighbouring channels never share a colour. No purple: that is the accent the
' grid uses for what is on now.
function railColour(index as integer) as string
    palette = ["#4CC7CC", "#F2A640", "#ED5C7A", "#66CC80", "#5CADE6", "#E0C759"]
    return palette[index MOD palette.count()]
end function
