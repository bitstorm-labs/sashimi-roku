<?xml version="1.0" encoding="UTF-8" ?>
<component name="HomeScreen" extends="Group">
    <interface>
        <field id="selectedItem" type="assocarray" alwaysNotify="true" />
        <!-- Called by MainScene under memory pressure; no-op while on screen. -->
        <function name="releaseArtwork" />
    </interface>
    <children>
        <!-- Background (tvOS: vertical gradient background -> black) -->
        <Poster uri="pkg:/images/bg_gradient.png" width="1920" height="1080" />

        <!-- Logo + avatar now live in the pullout Sidebar -->

        <!-- Hero Banner (tvOS parity). Scale/anchor live in HeroBanner.bs
             (m.baseScale, top-left scaleRotateCenter): the 1820 banner is scaled
             to 0.98 so it fills the ~1784px content area right of the 136px rail
             exactly — left edge butts the rail, right edge hits the screen edge. -->
        <HeroBanner
            id="heroBanner"
            translation="[0, 0]"
            visible="false"
        />

        <!-- Dim-to-black scrim over the hero, behind the rows. Fades 0->1 as the
             rows scroll up so the hero dims to black (matches the tvOS ambient
             wallpaper) instead of collapsing to transparent. -->
        <Rectangle id="heroDim" width="1920" height="600" color="#000000" opacity="0" />

        <!-- Content rows. x=40 matches the hero text left margin; rows rest 40px
             under the full-scale hero (512) and slide up under it on scroll. -->
        <RowList
            id="rowList"
            translation="[40, 552]"
            itemSize="[1820, 450]"
            numRows="2"
            itemSpacing="[0, 30]"
            rowItemSize="[[220, 400]]"
            rowItemSpacing="[[40, 0]]"
            showRowLabel="[true]"
            showRowCounter="[false]"
            drawFocusFeedback="false"
            rowLabelFont="font:LargeBoldSystemFont"
            rowLabelColor="#FFFFFF"
            rowLabelOffset="[[0, 16]]"
            rowFocusAnimationStyle="fixedFocus"
            itemComponentName="HomeItem"
            visible="false"
        />

        <!-- Loading -->
        <Label
            id="loadingLabel"
            text="Loading your library..."
            font="font:MediumSystemFont"
            color="#8C8C8C"
            horizAlign="center"
            width="1920"
            translation="[0, 500]"
            visible="true"
        />

        <!-- Empty state -->
        <Label
            id="emptyLabel"
            text=""
            font="font:MediumSystemFont"
            color="#8C8C8C"
            horizAlign="center"
            width="1920"
            translation="[0, 500]"
            visible="false"
        />

        <Animation id="heroSlideAnim" duration="0.3" easeFunction="outQuad">
            <Vector2DFieldInterpolator id="rowsInterp" key="[0.0,1.0]" keyValue="[[40.0,552.0],[40.0,150.0]]" fieldToInterp="rowList.translation" />
            <FloatFieldInterpolator id="heroFadeInterp" key="[0.0,1.0]" keyValue="[0.0,1.0]" fieldToInterp="heroDim.opacity" />
        </Animation>

        <JellyfinApi id="apiTask" />
        <!-- Fires one tick after nil-ing the RowList content so recycled item
             components are actually discarded before the new content lands —
             otherwise a reload-on-return reuses a portrait cell for a landscape
             Continue Watching card (wrong width sticks). -->
        <Timer id="relayoutTimer" duration="0.05" repeat="false" />
    </children>
</component>
