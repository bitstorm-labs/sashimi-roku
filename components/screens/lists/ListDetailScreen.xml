<?xml version="1.0" encoding="UTF-8" ?>
<!-- Shared lists: one list's page, "Spotlight" (owner, 2026-11-10). The
     focused title fills the top with its backdrop, line and overview; the
     list's name and line sit above it; Play (or Resume), Shuffle, Subscribe
     and the owner's Edit List under it; the titles run in one row along the
     bottom with NEW marks for what was added since the viewer last looked. -->
<component name="ListDetailScreen" extends="Group">
    <interface>
        <field id="listId" type="string" onChange="onListId" />
        <field id="selectedItem" type="assocarray" alwaysNotify="true" />
        <field id="playItem" type="assocarray" alwaysNotify="true" />
        <!-- The list was deleted from here (or is gone): MainScene pops it. -->
        <field id="closed" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <ListSpotlight id="spot" />
        <DetailButtons id="buttons" translation="[120, 520]" />
        <Label id="modeLabel" text="" color="#FFFFFFFF" translation="[120, 600]" visible="false">
            <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="24" />
        </Label>
        <!-- One row: a one-row MarkupGrid is a horizontal strip, so the
             screen routes Up itself. -->
        <MarkupGrid
            id="grid"
            translation="[105, 640]"
            itemSize="[240, 380]"
            itemSpacing="[30, 0]"
            numColumns="6"
            numRows="1"
            drawFocusFeedback="false"
            itemComponentName="GridItem"
        />
        <Label id="statusLabel" text="Loading..." color="#888888FF" width="1680" translation="[120, 700]">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="28" />
        </Label>
        <JellyfinApi id="apiTask" />
    </children>
</component>
