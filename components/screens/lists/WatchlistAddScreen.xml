<?xml version="1.0" encoding="UTF-8" ?>
<!-- Watchlist v2: + Add. One search, two groups: "On your server" (library
     movies and shows) and "Not on server" (the server's metadata providers,
     so it works with no Requests sign-in). Each result has + Add (or
     "Added"); OK on its title opens its page. Keyboard on the left, results
     on the right, as on Search. -->
<component name="WatchlistAddScreen" extends="Group">
    <interface>
        <!-- A library item: MainScene opens its detail page. -->
        <field id="selectedItem" type="assocarray" alwaysNotify="true" />
        <!-- { _watchlistTitle: source }: the title page. -->
        <field id="openTitle" type="assocarray" alwaysNotify="true" />
        <field id="closed" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <Rectangle width="1920" height="1080" color="#18171FFF" />
        <Label text="Add to Watchlist" color="#FFFFFFFF" translation="[120, 56]">
            <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="48" />
        </Label>
        <Poster uri="pkg:/images/card_r16.9.png" width="560" height="78" translation="[120, 150]" />
        <Poster uri="pkg:/images/nav_search.png" width="34" height="34" translation="[144, 172]" />
        <Label id="queryLabel" text="Search movies and shows" color="#666666FF" width="460"
               height="78" vertAlign="center" translation="[194, 150]" maxLines="1">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="28" />
        </Label>
        <MiniKeyboard id="keyboard" translation="[120, 268]" keyColor="#FFFFFFFF"
                      focusedKeyColor="#121215FF" showTextEditBox="false" />
        <Label id="statusLabel" text="Find a movie or show, on your server or not." color="#888888FF"
               width="1040" wrap="true" translation="[760, 160]">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="26" />
        </Label>
        <Group id="results" translation="[760, 150]" />
        <Timer id="debounce" repeat="false" duration="0.35" />
        <!-- Results zone: real focus here, the highlight is drawn. -->
        <FocusSink id="keySink" />
        <!-- Searches on their own task, so an add never waits behind a slow
             TMDB call (and a search never behind an add). -->
        <JellyfinApi id="searchTask" />
        <JellyfinApi id="apiTask" />
    </children>
</component>
