import "pkg:/source/utils/ImageUrl.bs"
import "pkg:/source/utils/Confirm.bs"
import "pkg:/source/utils/Seerr.bs"
import "pkg:/source/utils/Watchlist.bs"
import "pkg:/source/utils/ListLayout.bs"

'' The Watchlist page ("Spotlight": ListSpotlight on top, the posters in one
' row along the bottom, the buttons between). One "watchlist" request draws
' it at once with every missing title saying "Not on server"; only then, and
' only with a Seerr session, does a status check upgrade some to
' "Requested", so a slow or failing Seerr never blanks the page or blocks OK.
'
' Zones top to bottom: "card" (virtual: a FocusSink holds real focus and
' m.cardIdx is drawn as the highlight), "buttons" (DetailButtons, which
' always has More, so even an empty Watchlist has something focused that
' answers Back and *), "grid" (the strip, which needs real focus to scroll).

sub init()
    m.spot = m.top.findNode("spot")
    m.card = m.top.findNode("card")
    m.top.findNode("cardTitle").text = Watchlist.CARD_TITLE()
    m.top.findNode("cardBody").text = Watchlist.CARD_BODY()
    m.cardButtons = m.top.findNode("cardButtons")
    m.buttons = m.top.findNode("buttons")
    m.grid = m.top.findNode("grid")
    m.keySink = m.top.findNode("keySink")
    m.statusLabel = m.top.findNode("statusLabel")
    m.apiTask = m.top.findNode("apiTask")
    m.apiTask.observeFieldScoped("response", "onApiResponse")
    m.apiTask.control = "RUN"
    m.seerrTask = m.top.findNode("seerrTask")
    m.seerrTask.observeFieldScoped("response", "onSeerrResponse")
    m.seerrTask.control = "RUN"
    m.buttons.observeFieldScoped("activatedKind", "onButton")
    m.buttons.observeFieldScoped("goDown", "onButtonsDown")
    m.buttons.observeFieldScoped("goUp", "onButtonsUp")
    m.grid.observeFieldScoped("itemSelected", "onGridSelected")
    m.grid.observeFieldScoped("itemFocused", "onGridFocused")
    m.top.observeField("focusedChild", "onFocusDelegate")

    m.queue = []
    m.inFlight = false
    m.view = invalid        ' Watchlist.fromResponse of the last good load
    m.entries = []
    m.items = {}            ' itemId -> the library item, for on-server tiles
    m.requested = {}        ' Seerr itemKey -> true
    m.statusBusy = false
    m.statusAgain = false
    m.cardHidden = false    ' "Not now" pressed on this visit
    m.cardIdx = 0           ' 0 Connect Plex, 1 Not now
    m.zone = ""             ' "" until the first load picks one
    m.spotIdx = 0           ' the title the Spotlight shows
    m.menu = invalid
    m.pending = invalid     ' the entry a Remove dialog is about
    m.canAdd = false        ' + Add: the plugin has search (0.3+)
    m.details = {}          ' entry id -> Watchlist.detailsFromResponse
    m.loadedVersion = -1
    load()
end sub

sub send(req as object)
    m.queue.push(req)
    pump()
end sub

sub pump()
    if m.inFlight or m.queue.count() = 0 then return
    m.inFlight = true
    m.apiTask.request = m.queue.shift()
end sub

sub load()
    m.loadedVersion = m.global.listsVersion
    send({ action: "lists", op: "watchlist" })
end sub

sub changed()
    m.global.listsVersion = m.global.listsVersion + 1
end sub

sub toast(text as string)
    m.global.toastMessage = { message: text }
end sub

sub onFocusDelegate()
    if not m.top.hasFocus() then return
    ' Back from a title, Connect Plex or a dialog: reload if anything changed.
    if m.view <> invalid and m.loadedVersion <> m.global.listsVersion then load()
    ' Back from signing into Requests: Sign in becomes Request, and the
    ' Requested pills can be asked for now.
    showSpotlight()
    checkRequested()
    focusZone(m.zone)
end sub

sub focusZone(zone as string)
    ' Before the first answer: hold focus and choose once the titles arrive.
    if m.view = invalid
        m.keySink.setFocus(true)
        return
    end if
    if zone = "" then zone = ListLayout.firstZone(cardShown(), m.entries.count())
    if zone = "strip" then zone = "grid"
    if zone = "card" and not cardShown() then zone = "buttons"
    if zone = "grid" and m.entries.count() = 0 then zone = "buttons"
    m.zone = zone
    if zone = "grid"
        m.grid.setFocus(true)
    else if zone = "buttons"
        m.buttons.setFocus(true)
    else
        m.keySink.setFocus(true)
    end if
    drawCardButtons()
end sub

function cardShown() as boolean
    return m.view <> invalid and Watchlist.showCard(m.view) and not m.cardHidden
end function

' ---------- Responses ----------

sub onApiResponse()
    r = m.apiTask.response
    if r = invalid then return
    m.inFlight = false
    if r.action = "lists"
        if r.op = "watchlist"
            onWatchlist(r)
        else if r.op = "watchlistDismiss"
            if r.success = true
                m.view.cardDismissed = true
            else
                toast("Couldn't save that. Check your connection.")
            end if
        else if r.op = "watchlistRemove" or r.op = "watchlistUnlink"
            if r.success = true then changed() else toast("Couldn't update. Check your connection.")
            load()
        else if r.op = "watchlistDetails" and r.key <> invalid
            ' Kept even when it failed, so a broken title isn't asked again
            ' on every focus.
            m.details[r.key] = r
            e = spotEntry()
            if e <> invalid and e.id = r.key then showSpotlight()
        end if
    else if r.action = "seriesNextEpisode"
        if r.success and r.items <> invalid and r.items.count() > 0
            m.top.playItem = { item: r.items[0], action: ListLayout.titleAction({ item: r.items[0] }).kind }
        else
            toast("This show has no episodes to play yet.")
        end if
    end if
    pump()
end sub

sub onWatchlist(r as object)
    if r.available <> true and r.failed <> true
        toast("This server doesn't have the Watchlist.")
        m.top.closed = true
        return
    end if
    if r.failed = true
        if m.view = invalid
            m.statusLabel.text = "Couldn't load your Watchlist. Check your connection."
            m.statusLabel.visible = true
        else
            toast("Couldn't load your Watchlist. Check your connection.")
        end if
        return
    end if
    m.view = r.view
    m.entries = r.view.entries
    m.items = r.items
    if m.items = invalid then m.items = {}
    m.canAdd = (r.canAdd = true)
    render()
    checkRequested()
end sub

' The "Requested" pills, after the page is already up. One check at a time
' (task fields coalesce); a reload meanwhile asks again once it answers.
sub checkRequested()
    if not Seerr.isActive(m.global.seerrState) then return
    targets = Watchlist.statusTargets(m.entries)
    if targets.count() = 0 then return
    if m.statusBusy
        m.statusAgain = true
        return
    end if
    m.statusBusy = true
    m.seerrTask.request = { action: "watchlistStatus", items: targets }
end sub

sub onSeerrResponse()
    r = m.seerrTask.response
    if r = invalid or r.action <> "watchlistStatus" then return
    m.statusBusy = false
    if r.success = true and r.requested <> invalid
        keys = {}
        for each k in r.requested
            keys[k] = true
        end for
        m.requested = keys
        drawGrid()
    end if
    if m.statusAgain
        m.statusAgain = false
        checkRequested()
    end if
end sub

' ---------- Drawing ----------

sub render()
    if m.view = invalid then return
    shown = cardShown()
    m.card.visible = shown
    m.statusLabel.text = Watchlist.emptyText(m.canAdd)
    m.statusLabel.visible = (m.entries.count() = 0)
    drawGrid()
    if m.top.isInFocusChain() then focusZone(m.zone)
    drawCardButtons()
end sub

sub drawGrid()
    focusedAt = m.grid.itemFocused
    content = CreateObject("roSGNode", "ContentNode")
    for each e in m.entries
        t = Watchlist.tile(e, m.requested.DoesExist(Watchlist.seerrKey(e)))
        c = content.createChild("ContentNode")
        c.title = t.title
        ' GridItem reads the caption from shortDescriptionLine1 first.
        c.shortDescriptionLine1 = t.title
        c.HDPosterUrl = posterFor(e)
        pillColor = ""
        if t.pill = "Requested" then pillColor = Seerr.toneColor("pending")
        if t.pill = "Not on server" then pillColor = "#5A5A66FF"
        c.addFields({ dimmed: t.dimmed, pillText: t.pill, pillColor: pillColor })
    end for
    m.grid.content = content
    m.spotIdx = 0
    if focusedAt <> invalid and focusedAt >= 0 and content.getChildCount() > 0
        if focusedAt >= content.getChildCount() then focusedAt = content.getChildCount() - 1
        m.grid.jumpToItem = focusedAt
        m.spotIdx = focusedAt
    end if
    showSpotlight()
end sub

sub onGridFocused()
    idx = m.grid.itemFocused
    if idx = invalid or idx < 0 or idx >= m.entries.count() or idx = m.spotIdx then return
    m.spotIdx = idx
    showSpotlight()
end sub

function spotEntry() as dynamic
    if m.spotIdx < 0 or m.spotIdx >= m.entries.count() then return invalid
    return m.entries[m.spotIdx]
end function

' The library item of an on-server entry, or what the entry knows when the
' lookup didn't return it (a title the viewer's limits hide, say).
function entryItem(e as object) as object
    item = m.items[e.itemId]
    if item = invalid then item = { Id: e.itemId, Type: e.type, Name: e.title }
    return item
end function

' What the focused title's button does.
function spotAction(e as dynamic) as object
    if e = invalid then return { kind: "none", label: "" }
    if e.itemId <> "" then return ListLayout.titleAction({ item: entryItem(e) })
    return ListLayout.titleAction({ entry: e, seerrActive: Seerr.isActive(m.global.seerrState), requested: m.requested.DoesExist(Watchlist.seerrKey(e)) })
end function

' The Spotlight and the buttons follow the focused title.
sub showSpotlight()
    if m.view = invalid then return
    info = { headline: ListLayout.headline(Watchlist.NAME(), Watchlist.metaLine(m.entries.count(), m.view)), title: "", meta: "", note: "", overview: "", backdropUri: "", posterUri: "" }
    e = spotEntry()
    if e <> invalid
        info.title = e.title
        info.posterUri = posterFor(e)
        if e.itemId <> ""
            item = entryItem(e)
            info.meta = ListLayout.metaLine(item)
            if info.meta = "" then info.meta = ListLayout.missingMeta(e)
            if item.Overview <> invalid then info.overview = item.Overview
            b = ListLayout.backdrop(item)
            if b <> invalid then info.backdropUri = ImageUrl.backdrop(b.id, 1280, b.tag)
        else
            info.meta = ListLayout.missingMeta(e)
            info.note = "Not on your server"
            if m.requested.DoesExist(Watchlist.seerrKey(e)) then info.note = "Requested"
            ' Plugin 0.3+ knows the rest (backdrop, line, overview): asked
            ' once per title, drawn when it answers.
            d = m.details[e.id]
            if d = invalid and m.canAdd
                m.details[e.id] = { pending: true }
                send({ action: "lists", op: "watchlistDetails", query: Watchlist.detailsQuery(e), key: e.id })
            else if d <> invalid and d.found = true
                line = Watchlist.detailsMeta(d)
                if line <> "" then info.meta = line
                info.overview = d.overview
                info.backdropUri = d.backdropUrl
            end if
        end if
    end if
    m.spot.info = info
    setButtons(ListLayout.watchlistButtons(spotAction(e), hasPlayable(), m.canAdd))
end sub

function hasPlayable() as boolean
    for each e in m.entries
        if e.itemId <> "" then return true
    end for
    return false
end function

' New defs keep the highlighted button where its kind still is.
sub setButtons(defs as object)
    keep = m.buttons.activatedKind
    old = m.buttons.buttonDefs
    if old <> invalid and FormatJson(old) = FormatJson(defs) then return
    m.buttons.buttonDefs = defs
    for i = 0 to defs.count() - 1
        if defs[i].kind = keep
            m.buttons.setIndex = -1
            m.buttons.setIndex = i
        end if
    end for
end sub

sub onButtonsDown()
    focusZone(ListLayout.downFrom("buttons", m.entries.count()))
end sub

sub onButtonsUp()
    if cardShown()
        m.cardIdx = 0
        focusZone(ListLayout.upFrom("buttons", true))
    end if
end sub

sub onButton(event as object)
    kind = event.getData()
    e = spotEntry()
    if kind = "options"
        showOptions()
    else if kind = "shuffle"
        shuffle()
    else if kind = "add"
        m.top.addTitles = true
    else if e = invalid
        return
    else if kind = "play" or kind = "resume"
        m.top.playItem = { item: entryItem(e), action: kind }
    else if kind = "playSeries"
        send({ action: "seriesNextEpisode", seriesId: e.itemId })
    else if kind = "request" or kind = "requested"
        target = Watchlist.seerrTarget(e)
        if target <> invalid then m.top.selectedItem = { _seerr: target }
    else if kind = "signin"
        m.top.openSeerr = true
    end if
end sub

' A random title the server has: a show starts its next episode.
sub shuffle()
    onServer = []
    for each e in m.entries
        if e.itemId <> "" then onServer.push(e)
    end for
    if onServer.count() = 0 then return
    e = onServer[Rnd(onServer.count()) - 1]
    if e.type = "Series"
        send({ action: "seriesNextEpisode", seriesId: e.itemId })
    else
        m.top.playItem = { item: entryItem(e), action: "play" }
    end if
end sub

function posterFor(e as object) as string
    if e.itemId <> ""
        item = m.items[e.itemId]
        if item <> invalid then return ImageUrl.primary(e.itemId, 210, ImageUrl.primaryTag(item))
        return ImageUrl.primary(e.itemId, 210, "")
    end if
    return e.posterUrl
end function

' The card's two capsules, highlighted only while the card zone has focus.
sub drawCardButtons()
    while m.cardButtons.getChildCount() > 0
        m.cardButtons.removeChildIndex(0)
    end while
    labels = [Watchlist.CONNECT_LABEL(), Watchlist.NOT_NOW_LABEL()]
    x = 0
    for i = 0 to 1
        isOn = m.zone = "card" and m.cardIdx = i and m.top.isInFocusChain()
        w = 190
        if i = 1 then w = 150
        bg = CreateObject("roSGNode", "Poster")
        bg.translation = [x, 0]
        bg.width = w
        bg.height = 60
        if isOn then bg.uri = "pkg:/images/btn_white_focus.9.png" else bg.uri = "pkg:/images/btn_dark.9.png"
        m.cardButtons.appendChild(bg)
        lbl = CreateObject("roSGNode", "Label")
        lbl.text = labels[i]
        lbl.translation = [x, 0]
        lbl.width = w
        lbl.height = 60
        lbl.horizAlign = "center"
        lbl.vertAlign = "center"
        f = CreateObject("roSGNode", "Font")
        f.uri = "pkg:/fonts/Inter-Bold.ttf"
        f.size = 24
        lbl.font = f
        if isOn then lbl.color = "#000000FF" else lbl.color = "#FFFFFFFF"
        m.cardButtons.appendChild(lbl)
        x = x + w + 20
    end for
end sub

' ---------- The card ----------

sub activateCard()
    if m.cardIdx = 0
        m.top.connectPlex = true
        return
    end if
    ' Not now: gone at once; the plugin remembers it for every device.
    m.cardHidden = true
    send({ action: "lists", op: "watchlistDismiss" })
    render()
end sub

' ---------- Tiles ----------

sub onGridSelected()
    idx = m.grid.itemSelected
    if idx < 0 or idx >= m.entries.count() then return
    e = m.entries[idx]
    pick = Watchlist.onSelect(e, Seerr.isActive(m.global.seerrState))
    if pick.kind = "item"
        m.top.selectedItem = entryItem(e)
    else
        ' A title the server doesn't have: its title page (Watchlist v2).
        m.top.selectedItem = { _watchlistTitle: Watchlist.entrySource(e) }
    end if
end sub

' The title More's Remove is about: the one the Spotlight shows.
function focusedEntry() as dynamic
    if m.zone <> "grid" and m.zone <> "buttons" then return invalid
    return spotEntry()
end function

' ---------- The * menu ----------

sub showOptions()
    if m.view = invalid then return
    m.pending = focusedEntry()
    m.menu = Watchlist.optionsMenu(m.view, m.pending <> invalid)
    dialog = CreateObject("roSGNode", "StandardMessageDialog")
    dialog.title = Watchlist.NAME()
    labels = []
    for each it in m.menu
        labels.push(it.label)
    end for
    labels.push("Cancel")
    dialog.buttons = labels
    dialog.observeFieldScoped("buttonSelected", "onOptionsButton")
    m.top.getScene().dialog = dialog
end sub

function menuPick() as string
    dialog = m.top.getScene().dialog
    if dialog = invalid then return ""
    idx = dialog.buttonSelected
    dialog.close = true
    items = m.menu
    m.menu = invalid
    if items = invalid or idx = invalid or idx < 0 or idx >= items.count() then return ""
    return items[idx].kind
end function

sub onOptionsButton()
    kind = menuPick()
    focusZone(m.zone)
    if kind = "remove" and m.pending <> invalid
        dialog = CreateObject("roSGNode", "StandardMessageDialog")
        ' The title goes in the message: a dialog title is one line and cut a
        ' long name off mid-word on device.
        dialog.title = "Remove from Watchlist?"
        dialog.message = [Chr(8220) + m.pending.title + Chr(8221)]
        dialog.buttons = Confirm.buttons("Remove")
        dialog.observeFieldScoped("buttonSelected", "onRemoveButton")
        m.top.getScene().dialog = dialog
    else if kind = "connect" or kind = "reconnect"
        m.top.connectPlex = true
    else if kind = "disconnect"
        dialog = CreateObject("roSGNode", "StandardMessageDialog")
        dialog.title = "Disconnect Plex?"
        dialog.message = ["Your Watchlist stays as it is and stops syncing with Plex."]
        dialog.buttons = Confirm.buttons("Disconnect")
        dialog.observeFieldScoped("buttonSelected", "onDisconnectButton")
        m.top.getScene().dialog = dialog
    end if
end sub

sub onRemoveButton()
    dialog = m.top.getScene().dialog
    if dialog = invalid then return
    confirmed = Confirm.isConfirmed(dialog.buttonSelected)
    dialog.close = true
    focusZone(m.zone)
    e = m.pending
    m.pending = invalid
    if confirmed and e <> invalid then send({ action: "lists", op: "watchlistRemove", entryId: e.id })
end sub

sub onDisconnectButton()
    dialog = m.top.getScene().dialog
    if dialog = invalid then return
    confirmed = Confirm.isConfirmed(dialog.buttonSelected)
    dialog.close = true
    focusZone(m.zone)
    if confirmed then send({ action: "lists", op: "watchlistUnlink" })
end sub

' ---------- Keys ----------

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = "back"
        m.top.closed = true
        return true
    end if
    if key = "options"
        showOptions()
        return true
    end if
    if m.zone = "grid"
        ' The strip is one row, which ignores Up: the screen moves focus.
        if key = "up"
            focusZone(ListLayout.upFrom("strip", cardShown()))
            return true
        end if
        return false
    end if
    if m.zone = "card"
        if key = "left" or key = "right"
            if key = "left" then m.cardIdx = 0 else m.cardIdx = 1
            drawCardButtons()
            return true
        else if key = "OK"
            activateCard()
            return true
        else if key = "down"
            focusZone(ListLayout.downFrom("card", m.entries.count()))
            return true
        end if
    end if
    ' The card's other keys: the screen keeps focus.
    return true
end function
