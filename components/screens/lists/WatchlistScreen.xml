<?xml version="1.0" encoding="UTF-8" ?>
<!-- The Watchlist page (Sashimi Lists plugin 0.2+), "Spotlight" like every
     list's page: the focused title's backdrop, line and overview on top,
     its button (Play / Request / Sign in to Requests), Shuffle and More
     under it, the titles in one row along the bottom -- the ones the server
     doesn't have dimmed with a "Not on server" / "Requested" pill -- and the
     "Use Plex too?" card top right until it is answered. More (or *) has
     Remove and Connect / Reconnect / Disconnect Plex. -->
<component name="WatchlistScreen" extends="Group">
    <interface>
        <!-- A Jellyfin item, { _seerr: target } (Request), or
             { _watchlistTitle: source } for a title not on the server. -->
        <field id="selectedItem" type="assocarray" alwaysNotify="true" />
        <field id="playItem" type="assocarray" alwaysNotify="true" />
        <!-- Connect (or reconnect) Plex: MainScene pushes the code screen. -->
        <field id="connectPlex" type="boolean" alwaysNotify="true" />
        <!-- + Add: MainScene pushes the search (WatchlistAddScreen). -->
        <field id="addTitles" type="boolean" alwaysNotify="true" />
        <!-- Sign in to Requests: MainScene pushes the Requests sign-in. -->
        <field id="openSeerr" type="boolean" alwaysNotify="true" />
        <!-- Back, or no Watchlist on this server: MainScene pops it. -->
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- The side menu's width when this is the menu's Watchlist
             destination (a root screen, drawn at x 0 under the menu) rather
             than a page pushed from Lists: the left column moves clear of the
             menu, Back and Left go to MainScene (Home / the menu) instead of
             closing the page, and a server without the Watchlist says so
             instead of closing it. -->
        <field id="besideRail" type="integer" value="0" onChange="onBesideRail" />
    </interface>
    <children>
        <ListSpotlight id="spot" />
        <Group id="card" translation="[1080, 56]" visible="false">
            <Poster uri="pkg:/images/pill_white.9.png" width="740" height="224" blendColor="#1D2A3AF2" />
            <Label id="cardTitle" text="" color="#FFFFFFFF" translation="[32, 22]">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="30" />
            </Label>
            <Label id="cardBody" text="" color="#C9C7D1FF" width="680" wrap="true" maxLines="2" translation="[32, 62]">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="24" />
            </Label>
            <Group id="cardButtons" translation="[32, 146]" />
        </Group>
        <DetailButtons id="buttons" translation="[120, 520]" />
        <!-- One row: a one-row MarkupGrid is a horizontal strip, so the
             screen routes Up itself. -->
        <MarkupGrid
            id="grid"
            translation="[105, 640]"
            itemSize="[240, 380]"
            itemSpacing="[30, 0]"
            numColumns="6"
            numRows="1"
            drawFocusFeedback="false"
            itemComponentName="GridItem"
        />
        <Label id="statusLabel" text="Loading..." color="#888888FF" width="1680" translation="[120, 700]">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="28" />
        </Label>
        <!-- Real focus for the card (virtual highlight), so this screen's
             onKeyEvent gets the keys. -->
        <FocusSink id="keySink" />
        <JellyfinApi id="apiTask" />
        <SeerrTask id="seerrTask" />
    </children>
</component>
