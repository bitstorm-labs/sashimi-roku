<?xml version="1.0" encoding="UTF-8" ?>
<!-- Watchlist v2: the title page for a title the server doesn't have (a
     "Not on server" Watchlist tile or search result). Backdrop, poster,
     title, year, runtime or seasons, community rating, age rating and genres
     and overview from the server's metadata providers ("Details from TMDB"),
     then Add to Watchlist / On Watchlist and Request / Requested / Sign in to
     Requests. Once the library has the title, the normal detail page takes
     over, so this page uses a movie detail page's grid and fonts
     (MediaDetailScreen's layoutHeader / reflowMovieHeader): the Spotlight
     backdrop, the text column on its dark left side, the buttons and the
     overview under it. With no rows to make room for, the overview may run
     on down the screen. -->
<component name="WatchlistTitleScreen" extends="Group">
    <interface>
        <!-- Watchlist.entrySource / hitSource: drawn at once, filled in by
             /SashimiLists/Watchlist/Details. -->
        <field id="source" type="assocarray" onChange="onSource" />
        <!-- { _seerr: target }: MainScene pushes Seerr's page (Request). -->
        <field id="selectedItem" type="assocarray" alwaysNotify="true" />
        <!-- The server has it after all: MainScene swaps in its detail page. -->
        <field id="openLibraryItem" type="assocarray" alwaysNotify="true" />
        <field id="openSeerr" type="boolean" alwaysNotify="true" />
        <field id="closed" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <Rectangle width="1920" height="1080" color="#18171FFF" />

        <!-- Every detail page's backdrop: the Spotlight list page's coverage
             and fades (owner, 2026-11-11). -->
        <SpotlightBackdrop id="backdrop" />

        <!-- Only when there is no backdrop (a title the providers have no art
             for but a poster): drawn on the right, as the Spotlight list page
             does, never beside the title. A masked fill must stay below
             opacity 1 (CLAUDE.md). -->
        <MaskGroup id="posterMask" maskUri="pkg:/images/poster_mask_r12.png"
                   maskSize="[260, 390]" translation="[1560, 120]" visible="false">
            <Rectangle width="260" height="390" color="#2A2833FF" opacity="0.99" />
            <Poster id="poster" width="260" height="390" loadWidth="400" loadHeight="600"
                    loadDisplayMode="scaleToZoom" />
        </MaskGroup>

        <Label id="titleLabel" text="" color="#FFFFFF" width="1000" maxLines="2" wrap="true" translation="[60, 84]">
            <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="52" />
        </Label>
        <Label id="metaLabel" text="" color="#BFBFBF" width="1000" maxLines="1" translation="[60, 172]">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="22" />
        </Label>
        <Group id="ratingsGroup" translation="[60, 224]">
            <Poster uri="pkg:/images/tmdb_logo_tv.png" width="34" height="24" loadDisplayMode="scaleToFit" />
            <Label id="scoreLabel" text="" color="#FFFFFF" height="24" vertAlign="center" translation="[44, 0]">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="20" />
            </Label>
        </Group>
        <Group id="tagsGroup" translation="[60, 274]" />
        <Label id="noteLabel" text="" color="#F2B84BFF" width="1000" maxLines="1" translation="[60, 324]">
            <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="22" />
        </Label>

        <DetailButtons id="buttons" translation="[60, 466]" />

        <Label id="overviewLabel" text="" color="#BFBFBF" width="1000" maxLines="8"
               wrap="true" translation="[60, 562]">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="24" />
        </Label>
        <Label id="sourceLabel" text="" color="#8C8A96FF" translation="[60, 690]">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="22" />
        </Label>

        <JellyfinApi id="apiTask" />
        <SeerrTask id="seerrTask" />
    </children>
</component>
