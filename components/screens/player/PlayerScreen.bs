import "pkg:/source/utils/AppSettings.bs"
import "pkg:/source/utils/YouTube.bs"
import "pkg:/source/utils/ImageUrl.bs"
import "pkg:/source/utils/TimeFormat.bs"

' tvOS PlayerViewModel parity on Roku. Design rules learned the hard way:
'  - The screen NEVER gives remote focus to a child node. Every key lands in
'    onKeyEvent and a virtual highlight (m.zone/m.btnIdx/m.menuIdx) drives all
'    styling. Real focus moves caused invisible-button traps twice.
'  - Subtitles are BURNED IN server-side (SubtitleStreamIndex + Encode
'    profile): Roku's native HLS-VTT rendering silently fails, burn-in works
'    for every format (srt/ass/pgs) and QSV makes the re-encode cheap.
'  - Track/quality changes restart the stream at the current position.

sub init()
    m.video = m.top.findNode("video")
    m.statusLabel = m.top.findNode("statusLabel")
    m.apiTask = m.top.findNode("apiTask")
    m.progressTimer = m.top.findNode("progressTimer")

    ' OSD nodes
    m.osd = m.top.findNode("osd")
    m.osdTitle = m.top.findNode("osdTitle")
    m.osdSubtitle = m.top.findNode("osdSubtitle")
    m.osdClock = m.top.findNode("osdClock")
    m.osdFinishes = m.top.findNode("osdFinishes")
    m.osdChips = m.top.findNode("osdChips")
    m.skipPill = m.top.findNode("skipPill")
    m.skipPillLabel = m.top.findNode("skipPillLabel")
    m.osdLogo = m.top.findNode("osdLogo")
    m.osdChannelCircle = m.top.findNode("osdChannelCircle")
    m.osdChannelName = m.top.findNode("osdChannelName")
    m.osdBtnRow = m.top.findNode("osdBtnRow")
    m.osdPlayPause = m.top.findNode("osdPlayPause")
    m.osdScrubFill = m.top.findNode("osdScrubFill")
    m.osdScrubKnob = m.top.findNode("osdScrubKnob")
    m.osdChapterTicks = m.top.findNode("osdChapterTicks")
    m.osdElapsed = m.top.findNode("osdElapsed")
    m.osdRemaining = m.top.findNode("osdRemaining")
    m.osdTimer = m.top.findNode("osdTimer")
    m.clockTimer = m.top.findNode("clockTimer")
    m.seekTimer = m.top.findNode("seekTimer")
    m.osdAnim = m.top.findNode("osdAnim")
    m.osdInterp = m.top.findNode("osdInterp")

    ' Popup menu nodes
    m.osdMenu = m.top.findNode("osdMenu")
    m.osdMenuBg = m.top.findNode("osdMenuBg")
    m.osdMenuTitle = m.top.findNode("osdMenuTitle")
    m.osdMenuRows = m.top.findNode("osdMenuRows")

    m.apiTask.observeFieldScoped("response", "onApiResponse")
    m.apiTask.control = "RUN"
    m.video.observeFieldScoped("state", "onVideoState")
    m.video.observeFieldScoped("position", "onPosition")
    m.video.observeFieldScoped("duration", "onDuration")
    m.progressTimer.observeFieldScoped("fire", "onProgressTimer")
    m.osdTimer.observeFieldScoped("fire", "onOsdTimer")
    m.clockTimer.observeFieldScoped("fire", "onClockTimer")
    m.seekTimer.observeFieldScoped("fire", "onSeekTimer")
    m.captionTimer = m.top.findNode("captionTimer")
    m.captionTimer.observeFieldScoped("fire", "onCaptionTimer")
    m.bufferTimer = m.top.findNode("bufferTimer")
    m.tpGroup = m.top.findNode("trickplayGroup")
    m.tpBorder = m.top.findNode("trickplayBorder")
    m.tpImage = m.top.findNode("trickplayImage")
    m.tpTime = m.top.findNode("trickplayTime")
    m.tp = invalid       ' trick-play geometry for the current item (cert 4.7)
    m.tpSheet = -1       ' sheet already loaded, so scrubbing doesn't refetch it
    m.tpDeferred = invalid ' metadata held back until a real duration is known
    ' Live pressure reading for the sheet cache (see memoryPressureHigh). A
    ' small-budget device gets less rope: it is the one that dies first, and a
    ' 1920x1080 decode is a big fraction of what it has left.
    m.appMem = CreateObject("roAppMemoryMonitor")
    m.tpPressurePct = 90
    if m.global.memoryTier = "low" then m.tpPressurePct = 80
    m.bufferTimer.observeFieldScoped("fire", "onBufferTimer")
    ' Cert 4.8: honour the Roku-level caption setting. Subtitles here are burned
    ' in server-side, so there is no native caption track for Roku to toggle --
    ' the app has to translate the global setting into a track choice itself.
    m.deviceInfo = CreateObject("roDeviceInfo")
    m.lastCaptionsMode = captionsMode()
    m.captionTimer.control = "start"

    ' Playback state
    m.item = invalid
    m.playSessionId = ""
    m.playMethod = "DirectStream"
    m.runTimeTicks = 0
    m.durationSecs = 0
    m.startedReported = false
    m.stoppedReported = false
    m.lastPosition = 0
    m.isPaused = false
    m.subtitleBase = ""
    m.siblingsRetried = false ' one retry per autoplay handoff (reset in onPlaybackEnded)

    ' OSD virtual-highlight state
    m.osdVisible = false
    m.zone = "scrub"          ' scrub | buttons | menu
    m.buttons = []            ' [{kind, bg, lbl}]
    m.btnIdx = 0
    m.menuKind = ""
    m.menuItems = []          ' [{label, value}]
    m.menuIdx = 0
    m.menuScroll = 0          ' first visible row (scrolling window)
    m.menuMaxRows = 8
    m.menuRowNodes = []

    ' Track / quality selection (applied via stream restart)
    m.subTracks = []          ' [{index, title}] from PlaybackInfo
    m.audTracks = []
    m.curSubIdx = -1          ' -1 = off
    m.subPrefApplied = false  ' once-per-file guard for subtitle re-match
    m.curAudIdx = -1          ' -1 = server default
    m.qualityBps = 0          ' 0 = auto (settings)
    ' Adaptive step-down: when a stream stalls/errors mid-playback (weak remote
    ' downstream), retry from the same spot at a lower bitrate cap before giving
    ' up. Roku hard-errors on underruns where AVPlayer would just rebuffer.
    m.stepDownTiers = [12000000, 8000000, 5000000, 3000000]
    m.stepDownIdx = -1
    m.stepDownBps = 0         ' active step-down cap (0 = none)
    m.pendingStartSecs = -1

    m.chapters = []           ' [{name, startSec}] from item Chapters
    m.chapterTicksBuilt = false

    ' Intro Skipper segments
    m.segments = []
    m.curSegment = invalid
    m.skipVisible = false
    m.forceTranscode = false
    ' Auto-skip guard: each segment is auto-skipped at most once per playback
    ' (keyed by segType+startSec) so a user who seeks back into it isn't yanked
    ' forward again — the manual pill still lets them re-skip.
    m.skippedSegments = {}

    ' Seek acceleration
    m.seekSpan = CreateObject("roTimespan")
    m.seekStep = 10
    m.seekDir = 0
    m.seeking = false
    m.seekTarget = 0

    ' Serialized API requests (task field coalesces back-to-back sets)
    m.reqQueue = []
    m.reqBusy = false

    ' One terminal-error modal at a time: the stall watchdog and the video's
    ' own error state can both fire for the same failure.
    m.errorDialogUp = false
end sub

' ---------- Request queue ----------

sub enqueue(req as object)
    m.reqQueue.push(req)
    pumpQueue()
end sub

sub pumpQueue()
    if m.reqBusy then return
    if m.reqQueue.count() = 0 then return
    m.reqBusy = true
    m.apiTask.request = m.reqQueue.shift()
end sub

' ---------- Stream lifecycle ----------

sub onItemDataChanged()
    data = m.top.itemData
    if data = invalid then return
    m.item = data
    m.statusLabel.visible = true
    m.statusLabel.text = "Loading..."
    m.startedReported = false
    m.stoppedReported = false
    ' Per-item, like the flags above: a stale lastPosition from the previous item
    ' would be reported as this one's stop position.
    m.lastPosition = 0
    m.stepDownIdx = -1        ' fresh item starts at full quality
    m.stepDownBps = 0
    setChapters(data)
    populateInfoBar()
    requestStream(data)
end sub

' Chapters are per-item, so this rebuilds from scratch every time the playing
' item changes (initial load AND auto-advance). The already-rendered tick nodes
' have to be dropped too — buildChapterTicks only appends, so leaving them
' would stack the next episode's marks on top of the previous episode's.
sub setChapters(item as object)
    m.chapters = []
    m.chapterTicksBuilt = false
    while m.osdChapterTicks.getChildCount() > 0
        m.osdChapterTicks.removeChildIndex(0)
    end while
    if item = invalid or item.Chapters = invalid or item.Chapters.count() <= 1 then return
    for i = 0 to item.Chapters.count() - 1
        ch = item.Chapters[i]
        if ch.StartPositionTicks <> invalid
            nm = ""
            if ch.Name <> invalid then nm = ch.Name
            if nm = "" then nm = "Chapter " + str(i + 1).Trim()
            m.chapters.push({ name: nm, startSec: Int(ch.StartPositionTicks / 10000000&) })
        end if
    end for
end sub

sub requestStream(item as object)
    req = { action: "getPlaybackStream", itemId: item.Id }
    if m.forceTranscode then req.forceTranscode = true
    ' Force Direct Play: ask the server for a direct-play/direct-stream source
    ' and never proactively transcode. The adaptive fallbacks (HLS retry /
    ' bitrate step-down) are also disabled while this is on (see onVideoState).
    if AppSettings.forceDirectPlay() then req.forceDirectPlay = true
    req.subtitleStreamIndex = m.curSubIdx
    if m.curAudIdx >= 0 then req.audioStreamIndex = m.curAudIdx
    cap = 0
    if m.qualityBps > 0
        cap = m.qualityBps
    else
        mb = AppSettings.maxBitrateMbps()
        if mb > 0 then cap = mb * 1000000
    end if
    ' A pending step-down caps below the user/settings choice
    if m.stepDownBps > 0 and (cap = 0 or m.stepDownBps < cap) then cap = m.stepDownBps
    if cap > 0 then req.maxBitrate = cap
    ' Step-down needs a real transcode to actually lower the delivered bitrate
    if m.stepDownBps > 0 then req.forceTranscode = true
    enqueue(req)
    armStallWatchdog()
end sub

' Cert 3.4: every path that parks the viewer on a status label — negotiating a
' stream, buffering, a step-down retry — has to end in something actionable.
' One-shot timer, so re-arm on each new wait; onBufferTimer re-checks the video
' state before it concludes anything is actually wrong.
sub armStallWatchdog()
    m.bufferTimer.control = "stop"
    m.bufferTimer.control = "start"
end sub

sub onBufferTimer()
    ' Playing or paused means the stream did arrive — a stale arm, not a stall.
    ' m.isPaused covers a pause taken while the first buffer was still filling,
    ' where the node can sit in "buffering" by the viewer's own choice.
    state = m.video.state
    if state = "playing" or state = "paused" or m.isPaused then return
    showPlaybackError("Playback stalled", "The video stopped loading. This is usually a slow or interrupted connection to the server.")
end sub

' Terminal failures used to be a bare full-screen string with no explanation and
' no way forward — the viewer had to guess that Back was the escape.
sub showPlaybackError(title as string, message as string)
    if m.errorDialogUp then return
    m.errorDialogUp = true
    m.bufferTimer.control = "stop"
    m.progressTimer.control = "stop"
    hideOsd()
    dialog = createObject("roSGNode", "StandardMessageDialog")
    dialog.title = title
    dialog.message = [message]
    dialog.buttons = ["Try Again", "Back"]
    dialog.observeFieldScoped("buttonSelected", "onPlaybackErrorButton")
    m.top.getScene().dialog = dialog
end sub

sub onPlaybackErrorButton()
    dialog = m.top.getScene().dialog
    if dialog = invalid then return
    idx = dialog.buttonSelected
    dialog.close = true
    m.errorDialogUp = false
    ' The dialog took real remote focus away from the screen. This screen owns
    ' ALL key handling (virtual highlight), so without taking it back every key
    ' after the dialog closes is dead.
    m.top.setFocus(true)
    if idx = 0
        retryPlayback()
    else
        exitPlayer()
    end if
end sub

' Retry from the furthest known position so a failure two thirds into an
' episode doesn't restart it from the beginning.
sub retryPlayback()
    if m.item = invalid
        exitPlayer()
        return
    end if
    m.video.control = "stop"
    if m.startedReported
        m.pendingStartSecs = Int(m.lastPosition)
    else if m.top.playAction <> "play"
        m.pendingStartSecs = resumeSeconds()
    else
        m.pendingStartSecs = 0
    end if
    m.statusLabel.visible = true
    m.statusLabel.text = "Loading..."
    requestStream(m.item)
end sub

sub exitPlayer()
    m.bufferTimer.control = "stop"
    m.progressTimer.control = "stop"
    m.video.control = "stop"
    ' Report a stop ONLY if a start was reported. currentTicks() reads
    ' m.video.position, which is 0 until the stream actually begins, so Back
    ' during "Loading..." used to POST PositionTicks 0 to
    ' /Sessions/Playing/Stopped and reset the Jellyfin bookmark to zero — a
    ' viewer resuming at 32:00 who backed out mid-negotiation lost their place.
    ' Nothing opened a session on that path either (reportStart is sent from the
    ' "playing" state), so there is nothing to close. Same m.startedReported
    ' guard the retry paths above use, for the same reason.
    '
    ' Position comes from m.lastPosition, not m.video.position: the Video node
    ' has already been stopped by the line above, and this path is also reached
    ' from the playback-error dialog where the node has errored out.
    if m.startedReported then reportStopped(Int(m.lastPosition) * 10000000&)
    m.top.done = true
end sub

' Stop and re-negotiate (track/quality change), resuming at current position.
sub restartStream()
    m.pendingStartSecs = Int(m.video.position)
    m.video.control = "stop"
    m.statusLabel.visible = true
    m.statusLabel.text = "Loading..."
    requestStream(m.item)
end sub

sub onApiResponse()
    m.reqBusy = false
    pumpQueue()
    r = m.apiTask.response
    if r = invalid then return
    if r.action = "getPlaybackStream"
        onStreamReady(r)
    else if r.action = "getSiblingEpisodes"
        onSiblingsLoaded(r)
    else if r.action = "getIntroSegments"
        if r.itemId = m.item.Id and r.segments <> invalid then m.segments = r.segments
    end if
end sub

sub onStreamReady(r as object)
    if not r.success or r.url = invalid or r.url = ""
        m.statusLabel.visible = true
        m.statusLabel.text = "Unable to play this item."
        showPlaybackError("Can't play this item", "The server didn't return a playable stream. The file may be missing, or the server may be busy. Trying again often works.")
        return
    end if
    m.playSessionId = r.playSessionId
    m.playMethod = r.playMethod
    m.runTimeTicks = r.runTimeTicks
    if r.runTimeTicks <> invalid and r.runTimeTicks > 0 then m.durationSecs = Int(r.runTimeTicks / 10000000&)
    setTrickplay(r.trickplay, r.itemId)
    if r.subtitleTracks <> invalid then m.subTracks = sortSubTracks(r.subtitleTracks)
    if r.audioTracks <> invalid then m.audTracks = r.audioTracks

    ' Subtitle continuity: tracks are only known after negotiation, so on the
    ' FIRST response per file (guarded), re-match the session's remembered
    ' track title — or the Subtitles-On-By-Default setting when nothing was
    ' chosen this session — and renegotiate once with that stream index.
    if m.curSubIdx = -1 and not m.subPrefApplied
        m.subPrefApplied = true
        want = m.global.sessionSubtitleTitle
        pick = -1

        ' WHICH track: the one remembered this session, if this file has it.
        remembered = -1
        if want <> invalid and want <> "" and want <> "OFF"
            for each t in m.subTracks
                if t.title = want and remembered = -1 then remembered = t.index
            end for
        end if

        ' WHETHER subtitles are on. Precedence, cert 4.8: the Roku global caption
        ' setting wins at the start of every playback. An in-app "Subtitles Off"
        ' applies to the playback it was made in — it used to write "OFF" here and
        ' suppress captions for the whole app session, silently overriding a
        ' system setting the user had turned on. Below the global: an explicit
        ' in-session track choice, then Subtitles-On-By-Default.
        if captionsMode() = "On" and m.subTracks.count() > 0
            pick = remembered
            if pick = -1 then pick = m.subTracks[0].index
        else if remembered >= 0
            pick = remembered
        else if (want = invalid or want = "") and m.subTracks.count() > 0 and AppSettings.subtitlesDefaultOn()
            pick = m.subTracks[0].index
        end if

        if pick >= 0
            m.curSubIdx = pick
            requestStream(m.item)
            return
        end if
    end if

    ' Stream-info chips: resolution + codec + delivery method, rendered as
    ' capsule badges so they read separately from the text line
    chips = []
    if r.videoResolution <> invalid and r.videoResolution <> ""
        chips.push(r.videoResolution)
        if r.videoCodec <> invalid and r.videoCodec <> "" then chips.push(r.videoCodec)
    end if
    ' Viewer-facing wording: DirectPlay vs DirectStream is server plumbing —
    ' both deliver identical video bits, so both read "Original". Only a
    ' transcode changes the picture: "Converted".
    if m.playMethod = "Transcode"
        chips.push("Converted")
    else
        chips.push("Original")
    end if
    ' Bitrate chip (e.g. "4 Mbps") from the source media bitrate
    if r.bitrate <> invalid and r.bitrate > 0
        mbps = Int((r.bitrate / 1000000.0) + 0.5)
        if mbps < 1 then mbps = 1
        chips.push(str(mbps).Trim() + " Mbps")
    end if
    buildChips(chips)

    content = CreateObject("roSGNode", "ContentNode")
    content.url = r.url
    content.streamFormat = r.streamFormat
    if m.item.Name <> invalid then content.title = m.item.Name

    if m.pendingStartSecs >= 0
        ' restart after a track/quality change — resume where we were
        if m.pendingStartSecs > 0 then content.PlayStart = m.pendingStartSecs
        m.pendingStartSecs = -1
    else if m.top.playAction <> "play"
        startSecs = resumeSeconds()
        if startSecs > 0 then content.PlayStart = startSecs
    end if

    m.video.content = content
    m.video.control = "play"
    ' Focus stays on the screen — children never take it.
    m.top.setFocus(true)
    m.clockTimer.control = "start"
    updateClock()
    buildButtons()
    m.segments = []
    m.curSegment = invalid
    m.skippedSegments = {}
    hideSkipPill()
    if m.item.Type <> invalid and m.item.Type = "Episode"
        enqueue({ action: "getIntroSegments", itemId: m.item.Id })
    end if
end sub

' Menu ordering that avoids the "picked Forced, saw nothing" trap:
' full (non-forced) tracks first, forced tracks last.
function sortSubTracks(tracks as object) as object
    full = []
    forced = []
    for each t in tracks
        if t.isForced <> invalid and t.isForced
            forced.push(t)
        else
            full.push(t)
        end if
    end for
    for each t in forced
        full.push(t)
    end for
    return full
end function

function resumeSeconds() as integer
    if m.item.UserData = invalid then return 0
    if m.item.UserData.PlaybackPositionTicks = invalid then return 0
    posTicks = m.item.UserData.PlaybackPositionTicks
    thresholdTicks = AppSettings.resumeThresholdSeconds() * 10000000&
    if posTicks > thresholdTicks then return Int(posTicks / 10000000)
    return 0
end function

sub onVideoState()
    state = m.video.state
    if state = "playing"
        m.statusLabel.visible = false
        m.bufferTimer.control = "stop"
        m.isPaused = false
        updatePlayPauseUi()
        ' Give a fresh auto-hide countdown once playback (re)starts while the
        ' OSD is up — covers unpausing and slow reloads (subtitle burn-in) that
        ' outlast the initial one-shot timer.
        if m.osdVisible and m.zone <> "menu" then bumpOsd()
        if not m.startedReported
            m.startedReported = true
            report("reportStart", currentTicks(), false)
            m.progressTimer.control = "start"
        else
            report("reportProgress", currentTicks(), false)
        end if
    else if state = "paused"
        m.bufferTimer.control = "stop"
        m.isPaused = true
        updatePlayPauseUi()
        report("reportProgress", currentTicks(), true)
    else if state = "finished"
        ' Only a finish NEAR THE END is a real completion. Roku emits a
        ' spurious "finished" right after "error" (e.g. an mkv the hardware
        ' won't direct-play), and mid-stream glitches can fire it too — in
        ' both cases position is nowhere near the end, so we must not
        ' mark-played or auto-advance. The error branch handles recovery;
        ' a genuine end-of-episode lands within 30s of the runtime.
        nearEnd = (m.durationSecs > 0 and m.video.position >= m.durationSecs - 30)
        #if DEBUG
            print "[Player] finished pos="; Int(m.video.position); " dur="; m.durationSecs; " started="; m.startedReported; " nearEnd="; nearEnd; " method="; m.playMethod
        #end if
        if m.startedReported and nearEnd
            onPlaybackEnded()
        else if m.startedReported and not m.errorDialogUp and m.pendingStartSecs < 0
            ' A mid-stream "finished" nowhere near the end used to be swallowed
            ' with no action at all — frozen last frame, dead remote. If no
            ' recovery is already in flight (no pending restart, no error
            ' dialog), exit cleanly instead. Deliberately NOT mark-played and
            ' NOT auto-advance: the near-end gate above exists to block Roku's
            ' spurious finished-after-error, and this branch keeps that.
            #if DEBUG
                print "[Player] finished early - exiting cleanly"
            #end if
            exitPlayer()
        end if
    else if state = "error"
        ' Roku Video node error detail — the only reliable signal for WHY a
        ' stream was rejected (codec/level/segment/network). Logged for support.
        ei = m.video.errorInfo
        ' A finish/error genuinely near the end is not a stall (also gates the
        ' step-down below).
        nearEnd = (m.durationSecs > 0 and m.video.position >= m.durationSecs - 30)
        #if DEBUG
            print "[Player] VIDEO ERROR code="; m.video.errorCode; " method="; m.playMethod; " started="; m.startedReported; " nearEnd="; nearEnd; " stepDownIdx="; m.stepDownIdx
        #end if
        ' errorMsg/errorInfo can embed the stream URL, which carries
        ' api_key=<token> — DEBUG builds only
        #if DEBUG
            print "[Player] errMsg: "; m.video.errorMsg
            if ei <> invalid then print "[Player] errCode: "; ei.errorCode
        #end if
        ' Force Direct Play opts out of the adaptive transcode fallbacks below:
        ' log and let the normal playback-error surface instead of silently
        ' transcoding or stepping the bitrate down. Exception: if the stream
        ' is ALREADY transcoding (burn-in subtitles override the setting in
        ' JellyfinApi), keep the fallbacks — there's no direct-play purity
        ' left to protect.
        directPlayOnly = AppSettings.forceDirectPlay() and m.playMethod <> "Transcode"

        ' Direct-played container the hardware rejected (mkv edge cases):
        ' retry ONCE via forced HLS transcode before surfacing an error.
        if not directPlayOnly and not m.forceTranscode and m.playMethod <> "Transcode"
            m.forceTranscode = true
            m.statusLabel.visible = true
            m.statusLabel.text = "Loading..."
            ' lastPosition is only meaningful once playback actually began.
            ' On an instant reject (mkv at t=0) it is still 0 — retrying
            ' with 0 restarts a resumed episode from the beginning and
            ' then reports position 0, clobbering the saved spot.
            if m.startedReported
                m.pendingStartSecs = Int(m.lastPosition)
            else if m.top.playAction <> "play"
                m.pendingStartSecs = resumeSeconds()
            else
                m.pendingStartSecs = 0
            end if
            requestStream(m.item)
            return
        end if

        ' Bitrate step-down. Two triggers:
        '  (a) a mid-stream stall after playback started (weak downstream the
        '      Roku couldn't ride out — it hard-errors where AVPlayer rebuffers), OR
        '  (b) a transcode that ERRORED BEFORE IT EVER STARTED. When a file's
        '      video is already h264, a high bitrate cap makes the server
        '      stream-COPY the video (only the audio is transcoded, e.g. DTS->AAC).
        '      A low-power device (the onn soundbar) then can't begin a ~15Mbps
        '      1080p stream and errors at t=0 with no position to resume from.
        '      Stepping the cap down forces the server to RE-ENCODE the video to
        '      a bitrate the hardware can actually start. (Same file plays on
        '      iPad, which has no trouble with 15Mbps — this is device-specific.)
        onTranscode = (m.playMethod = "Transcode" or m.forceTranscode)
        stallAfterStart = (m.startedReported and not nearEnd)
        coldTranscodeFail = (not m.startedReported and onTranscode)
        if not directPlayOnly and (stallAfterStart or coldTranscodeFail) and m.stepDownIdx < (m.stepDownTiers.count() - 1)
            m.stepDownIdx = m.stepDownIdx + 1
            m.stepDownBps = m.stepDownTiers[m.stepDownIdx]
            ' Resume where we were on a mid-stream stall; on a cold t=0 fail
            ' honor the original play/resume intent (lastPosition is still 0).
            if m.startedReported
                m.pendingStartSecs = Int(m.lastPosition)
            else if m.top.playAction <> "play"
                m.pendingStartSecs = resumeSeconds()
            else
                m.pendingStartSecs = 0
            end if
            m.statusLabel.visible = true
            m.statusLabel.text = "Adjusting quality..."
            m.video.control = "stop"
            requestStream(m.item)
            return
        end if

        #if DEBUG
            if directPlayOnly then print "[Player] Force Direct Play on - skipping HLS/step-down fallback; surfacing playback error"
        #end if
        m.statusLabel.visible = true
        m.statusLabel.text = "Playback error."
        m.progressTimer.control = "stop"
        detail = "This video stopped unexpectedly. It may be in a format this Roku can't play, or the connection to the server dropped."
        ' Only the numeric code is safe to show: errorMsg/errorInfo can embed the
        ' stream URL, which carries api_key=<token>.
        if m.video.errorCode <> invalid and m.video.errorCode <> 0
            detail = detail + " (error code " + str(m.video.errorCode).Trim() + ")"
        end if
        showPlaybackError("Playback error", detail)
    else if state = "buffering"
        m.statusLabel.visible = true
        m.statusLabel.text = "Buffering..."
        armStallWatchdog()
    end if
end sub

sub onDuration()
    if m.video.duration <> invalid and m.video.duration > 0 then m.durationSecs = m.video.duration
    ' Trick-play held back because the duration was still 0 when the stream
    ' metadata arrived (see setTrickplay). The Video node now knows the real
    ' length, so the 15-minute gate can finally be judged on a true number.
    if m.tpDeferred <> invalid and m.durationSecs > 900
        deferred = m.tpDeferred
        setTrickplay(deferred.info, deferred.itemId)
    end if
end sub

sub onPosition()
    m.lastPosition = m.video.position
    if m.osdVisible and not m.seeking then updateScrubber()
    checkSegment(m.video.position)
end sub

' Intro Skipper: show a skip pill while inside a segment; OK jumps past it
sub checkSegment(posSecs as dynamic)
    if m.segments.count() = 0 then return
    active = invalid
    for each seg in m.segments
        if posSecs >= seg.startSec and posSecs < seg.endSec
            active = seg
            exit for
        end if
    end for
    if active <> invalid
        ' Auto-Skip Intro/Credits: when the matching setting is ON, seek past
        ' the segment automatically the first time we enter it. The guard means
        ' seeking back in shows the manual pill again but never re-yanks.
        isCredits = (LCase(active.segType) = "credits")
        autoSkip = false
        if isCredits
            autoSkip = AppSettings.autoSkipCredits()
        else
            autoSkip = AppSettings.autoSkipIntro()
        end if
        segKey = active.segType + "_" + Int(active.startSec).toStr()
        if autoSkip and not m.skippedSegments.DoesExist(segKey)
            m.skippedSegments[segKey] = true
            m.seeking = false
            #if DEBUG
                print "[Player] skip seek -> "; Int(active.endSec); " dur="; m.durationSecs
            #end if
            m.video.seek = active.endSec
            m.curSegment = invalid
            hideSkipPill()
            return
        end if
        if m.curSegment = invalid or m.curSegment.segType <> active.segType
            m.curSegment = active
            label = "Skip Intro"
            if isCredits then label = "Skip Credits"
            m.skipPillLabel.text = label + "  " + Chr(8226) + "  OK"
            m.skipPill.visible = true
            m.skipVisible = true
        end if
    else if m.curSegment <> invalid
        m.curSegment = invalid
        hideSkipPill()
    end if
end sub

sub hideSkipPill()
    m.skipPill.visible = false
    m.skipVisible = false
end sub

sub skipCurrentSegment()
    if m.curSegment = invalid then return
    m.seeking = false
    #if DEBUG
        print "[Player] skip seek -> "; Int(m.curSegment.endSec); " dur="; m.durationSecs
    #end if
    m.video.seek = m.curSegment.endSec
    m.curSegment = invalid
    hideSkipPill()
end sub

sub onProgressTimer()
    if m.video.state = "playing" then report("reportProgress", currentTicks(), false)
end sub

' ---------- OSD visibility ----------

sub showOsd()
    buildChapterTicks()
    updateScrubber()
    updateClock()
    if m.osdVisible
        bumpOsd()
        return
    end if
    m.osdVisible = true
    m.osd.visible = true
    m.zone = "scrub"
    restyleButtons()
    m.osdInterp.keyValue = [m.osd.opacity, 1.0]
    m.osdAnim.control = "start"
    m.osdTimer.control = "start"
end sub

sub hideOsd()
    hideTrickplay()
    closeMenu()
    m.zone = "scrub"
    restyleButtons()
    if not m.osdVisible then return
    m.osdVisible = false
    m.osdTimer.control = "stop"
    m.osdInterp.keyValue = [m.osd.opacity, 0.0]
    m.osdAnim.control = "start"
end sub

sub onOsdTimer()
    ' Auto-fade like tvOS: hide from any zone after inactivity while playing.
    ' osdTimer is one-shot (repeat=false). If we can't hide yet — paused, a
    ' menu is open, or a mid-playback reload (e.g. a subtitle burn-in) is still
    ' buffering — we must RESCHEDULE rather than fall through, otherwise the
    ' timer dies and the OSD sticks on screen until it's dismissed by hand.
    if m.isPaused or m.zone = "menu" or m.video.state <> "playing"
        m.osdTimer.control = "start"
        return
    end if
    hideOsd()
end sub

sub bumpOsd()
    m.osdTimer.control = "stop"
    m.osdTimer.control = "start"
end sub

' Thin markers on the scrub track at each chapter start (tvOS chapter dots)
sub buildChapterTicks()
    if m.chapterTicksBuilt then return
    if m.chapters.count() < 2 or m.durationSecs <= 0 then return
    m.chapterTicksBuilt = true
    for each ch in m.chapters
        if ch.startSec > 0 and ch.startSec < m.durationSecs
            tick = CreateObject("roSGNode", "Rectangle")
            tick.width = 4
            tick.height = 12
            tick.color = "#000000"
            tick.opacity = 0.55
            tick.translation = [Int(1760 * ch.startSec / m.durationSecs) - 2, 0]
            m.osdChapterTicks.appendChild(tick)
        end if
    end for
end sub

' ---------- Buttons (virtual highlight) ----------

sub buildButtons()
    while m.osdBtnRow.getChildCount() > 0
        m.osdBtnRow.removeChildIndex(0)
    end while
    m.buttons = []

    defs = []
    if m.isPaused
        defs.push({ kind: "playpause", label: "Play" })
    else
        defs.push({ kind: "playpause", label: "Pause" })
    end if
    defs.push({ kind: "restart", label: "Start Over" })
    defs.push({ kind: "subs", label: "Subtitles" })
    if m.audTracks.count() > 1 then defs.push({ kind: "audio", label: "Audio" })
    if m.chapters.count() > 1 then defs.push({ kind: "chapters", label: "Chapters" })
    defs.push({ kind: "quality", label: "Quality" })

    x = 0
    for each d in defs
        bw = 52 + Len(d.label) * 13
        cell = CreateObject("roSGNode", "Group")
        cell.translation = [x, 0]

        bg = CreateObject("roSGNode", "Poster")
        bg.width = bw
        bg.height = 52
        cell.appendChild(bg)

        lbl = CreateObject("roSGNode", "Label")
        lbl.text = d.label
        lbl.width = bw
        lbl.height = 52
        lbl.horizAlign = "center"
        lbl.vertAlign = "center"
        f = CreateObject("roSGNode", "Font")
        f.uri = "pkg:/fonts/Inter-Medium.ttf"
        f.size = 24
        lbl.font = f
        cell.appendChild(lbl)

        m.osdBtnRow.appendChild(cell)
        m.buttons.push({ kind: d.kind, bg: bg, lbl: lbl, w: bw })
        x += bw + 20
    end for
    if m.btnIdx >= m.buttons.count() then m.btnIdx = 0
    restyleButtons()
end sub

sub restyleButtons()
    ' Zone affordance: big knob while scrubbing, dimmed buttons; entering the
    ' button row shrinks the knob and lights a capsule.
    if m.zone = "scrub"
        m.osdScrubKnob.width = 12
        m.osdScrubKnob.height = 28
        m.osdScrubKnob.opacity = 1.0
        m.osdBtnRow.opacity = 0.65
    else
        m.osdScrubKnob.width = 8
        m.osdScrubKnob.height = 22
        m.osdScrubKnob.opacity = 0.6
        m.osdBtnRow.opacity = 1.0
    end if
    for i = 0 to m.buttons.count() - 1
        b = m.buttons[i]
        if m.zone = "buttons" and i = m.btnIdx
            b.bg.uri = "pkg:/images/btn_white_focus.9.png"
            b.lbl.color = "#000000"
        else
            b.bg.uri = "pkg:/images/btn_dark.9.png"
            b.lbl.color = "#FFFFFF"
        end if
    end for
end sub

' Update the Play/Pause capsule + indicator without a full rebuild
sub updatePlayPauseUi()
    m.osdPlayPause.visible = true
    if m.isPaused
        m.osdPlayPause.uri = "pkg:/images/osd_play.png"
    else
        m.osdPlayPause.uri = "pkg:/images/osd_pause.png"
    end if
    for each b in m.buttons
        if b.kind = "playpause"
            if m.isPaused then b.lbl.text = "Play" else b.lbl.text = "Pause"
        end if
    end for
end sub

sub activateButton()
    if m.btnIdx < 0 or m.btnIdx >= m.buttons.count() then return
    kind = m.buttons[m.btnIdx].kind
    if kind = "playpause"
        togglePlayPause()
    else if kind = "restart"
        m.seeking = false
        m.video.seek = 0
        updateScrubber()
    else if kind = "subs"
        openMenu("subs")
    else if kind = "audio"
        openMenu("audio")
    else if kind = "chapters"
        openMenu("chapters")
    else if kind = "quality"
        openMenu("quality")
    end if
    bumpOsd()
end sub

' ---------- Popup menu (virtual highlight) ----------

sub openMenu(kind as string)
    m.menuKind = kind
    m.menuItems = []
    current = 0

    if kind = "subs"
        m.osdMenuTitle.text = "Subtitles"
        m.menuItems.push({ label: "Off", value: -1 })
        for i = 0 to m.subTracks.count() - 1
            m.menuItems.push({ label: m.subTracks[i].title, value: m.subTracks[i].index })
            if m.subTracks[i].index = m.curSubIdx then current = m.menuItems.count() - 1
        end for
    else if kind = "audio"
        m.osdMenuTitle.text = "Audio"
        for i = 0 to m.audTracks.count() - 1
            m.menuItems.push({ label: m.audTracks[i].title, value: m.audTracks[i].index })
            if m.audTracks[i].index = m.curAudIdx then current = m.menuItems.count() - 1
        end for
        if m.curAudIdx = -1 then current = 0
    else if kind = "chapters"
        m.osdMenuTitle.text = "Chapters"
        for i = 0 to m.chapters.count() - 1
            ch = m.chapters[i]
            m.menuItems.push({ label: ch.name + "  " + Chr(8226) + "  " + formatTime(ch.startSec), value: ch.startSec })
            if m.video.position >= ch.startSec then current = i
        end for
    else if kind = "quality"
        m.osdMenuTitle.text = "Quality"
        m.menuItems.push({ label: "Auto", value: 0 })
        m.menuItems.push({ label: "High - 20 Mbps", value: 20000000 })
        m.menuItems.push({ label: "Medium - 10 Mbps", value: 10000000 })
        m.menuItems.push({ label: "Low - 4 Mbps", value: 4000000 })
        for i = 0 to m.menuItems.count() - 1
            if m.menuItems[i].value = m.qualityBps then current = i
        end for
    end if

    m.menuIdx = current
    m.menuScroll = 0
    if m.menuIdx >= m.menuMaxRows then m.menuScroll = m.menuIdx - m.menuMaxRows + 1
    buildMenuRows()
    m.osdMenu.visible = true
    m.zone = "menu"
    restyleButtons()
    m.osdTimer.control = "stop"   ' no auto-hide while a menu is open
end sub

' Renders a window of up to menuMaxRows rows starting at m.menuScroll —
' long track lists scroll instead of pushing the panel off screen.
sub buildMenuRows()
    while m.osdMenuRows.getChildCount() > 0
        m.osdMenuRows.removeChildIndex(0)
    end while
    m.menuRowNodes = []

    rowH = 56
    total = m.menuItems.count()
    visible = total - m.menuScroll
    if visible > m.menuMaxRows then visible = m.menuMaxRows

    for w = 0 to visible - 1
        i = m.menuScroll + w
        cell = CreateObject("roSGNode", "Group")
        cell.translation = [0, w * rowH]

        bg = CreateObject("roSGNode", "Poster")
        bg.width = 512
        bg.height = 50
        cell.appendChild(bg)

        lbl = CreateObject("roSGNode", "Label")
        lbl.text = menuRowText(i)
        lbl.width = 480
        lbl.height = 50
        lbl.translation = [16, 0]
        lbl.vertAlign = "center"
        f = CreateObject("roSGNode", "Font")
        f.uri = "pkg:/fonts/Inter-Medium.ttf"
        f.size = 25
        lbl.font = f
        cell.appendChild(lbl)

        m.osdMenuRows.appendChild(cell)
        m.menuRowNodes.push({ bg: bg, lbl: lbl })
    end for

    ' Size + position the panel just above the button row; clamp on screen.
    ' "+N more" hint row space when scrollable.
    h = visible * rowH + 100
    y = 860 - h
    if y < 60 then y = 60
    m.osdMenuBg.height = h
    m.osdMenuBg.translation = [80, y]
    m.osdMenuTitle.translation = [116, y + 28]
    m.osdMenuRows.translation = [104, y + 80]
    restyleMenu()
end sub

function menuRowText(i as integer) as string
    item = m.menuItems[i]
    t = item.label
    if isCurrentValue(item.value) then t = t + "   " + Chr(8226)
    return t
end function

function isCurrentValue(value as integer) as boolean
    if m.menuKind = "subs" then return value = m.curSubIdx
    if m.menuKind = "audio" then return (value = m.curAudIdx) or (m.curAudIdx = -1 and m.menuItems.count() > 0 and m.menuItems[0].value = value)
    if m.menuKind = "quality" then return value = m.qualityBps
    ' chapters are positions, not settings — no persistent bullet
    return false
end function

sub restyleMenu()
    for w = 0 to m.menuRowNodes.count() - 1
        r = m.menuRowNodes[w]
        if m.menuScroll + w = m.menuIdx
            r.bg.uri = "pkg:/images/btn_white_focus.9.png"
            r.lbl.color = "#000000"
        else
            r.bg.uri = ""
            r.lbl.color = "#FFFFFF"
        end if
    end for
end sub

sub applyMenuSelection()
    if m.menuIdx < 0 or m.menuIdx >= m.menuItems.count() then return
    value = m.menuItems[m.menuIdx].value

    if m.menuKind = "chapters"
        m.seeking = false
        m.video.seek = value
        updateScrubber()
    else if m.menuKind = "subs"
        if value <> m.curSubIdx
            m.curSubIdx = value
            ' Session memory (tvOS parity): remember the chosen track by TITLE
            ' so the next episode re-selects it (indexes are per-file). "OFF"
            ' records an explicit disable so default-on can't re-enable.
            if value = -1
                m.global.sessionSubtitleTitle = "OFF"
            else
                for each t in m.subTracks
                    if t.index = value then m.global.sessionSubtitleTitle = t.title
                end for
            end if
            restartStream()
        end if
    else if m.menuKind = "audio"
        if value <> m.curAudIdx
            m.curAudIdx = value
            restartStream()
        end if
    else if m.menuKind = "quality"
        if value <> m.qualityBps
            m.qualityBps = value
            restartStream()
        end if
    end if
    closeMenu()
    m.zone = "buttons"
    restyleButtons()
    bumpOsd()
end sub

' ---------- Global captions (cert 4.8) ----------

function captionsMode() as string
    if m.deviceInfo = invalid then return "Off"
    mode = m.deviceInfo.GetCaptionsMode()
    if mode = invalid or mode = "" then return "Off"
    return mode
end function

' Polled rather than event-driven: roDeviceInfo's caption event needs a message
' port, which a render-thread component has no loop to service. The read is a
' cheap local lookup and only does work when the value actually changes.
sub onCaptionTimer()
    mode = captionsMode()
    if mode = m.lastCaptionsMode then return
    m.lastCaptionsMode = mode
    applyCaptionsMode(mode)
end sub

' "On instant replay" and "When mute" are dynamic modes: subtitles here are
' burned into the transcode, so they cannot appear and disappear on cue. They
' are treated as "not always on" and burn-in is cleared, rather than ignored —
' onCaptionTimer advances m.lastCaptionsMode before dispatching, so an ignored
' mode consumed the change and left subtitles burned in permanently, with no way
' for the OS setting to clear them short of cycling back through "Off".
sub applyCaptionsMode(mode as string)
    if mode = "On"
        if m.curSubIdx <> -1 or m.subTracks.count() = 0 then return
        m.curSubIdx = m.subTracks[0].index
        m.global.sessionSubtitleTitle = m.subTracks[0].title
        restartStream()
    else
        if m.curSubIdx = -1 then return
        m.curSubIdx = -1
        m.global.sessionSubtitleTitle = "OFF"
        restartStream()
    end if
end sub

sub closeMenu()
    m.osdMenu.visible = false
    m.menuKind = ""
end sub

' ---------- Scrubber ----------

sub updateScrubber()
    if m.seeking
        previewScrubber(m.seekTarget)
        return
    end if
    drawScrubber(m.video.position)
end sub

sub previewScrubber(target as dynamic)
    drawScrubber(target)
end sub

sub drawScrubber(position as dynamic)
    if m.seeking
        showTrickplay(position)
    else
        hideTrickplay()
    end if
    dur = m.durationSecs
    fillW = 0
    if dur > 0
        frac = position / dur
        if frac < 0 then frac = 0
        if frac > 1 then frac = 1
        fillW = Int(1760 * frac)
    end if
    m.osdScrubFill.width = fillW
    knobW = m.osdScrubKnob.width
    knobH = m.osdScrubKnob.height
    m.osdScrubKnob.translation = [80 + fillW - Int(knobW / 2), 1003 - Int(knobH / 2)]
    m.osdElapsed.text = formatTime(position)
    remaining = dur - position
    if remaining < 0 then remaining = 0
    m.osdRemaining.text = "-" + formatTime(remaining)
end sub

' ---------- Trick-play thumbnails (cert 4.7) ----------
' Roku's native trick play requires a BIF file; Jellyfin serves only JPEG tile
' sheets, so the frame is composed here. Geometry is read from the item's own
' Trickplay metadata rather than assumed -- it is per media source, and this
' server has sheets from two different tile configurations in flight.

sub setTrickplay(info as object, itemId as dynamic)
    m.tp = invalid
    m.tpSheet = -1
    m.tpDeferred = invalid
    hideTrickplay()
    if info = invalid or itemId = invalid or itemId = "" then return
    ' Cert 4.7 only asks for thumbnails above 15 minutes, and a short clip
    ' yields too few tiles to be worth the fetch.
    if m.durationSecs <= 900
        ' A zero duration is NOT a short clip: a server that omits
        ' MediaSources[0].RunTimeTicks (and the autoplay-next reset) leaves it
        ' at 0, which trips the same gate and used to disable trick-play for
        ' the whole item -- onDuration learns the real runtime from the Video
        ' node seconds later but never came back here. Hold the metadata so it
        ' can re-run this once the length is actually known.
        if m.durationSecs <= 0 then m.tpDeferred = { info: info, itemId: itemId }
        return
    end if

    best = invalid
    for each srcId in info
        byWidth = info[srcId]
        for each w in byWidth
            cand = byWidth[w]
            if cand.Width <> invalid and cand.TileWidth <> invalid and cand.Interval <> invalid and cand.Interval > 0
                if best = invalid or cand.Width > best.Width then best = cand
            end if
        end for
    end for
    if best = invalid then return

    tileW = best.TileWidth
    tileH = best.TileHeight
    if tileH = invalid or tileH <= 0 then tileH = 1
    m.tp = {
        itemId: itemId
        width: best.Width
        height: best.Height
        tileW: tileW
        tileH: tileH
        perSheet: tileW * tileH
        count: best.ThumbnailCount
        interval: best.Interval
    }

    ' The window is exactly one tile; the Poster behind it is the whole sheet.
    m.tpGroup.clippingRect = [0, 0, m.tp.width, m.tp.height]
    m.tpBorder.width = m.tp.width
    m.tpBorder.height = m.tp.height
    m.tpImage.width = m.tp.width * m.tp.tileW
    m.tpImage.height = m.tp.height * m.tp.tileH
    m.tpImage.loadWidth = m.tpImage.width
    m.tpImage.loadHeight = m.tpImage.height
    m.tpTime.width = m.tp.width
end sub

sub showTrickplay(position as dynamic)
    if m.tp = invalid or m.durationSecs <= 0
        hideTrickplay()
        return
    end if

    idx = Int((position * 1000.0#) / m.tp.interval)
    if idx < 0 then idx = 0
    if m.tp.count <> invalid and m.tp.count > 0 and idx > m.tp.count - 1 then idx = m.tp.count - 1

    sheet = Int(idx / m.tp.perSheet)
    within = idx mod m.tp.perSheet
    row = Int(within / m.tp.tileW)
    col = within mod m.tp.tileW

    ' Sheets are ~1 MB, so only refetch when the sheet actually changes.
    if sheet <> m.tpSheet
        ' A new sheet is a 1920x1080 decode -- the largest single allocation the
        ' player makes on top of the decoder -- and it buys a preview frame the
        ' viewer sees for a fraction of a second. Close to the channel's limit
        ' that trade is wrong: give back the sheet already held and scrub on the
        ' timestamp alone rather than risk being killed mid-playback.
        if memoryPressureHigh()
            dropTrickplaySheet()
        else
            m.tpSheet = sheet
            m.tpImage.uri = tileSheetUrl(sheet)
        end if
    end if
    m.tpImage.translation = [-col * m.tp.width, -row * m.tp.height]

    ' Centre on the scrub knob, clamped to the bar's own extent (x 80..1840).
    frac = position / m.durationSecs
    if frac < 0 then frac = 0
    if frac > 1 then frac = 1
    knobX = 80 + Int(1760 * frac)
    x = knobX - Int(m.tp.width / 2)
    if x < 80 then x = 80
    if x > 1840 - m.tp.width then x = 1840 - m.tp.width
    ' Sit the whole assembly (frame + timestamp) ABOVE the OSD button row,
    ' whose top edge is 876 -- it used to be anchored off the scrubber and so
    ' covered Play and Start Over for the entire scrub. 34 = the 6px gap under
    ' the frame plus the timestamp line; 16 keeps a gap above the buttons.
    y = 876 - 16 - 34 - m.tp.height

    m.tpGroup.translation = [x, y]
    m.tpTime.translation = [x, y + m.tp.height + 6]
    m.tpTime.text = formatTime(position)
    ' No sheet (dropped or withheld under pressure) means no frame -- an empty
    ' bordered box reads as a broken thumbnail. The timestamp still tracks the
    ' scrub, which is the part that actually navigates.
    m.tpGroup.visible = (m.tpSheet >= 0)
    m.tpTime.visible = true
end sub

' ---------- Memory pressure ----------
' The trickplay sheet is the only thing here the viewer is usually NOT looking
' at: the overlay is on screen while scrubbing and nowhere else. Called by
' MainScene when the device reports low general memory.
sub releaseArtwork(reason as dynamic) as void
    if m.seeking then return
    #if DEBUG
        print "[Mem] PlayerScreen dropping trickplay sheet "; m.tpSheet
    #end if
    dropTrickplaySheet()
end sub

sub dropTrickplaySheet()
    m.tpImage.uri = ""
    m.tpSheet = -1
end sub

' GetMemoryLimitPercent is the direct reading and is used as such, but it cannot
' be trusted on its own: the dev soundbar (Roku OS 15.3.4) returns 0 from it
' while the channel is demonstrably holding ~16% of its foreground budget, so a
' gate on that number alone would never fire anywhere it reads 0. The
' available-memory figure does track real usage, so derive a percentage from it
' too and go with whichever is higher.
function memoryPressureHigh() as boolean
    if m.appMem = invalid then return false
    pct = m.appMem.GetMemoryLimitPercent()
    limitKb = m.global.memoryLimitKb
    if limitKb > 0
        usedPct = 100 - Int((m.appMem.GetChannelAvailableMemory() * 100) / limitKb)
        if usedPct > pct then pct = usedPct
    end if
    #if DEBUG
        print "[Mem] trickplay gate: used% "; pct; " threshold "; m.tpPressurePct
    #end if
    return pct >= m.tpPressurePct
end function

' Built here rather than in the API task because the Poster fetches its own URI
' from the render thread. A Poster cannot attach an Authorization header, so the
' token rides in the query string -- the same unavoidable case as every other
' artwork URL in the app.
function tileSheetUrl(sheet as integer) as string
    base = m.global.serverUrl
    if base = invalid or base = "" then return ""
    if Right(base, 1) = "/" then base = Left(base, Len(base) - 1)
    return base + "/Videos/" + m.tp.itemId + "/Trickplay/" + str(m.tp.width).Trim() + "/" + str(sheet).Trim() + ".jpg?api_key=" + m.global.authToken
end function

sub hideTrickplay()
    if m.tpGroup <> invalid then m.tpGroup.visible = false
    if m.tpTime <> invalid then m.tpTime.visible = false
end sub

sub togglePlayPause()
    if m.isPaused
        m.video.control = "resume"
    else
        m.video.control = "pause"
    end if
end sub

' Debounced, accelerating seek: rapid presses move a preview (step doubles
' 10->20->40->60), one video.seek fires when the presses stop.
sub seekBy(dir as integer)
    elapsedMs = m.seekSpan.TotalMilliseconds()
    if m.seeking and dir = m.seekDir and elapsedMs < 700
        m.seekStep = m.seekStep * 2
        if m.seekStep > 60 then m.seekStep = 60
    else
        m.seekStep = 10
    end if
    m.seekDir = dir
    m.seekSpan.Mark()

    if not m.seeking
        m.seeking = true
        m.seekTarget = m.video.position
    end if
    m.seekTarget = m.seekTarget + dir * m.seekStep
    if m.seekTarget < 0 then m.seekTarget = 0
    if m.durationSecs > 0 and m.seekTarget > m.durationSecs - 2 then m.seekTarget = m.durationSecs - 2
    previewScrubber(m.seekTarget)
    m.seekTimer.control = "stop"
    m.seekTimer.control = "start"
end sub

sub onSeekTimer()
    if m.seeking
        m.video.seek = m.seekTarget
        m.seeking = false
    end if
end sub

' ---------- Info bar ----------

sub populateInfoBar()
    item = m.item
    if item = invalid then return
    isYT = YT.isItem(item)
    itype = ""
    if item.Type <> invalid then itype = item.Type

    name = ""
    if item.Name <> invalid then name = item.Name

    m.osdLogo.visible = false
    m.osdChannelCircle.visible = false
    m.osdChannelName.visible = false

    title = name
    if itype = "Episode" and not isYT and item.ParentIndexNumber <> invalid and item.IndexNumber <> invalid
        title = "S" + str(item.ParentIndexNumber).Trim() + ":E" + str(item.IndexNumber).Trim() + " " + Chr(8226) + " " + name
    end if
    m.osdTitle.text = title

    hasHeaderArt = false
    if itype = "Episode" and item.SeriesId <> invalid
        if isYT
            m.osdChannelCircle.visible = true
            m.osdChannelCircle.uri = ImageUrl.primary(item.SeriesId, 160)
            m.osdChannelName.visible = true
            chName = ""
            if item.SeriesName <> invalid then chName = YT.cleanTitle(item.SeriesName)
            m.osdChannelName.text = chName
            hasHeaderArt = true
        else
            m.osdLogo.visible = true
            m.osdLogo.uri = m.global.serverUrl + "/Items/" + item.SeriesId + "/Images/Logo?maxHeight=144&quality=90"
            hasHeaderArt = true
        end if
    else if itype = "Series"
        m.osdLogo.visible = true
        m.osdLogo.uri = m.global.serverUrl + "/Items/" + item.Id + "/Images/Logo?maxHeight=144&quality=90"
        hasHeaderArt = true
    end if

    if hasHeaderArt
        m.osdTitle.translation = [80, 118]
        m.osdSubtitle.translation = [80, 172]
        m.osdChips.translation = [80, 214]
    else
        m.osdTitle.translation = [80, 44]
        m.osdSubtitle.translation = [80, 104]
        m.osdChips.translation = [80, 146]
    end if

    subParts = []
    if itype = "Episode"
        if not isYT and item.SeriesName <> invalid then subParts.push(item.SeriesName)
        if item.PremiereDate <> invalid and Len(item.PremiereDate) >= 10 then subParts.push(YT.formatDate(item.PremiereDate))
    else
        if item.ProductionYear <> invalid then subParts.push(str(item.ProductionYear).Trim())
    end if
    m.subtitleBase = joinParts(subParts)
    m.osdSubtitle.text = m.subtitleBase
end sub

' Small capsule badges (resolution / codec / delivery) under the meta line
sub buildChips(chips as object)
    while m.osdChips.getChildCount() > 0
        m.osdChips.removeChildIndex(0)
    end while
    x = 0
    for each c in chips
        w = 28 + Len(c) * 12
        bg = CreateObject("roSGNode", "Poster")
        bg.uri = "pkg:/images/badge_capsule.9.png"
        bg.width = w
        bg.height = 34
        bg.translation = [x, 0]
        m.osdChips.appendChild(bg)

        lbl = CreateObject("roSGNode", "Label")
        lbl.text = c
        lbl.width = w
        lbl.height = 34
        lbl.horizAlign = "center"
        lbl.vertAlign = "center"
        lbl.color = "#E6FFFFFF"
        f = CreateObject("roSGNode", "Font")
        f.uri = "pkg:/fonts/Inter-Medium.ttf"
        f.size = 20
        lbl.font = f
        lbl.translation = [x, 0]
        m.osdChips.appendChild(lbl)
        x += w + 12
    end for
end sub

sub updateClock()
    dt = CreateObject("roDateTime")
    dt.ToLocalTime()
    m.osdClock.text = formatClock(dt.GetHours(), dt.GetMinutes())
    m.osdSubtitle.text = m.subtitleBase
    ' "Finishes at" lives under the clock (right side) so the left meta line
    ' stays short and scannable
    finishes = ""
    if m.durationSecs > 0
        remaining = m.durationSecs - m.video.position
        if remaining > 0
            totalMin = dt.GetHours() * 60 + dt.GetMinutes() + Int(remaining / 60)
            fh = (totalMin \ 60) mod 24
            fm = totalMin mod 60
            finishes = "Finishes at " + formatClock(fh, fm)
        end if
    end if
    m.osdFinishes.text = finishes
end sub

sub onClockTimer()
    updateClock()
end sub

function joinParts(parts as object) as string
    out = ""
    for i = 0 to parts.count() - 1
        if i > 0 then out = out + "  " + Chr(8226) + "  "
        out = out + parts[i]
    end for
    return out
end function

function formatTime(totalSecs as dynamic) as string
    s = Int(totalSecs)
    if s < 0 then s = 0
    h = s \ 3600
    mins = (s mod 3600) \ 60
    sec = s mod 60
    ss = sec.toStr()
    if sec < 10 then ss = "0" + ss
    if h > 0
        ms = mins.toStr()
        if mins < 10 then ms = "0" + ms
        return h.toStr() + ":" + ms + ":" + ss
    end if
    return mins.toStr() + ":" + ss
end function

' 24-Hour Time setting is honored via the shared TimeFormat helper (OSD clock
' + "Finishes at"); 24h -> "21:41", 12h -> "9:41 PM".
function formatClock(h24 as integer, minute as integer) as string
    return TimeFormat.clock(h24, minute)
end function

' ---------- Reporting ----------

function currentTicks() as longinteger
    return m.video.position * 10000000&
end function

sub report(action as string, positionTicks as longinteger, isPaused as boolean)
    if m.item = invalid then return
    enqueue({
        action: action
        itemId: m.item.Id
        positionTicks: positionTicks
        isPaused: isPaused
        playMethod: m.playMethod
        playSessionId: m.playSessionId
    })
end sub

sub reportStopped(positionTicks as longinteger)
    if m.stoppedReported then return
    m.stoppedReported = true
    m.progressTimer.control = "stop"
    if m.item <> invalid
        enqueue({
            action: "reportStopped"
            itemId: m.item.Id
            positionTicks: positionTicks
            playSessionId: m.playSessionId
        })
    end if
end sub

sub onPlaybackEnded()
    endTicks = m.runTimeTicks
    if endTicks <= 0 then endTicks = currentTicks()
    m.bufferTimer.control = "stop"
    reportStopped(endTicks)
    hideOsd()
    enqueue({ action: "markPlayed", itemId: m.item.Id })

    autoplay = AppSettings.autoPlayNextEpisode()
    itemType = ""
    if m.item.Type <> invalid then itemType = m.item.Type
    #if DEBUG
        print "[Player] ended autoplay="; autoplay; " type="; itemType; " hasSeasonId="; (m.item.SeasonId <> invalid)
    #end if
    if autoplay and itemType = "Episode" and m.item.SeasonId <> invalid
        m.statusLabel.visible = true
        m.statusLabel.text = "Up next..."
        m.siblingsRetried = false
        enqueue({ action: "getSiblingEpisodes", parentId: m.item.SeasonId })
        ' The handoff is up to three serialized 30s requests (reportStopped,
        ' markPlayed, siblings). Without a watchdog a dead server freezes the
        ' last frame behind "Up next..." indefinitely; the stall dialog at
        ' least gives the viewer Try Again / Back. requestStream re-arms it
        ' when the next stream starts negotiating.
        armStallWatchdog()
    else
        m.top.done = true
    end if
end sub

sub onSiblingsLoaded(r as object)
    ' success=false is a failed FETCH (timeout / non-2xx), not an empty season
    ' — the two used to be indistinguishable, which made a dropped request look
    ' like "no next episode". Retry once before giving up.
    if not r.success
        if not m.siblingsRetried
            m.siblingsRetried = true
            #if DEBUG
                print "[Player] siblings fetch failed - retrying once"
            #end if
            enqueue({ action: "getSiblingEpisodes", parentId: m.item.SeasonId })
            armStallWatchdog()
            return
        end if
        #if DEBUG
            print "[Player] autoplay giving up: siblings fetch failed twice"
        #end if
        m.bufferTimer.control = "stop"
        m.top.done = true
        return
    end if

    nextEp = invalid
    curIdx = -1
    if r.items <> invalid and m.item.IndexNumber <> invalid
        curIdx = m.item.IndexNumber
        for each ep in r.items
            if ep.IndexNumber <> invalid and ep.IndexNumber = curIdx + 1
                nextEp = ep
                exit for
            end if
        end for
        if nextEp = invalid
            for each ep in r.items
                if ep.IndexNumber <> invalid and ep.IndexNumber > curIdx
                    nextEp = ep
                    exit for
                end if
            end for
        end if
    end if

    n = 0
    if r.items <> invalid then n = r.items.count()
    nextIdx = -1
    if nextEp <> invalid and nextEp.IndexNumber <> invalid then nextIdx = nextEp.IndexNumber
    #if DEBUG
        print "[Player] siblings n="; n; " curIdx="; curIdx; " next="; nextIdx
    #end if

    if nextEp <> invalid
        m.stoppedReported = false
        m.startedReported = false
        m.lastPosition = 0
        m.top.playAction = "play"
        m.item = nextEp
        ' Everything per-ITEM has to reset here, not just the track indexes —
        ' this path bypasses onItemDataChanged. Leaving forceTranscode or a
        ' step-down cap set means one bad episode silently pins the whole binge
        ' to a re-encoded, bitrate-capped stream; leaving the chapters set makes
        ' the Chapters menu seek to the previous episode's timestamps.
        m.forceTranscode = false
        m.stepDownIdx = -1
        m.stepDownBps = 0
        m.pendingStartSecs = -1
        ' Runtime comes from the next episode's own PlaybackInfo; a stale value
        ' would place the chapter ticks and scrubber against the wrong length.
        m.runTimeTicks = 0
        m.durationSecs = 0
        setChapters(nextEp)
        ' Subtitle indexes are per-file — reset; onStreamReady re-matches the
        ' session's remembered track by title. Quality choice persists.
        m.curSubIdx = -1
        m.curAudIdx = -1
        m.subPrefApplied = false
        populateInfoBar()
        requestStream(nextEp)
    else
        ' Season genuinely over (or this item carries no IndexNumber to
        ' advance from) — a normal end, same behavior as before.
        #if DEBUG
            print "[Player] autoplay done: no next episode in season"
        #end if
        m.bufferTimer.control = "stop"
        m.top.done = true
    end if
end sub

' ---------- Keys (single handler; no child ever holds focus) ----------

function onKeyEvent(key as string, press as boolean) as boolean
    ' A dialog dismissed with Back never fires buttonSelected, so the flag would
    ' latch and block every later error. Any key reaching this screen proves the
    ' modal is gone — dialogs consume everything while they are up.
    if m.errorDialogUp then m.errorDialogUp = false
    if not press then return false

    ' Menu zone: up/down navigate, OK applies, back/left dismiss
    if m.zone = "menu"
        if key = "up"
            if m.menuIdx > 0 then m.menuIdx = m.menuIdx - 1
            if m.menuIdx < m.menuScroll
                m.menuScroll = m.menuIdx
                buildMenuRows()
            else
                restyleMenu()
            end if
            return true
        else if key = "down"
            if m.menuIdx < m.menuItems.count() - 1 then m.menuIdx = m.menuIdx + 1
            if m.menuIdx >= m.menuScroll + m.menuMaxRows
                m.menuScroll = m.menuIdx - m.menuMaxRows + 1
                buildMenuRows()
            else
                restyleMenu()
            end if
            return true
        else if key = "OK"
            applyMenuSelection()
            return true
        else if key = "back" or key = "left"
            closeMenu()
            m.zone = "buttons"
            restyleButtons()
            bumpOsd()
            return true
        end if
        ' Cert 4.4 reserves "*" for Roku's own system overlay during playback —
        ' the app must never consume it, in any zone.
        if key = "options" then return false
        return true   ' swallow everything else while a menu is open
    end if

    ' Buttons zone: left/right move, OK activates, up returns to scrubbing
    if m.zone = "buttons"
        if key = "left"
            if m.btnIdx > 0 then m.btnIdx = m.btnIdx - 1
            restyleButtons()
            bumpOsd()
            return true
        else if key = "right"
            if m.btnIdx < m.buttons.count() - 1 then m.btnIdx = m.btnIdx + 1
            restyleButtons()
            bumpOsd()
            return true
        else if key = "OK"
            activateButton()
            return true
        else if key = "down"
            m.zone = "scrub"
            restyleButtons()
            bumpOsd()
            return true
        else if key = "up"
            return true   ' top of the OSD — swallow
        else if key = "back"
            hideOsd()
            return true
        else if key = "play"
            togglePlayPause()
            bumpOsd()
            return true
        end if
        if key = "options" then return false
        return true
    end if

    ' Scrub zone (default)
    if key = "back"
        if m.osdVisible
            hideOsd()
            return true
        end if
        exitPlayer()
        return true
    end if

    ' Skip pill has OK priority while visible
    if key = "OK" and m.skipVisible
        skipCurrentSegment()
        return true
    end if

    ' OK = pause/play immediately (Roku convention), OSD comes along
    if key = "OK" or key = "play"
        togglePlayPause()
        showOsd()
        bumpOsd()
        return true
    end if

    ' Up climbs to the controls (buttons sit above the scrubber); Down hides
    if key = "up"
        if m.osdVisible
            m.zone = "buttons"
            restyleButtons()
            bumpOsd()
        else
            showOsd()
            m.zone = "buttons"
            restyleButtons()
        end if
        return true
    end if

    if key = "down"
        if m.osdVisible
            hideOsd()
        else
            showOsd()
        end if
        return true
    end if

    if key = "left" or key = "rewind" or key = "replay"
        seekBy(-1)
        showOsd()
        return true
    end if

    if key = "right" or key = "fastforward"
        seekBy(1)
        showOsd()
        return true
    end if

    return false
end function
