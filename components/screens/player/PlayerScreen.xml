<?xml version="1.0" encoding="UTF-8" ?>
<component name="PlayerScreen" extends="Group">
    <interface>
        <field id="itemData" type="assocarray" onChange="onItemDataChanged" />
        <field id="playAction" type="string" value="play" />
        <!-- Set when this playback is a channel rather than a chosen item.
             Suppresses all watch-state reporting and rolls over at the end. -->
        <field id="channelContext" type="assocarray" />
        <field id="done" type="boolean" alwaysNotify="true" />
        <!-- Called by MainScene under memory pressure; drops the trickplay
             sheet unless the viewer is actually scrubbing. -->
        <function name="releaseArtwork" />
        <!-- A reminder is tuning another channel: stop without leaving. -->
        <function name="stopForHandoff" />
    </interface>
    <children>
        <Rectangle width="1920" height="1080" color="#000000" />
        <Video id="video" width="1920" height="1080" translation="[0, 0]" />

        <Label id="statusLabel" text="Loading..." color="#FFFFFF" horizAlign="center"
               vertAlign="center" width="1920" height="1080">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="32" />
        </Label>

        <!-- ============ Station bar ============
             A channel's only on-screen control: the bottom-edge mirror of
             the OSD's top bar — full width, translucent black. Logo, station,
             clock; what is on with progress; what is next; how the
             remote drives a channel. Children are placed absolutely. -->
        <Group id="stationBanner" visible="false">
            <Rectangle width="1920" height="300" color="#00000066" translation="[0, 780]" />
            <Poster id="bannerLogo" width="96" height="96" loadDisplayMode="scaleToFit" translation="[80, 804]" />
            <Label id="bannerName" text="" color="#FFFFFF" width="1000" maxLines="1" translation="[196, 808]">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="36" />
            </Label>
            <Label id="bannerDescription" text="" color="#BFBFBF" width="1000" maxLines="1"
                   ellipsizeOnBoundary="true" translation="[196, 858]">
                <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="22" />
            </Label>
            <Label id="bannerClock" text="" color="#FFFFFF" width="300" horizAlign="right" translation="[1540, 808]">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="36" />
            </Label>
            <Label id="bannerStatus" text="" color="#8C5CC7" width="400" horizAlign="right" translation="[1440, 858]">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="20" />
            </Label>
            <Label id="bannerNow" text="" color="#FFFFFF" width="1760" maxLines="1"
                   ellipsizeOnBoundary="true" translation="[80, 914]">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="30" />
            </Label>
            <Rectangle id="bannerTrack" width="1400" height="6" color="#FFFFFF40" translation="[80, 972]" />
            <Rectangle id="bannerFill" width="0" height="6" color="#8C5CC7" translation="[80, 972]" />
            <Label id="bannerTimes" text="" color="#BFBFBF" width="340" horizAlign="right" translation="[1500, 960]">
                <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="22" />
            </Label>
            <Label id="bannerNext" text="" color="#BFBFBF" width="1000" maxLines="1"
                   ellipsizeOnBoundary="true" translation="[80, 1004]">
                <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="26" />
            </Label>
            <Label id="bannerHints" text="▲▼ channels     ◀▶ guide     OK  info     hold OK  options" color="#8C8C8C"
                   width="900" horizAlign="right" translation="[940, 1008]">
                <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="20" />
            </Label>
        </Group>
        <!-- The station's mark, faint in the corner while the bar is down:
             white logo stacked over the name in small type, centred on one
             column. -->
        <Group id="stationBug" opacity="0.45" translation="[-38, 12]" visible="false">
            <Poster id="stationBugLogo" width="72" height="72" loadDisplayMode="scaleToFit" translation="[84, 0]" />
            <Label id="stationBugName" text="" color="#FFFFFF" width="240" horizAlign="center" maxLines="1" translation="[0, 78]">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="16" />
            </Label>
        </Group>
        <!-- ============ Up Next (a break between slots) ============ -->
        <Group id="upNextCard" visible="false">
            <Rectangle width="1920" height="1080" color="#000000F0" />
            <Poster id="upNextLogo" width="120" height="120" loadDisplayMode="scaleToFit" translation="[900, 230]" />
            <Label id="upNextStation" text="" color="#FFFFFF" width="1920" horizAlign="center" translation="[0, 370]">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="40" />
            </Label>
            <Label id="upNextWhen" text="" color="#8C5CC7" width="1920" horizAlign="center" translation="[0, 470]">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="26" />
            </Label>
            <Label id="upNextTitle" text="" color="#FFFFFF" width="1600" horizAlign="center" maxLines="2" wrap="true" translation="[160, 520]">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="56" />
            </Label>
            <Label id="upNextDetail" text="" color="#BFBFBF" width="1600" horizAlign="center" maxLines="1" ellipsizeOnBoundary="true" translation="[160, 660]">
                <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="30" />
            </Label>
            <Label id="upNextCountdown" text="" color="#D9D9D9" width="1920" horizAlign="center" translation="[0, 740]">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="32" />
            </Label>
            <Label id="upNextClock" text="" color="#B3B3B3" width="300" horizAlign="right" translation="[1540, 980]">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="30" />
            </Label>
        </Group>
        <Timer id="bannerTimer" duration="6" repeat="false" />
        <!-- OK held this long opens the options (subtitles, audio, view mode) instead of the info bar. -->
        <Timer id="okHoldTimer" duration="0.6" repeat="false" />

        <!-- ============ OSD overlay ============
             No child ever takes remote focus — the screen tracks a virtual
             highlight (zone/btnIdx/menuIdx) and styles nodes itself. -->
        <Group id="osd" opacity="0" visible="false">
            <!-- Top scrim + info bar -->
            <Poster uri="pkg:/images/player_scrim_top.png" width="1920" height="280" translation="[0,0]" />
            <Poster id="osdLogo" width="360" height="72" loadDisplayMode="scaleToFit"
                    translation="[80,30]" visible="false" />
            <Poster id="osdChannelCircle" width="80" height="80" translation="[80,30]" visible="false" />
            <Label id="osdChannelName" text="" color="#E6FFFFFF" width="1400" maxLines="1" translation="[180,52]" visible="false">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="30" />
            </Label>
            <Label id="osdTitle" text="" color="#FFFFFF" width="1500" maxLines="1" translation="[80,44]">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="42" />
            </Label>
            <Label id="osdSubtitle" text="" color="#99FFFFFF" width="1500" maxLines="1" translation="[80,104]">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="26" />
            </Label>
            <Label id="osdClock" text="" color="#FFFFFF" width="240" horizAlign="right"
                   translation="[1600,44]">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="34" />
            </Label>
            <Label id="osdFinishes" text="" color="#80FFFFFF" width="400" horizAlign="right"
                   translation="[1440,96]">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="24" />
            </Label>
            <Group id="osdChips" translation="[80,146]" />

            <!-- Bottom scrim + transport -->
            <Poster uri="pkg:/images/player_scrim_bottom.png" width="1920" height="340" translation="[0,740]" />

            <!-- Button row (virtual highlight) -->
            <Group id="osdBtnRow" translation="[80, 876]" />

            <!-- Scrubber -->
            <Rectangle id="osdScrubTrack" width="1760" height="6" color="#40FFFFFF" translation="[80,1000]" />
            <Rectangle id="osdScrubFill" width="0" height="6" color="#8C5CC7" translation="[80,1000]" />
            <Group id="osdChapterTicks" translation="[80,997]" />
            <Rectangle id="osdScrubKnob" width="8" height="22" color="#8C5CC7" translation="[76,992]" />
            <Label id="osdElapsed" text="0:00" color="#FFFFFF" width="200" translation="[80,1022]">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="26" />
            </Label>
            <Label id="osdRemaining" text="0:00" color="#FFFFFF" width="200" horizAlign="right" translation="[1640,1022]">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="26" />
            </Label>
            <Poster id="osdPlayPause" width="44" height="44" translation="[938,930]" uri="pkg:/images/osd_pause.png" visible="false" />
        </Group>

        <!-- Skip Intro/Credits pill (Intro Skipper) — independent of the OSD -->
        <Group id="skipPill" visible="false">
            <Poster uri="pkg:/images/btn_dark.9.png" width="300" height="56" translation="[1540,980]" />
            <Label id="skipPillLabel" text="" color="#FFFFFF" width="300" height="56"
                   horizAlign="center" vertAlign="center" translation="[1540,980]">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="25" />
            </Label>
        </Group>

        <!-- Popup menu (subtitles / audio / quality / view mode) -->
        <Group id="osdMenu" visible="false">
            <Poster id="osdMenuBg" uri="pkg:/images/card_r16.9.png" width="560" height="400" translation="[80,400]" />
            <Label id="osdMenuTitle" text="" color="#FFFFFF" width="480" translation="[116,430]">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="30" />
            </Label>
            <Group id="osdMenuRows" translation="[104,486]" />
        </Group>

        <JellyfinApi id="apiTask" />
        <!-- Trick-play thumbnail (cert 4.7). Roku's built-in trick play needs a
             BIF file and Jellyfin serves none, only JPEG tile sheets -- so the
             frame is drawn here: clippingRect is sized to ONE tile, and the
             Poster behind it holds the whole sheet, shifted so the wanted tile
             lands inside the window. Both are sized at runtime from the item's
             own Trickplay metadata. -->
        <Group id="trickplayGroup" visible="false">
            <Rectangle id="trickplayBorder" color="#000000CC" />
            <Poster id="trickplayImage" />
        </Group>
        <Label id="trickplayTime" text="" color="#FFFFFF" horizAlign="center"
               visible="false">
            <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="22" />
        </Label>

        <Timer id="progressTimer" repeat="true" duration="5" />
        <Timer id="osdTimer" repeat="false" duration="5" />
        <Timer id="clockTimer" repeat="true" duration="15" />
        <Timer id="seekTimer" repeat="false" duration="0.5" />
        <!-- Cert 4.8: the viewer can flip Roku's global caption setting from the
             system "*" overlay without ever leaving playback, so the app has to
             notice out-of-band. GetCaptionsMode() is a cheap local read. -->
        <Timer id="captionTimer" repeat="true" duration="2" />
        <!-- Cert 3.4: a stream that never starts used to sit on "Buffering..."
             forever. One-shot watchdog, (re)armed whenever we start waiting on
             a stream and stopped as soon as it plays. -->
        <Timer id="bufferTimer" repeat="false" duration="30" />
        <Animation id="osdAnim" duration="0.25" easeFunction="outQuad">
            <FloatFieldInterpolator id="osdInterp" key="[0.0,1.0]" keyValue="[0.0,1.0]" fieldToInterp="osd.opacity" />
        </Animation>
    </children>
</component>
