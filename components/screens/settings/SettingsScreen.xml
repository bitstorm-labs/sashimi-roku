<?xml version="1.0" encoding="UTF-8" ?>
<component name="SettingsScreen" extends="Group">
    <interface>
        <field id="signOut" type="boolean" value="false" alwaysNotify="true" />
        <!-- Requests row: MainScene pushes the Seerr account screen. -->
        <field id="openSeerr" type="boolean" alwaysNotify="true" />
        <!-- Plex row (the Watchlist's Plex sync): MainScene pushes the
             Connect Plex code screen. -->
        <field id="connectPlex" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <!-- Background gradient (matches Home) -->
        <Poster uri="pkg:/images/bg_gradient.png" width="1920" height="1080" />

        <!-- Section header -->
        <Label
            text="Settings"
            color="#FFFFFF"
            translation="[560, 124]"
        >
            <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="40" />
        </Label>

        <!-- Rows built in code (tvOS SettingsView: maxWidth 800 cards) -->
        <Group id="rowsGroup" translation="[560, 196]" />

        <!-- Sign-out revokes the server session before clearing local state.
             This screen had no task node, so the revoke dispatch dereferenced
             invalid and aborted the handler before it cleared credentials. -->
        <JellyfinApi id="apiTask" />
        <!-- The Watchlist's state for the Plex row; one request at a time. -->
        <JellyfinApi id="wlTask" />
    </children>
</component>
