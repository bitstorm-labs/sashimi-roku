<?xml version="1.0" encoding="UTF-8" ?>
<!-- Talks to the person's Seerr server (and plex.tv for PIN sign-in). One per
     screen, long-lived, like JellyfinApi: `request` in, `response` out. The
     session cookie lives in the registry and only ever leaves this task in a
     Cookie header; nothing here logs a cookie, token or password. -->
<component name="SeerrTask" extends="Task">
    <interface>
        <field id="request" type="assocarray" alwaysNotify="true" />
        <field id="response" type="assocarray" alwaysNotify="true" />
    </interface>
</component>
