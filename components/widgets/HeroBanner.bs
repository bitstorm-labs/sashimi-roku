import "pkg:/source/utils/ImageUrl.bs"
import "pkg:/source/utils/YouTube.bs"

sub init()
    m.tmdbLogo = m.top.findNode("tmdbLogo")
    m.heroImage = m.top.findNode("heroImage")
    m.heroFadeLeft = m.top.findNode("heroFadeLeft")
    ' Snap the left fade to the fitted image's actual left edge per image —
    ' the decoded bitmap size is only known once the poster loads.
    m.heroImage.observeFieldScoped("loadStatus", "onHeroImageStatus")
    m.heroTitle = m.top.findNode("heroTitle")
    m.heroSubtitle = m.top.findNode("heroSubtitle")
    m.heroMeta = m.top.findNode("heroMeta")
    m.ytIcon = m.top.findNode("ytIcon")
    m.ytLabel = m.top.findNode("ytLabel")
    m.heroOverview = m.top.findNode("heroOverview")
    m.dotsGroup = m.top.findNode("dotsGroup")
    m.dotFill = m.top.findNode("dotFill")
    m.dotAnim = m.top.findNode("dotAnim")
    m.focusTop = m.top.findNode("focusTop")
    m.focusBottom = m.top.findNode("focusBottom")
    m.focusLeft = m.top.findNode("focusLeft")
    m.focusRight = m.top.findNode("focusRight")
    m.advanceTimer = m.top.findNode("advanceTimer")

    m.items = []
    m.currentIndex = 0
    m.dotsX = 80
    m.dotsY = 470
    m.hasFocus = false
    m.dotPositions = []

    ' Hero rendered at 84%, anchored top-CENTER so it stays
    ' horizontally centered on screen (the banner spans 1820 with the group
    ' at x=50, so local x=910 is the screen's midline). Top edge stays put;
    ' the focus pop multiplies on top of this base.
    m.baseScale = 0.84
    m.top.scaleRotateCenter = [910, 0]
    m.top.scale = [m.baseScale, m.baseScale]

    m.advanceTimer.observeFieldScoped("fire", "onAdvanceTimer")

    ' The banner is never destroyed (MainScene caches the home screen for the
    ' whole session), so the 6s rotator has to be stopped explicitly whenever
    ' the banner is off screen — otherwise it pulls a 1280px backdrop and
    ' rebuilds every dot node through an entire movie.
    m.top.observeField("visible", "applyAutoAdvance")

    m.top.observeField("focusedChild", "onFocusChanged")
end sub

' Right-align the fitted image and snap the left fade to its left edge (tvOS
' parity: the backdrop hugs the banner's right edge). The Poster decodes at
' loadWidth/loadHeight preserving aspect, so bitmapWidth after "ready" is the
' fitted width — but scaleToFit CENTERS that image in the 1274-wide region,
' leaving ~182px of dead space on BOTH sides of a 16:9 backdrop. Translate
' the Poster so the fitted image's right edge lands at the banner's right
' edge (1820): tx = 1820 - (1274 + fittedW)/2 (546 for full-region art), and
' put the fade at the image's resulting left edge (1820 - fittedW), 2px
' overlap for decode rounding.
sub onHeroImageStatus()
    if m.heroImage.loadStatus <> "ready"
        ' New image loading: park both at the region defaults so stale
        ' positions from the previous slide can't sit mid-image.
        m.heroImage.translation = [546, 0]
        m.heroFadeLeft.translation = [546, 0]
        return
    end if
    bw = m.heroImage.bitmapWidth
    if bw = invalid or bw <= 0 or bw > 1274 then bw = 1274
    m.heroImage.translation = [1820 - Int((1274 + bw) / 2), 0]
    fadeX = 1820 - bw - 2
    if fadeX < 546 then fadeX = 546
    m.heroFadeLeft.translation = [fadeX, 0]
end sub

sub onContentChanged()
    contentNode = m.top.content
    if contentNode = invalid then return

    m.items = []
    for i = 0 to contentNode.getChildCount() - 1
        child = contentNode.getChild(i)
        item = {}
        if child.itemJson <> invalid and child.itemJson <> ""
            item = ParseJSON(child.itemJson)
            ' Truncated/garbled JSON returns invalid; dereferencing it here is a
            ' render-thread crash, and an empty hero slide is survivable.
            if type(item) <> "roAssociativeArray" then item = {}
        end if
        item.title = child.title
        item.description = child.description
        item.HDPosterUrl = child.HDPosterUrl
        m.items.push(item)
    end for

    buildDots(0)
    m.currentIndex = 0
    showItem(0)
    applyAutoAdvance()
end sub

' Single gate for the rotator: run only when this node is visible, the owning
' screen says it is on screen, and there is more than one slide to rotate.
sub applyAutoAdvance()
    if m.items = invalid then return
    if m.top.visible and m.top.autoAdvance and m.items.count() > 1
        ' The progress fill is keyed to the timer's 6s, so both restart together
        ' or the dot finishes filling long before the slide changes.
        m.dotAnim.control = "stop"
        m.dotFill.width = 0
        m.dotAnim.control = "start"
        m.advanceTimer.control = "stop"
        m.advanceTimer.control = "start"
    else
        m.advanceTimer.control = "stop"
        m.dotAnim.control = "stop"
    end if
end sub

' tvOS page indicators: left-aligned row — active track 48x5, others 12x5.
' Viewed dots at 70% white, upcoming at 30%. Active dot fills white over the 6s slide.
sub buildDots(activeIndex as integer)
    ' Clear existing dots
    while m.dotsGroup.getChildCount() > 0
        m.dotsGroup.removeChildIndex(0)
    end while
    m.dotPositions = []

    if m.items.count() <= 1
        m.dotFill.visible = false
        return
    end if
    m.dotFill.visible = true

    x = 0
    for i = 0 to m.items.count() - 1
        dot = CreateObject("roSGNode", "Rectangle")
        dot.height = 5
        dot.color = "#FFFFFF"
        dot.translation = [x, 0]
        if i = activeIndex
            dot.width = 48
            dot.opacity = 0.3   ' track; fill rect animates on top
            m.dotPositions.push(x)
            x += 48
        else
            dot.width = 12
            if i < activeIndex
                dot.opacity = 0.7   ' viewed
            else
                dot.opacity = 0.3   ' upcoming
            end if
            m.dotPositions.push(x)
            x += 12
        end if
        x += 10
        m.dotsGroup.appendChild(dot)
    end for
end sub

' Center the text block vertically in the 512px banner and the page dots
' horizontally. The XML pins fixed slots (title y140, an episode-subline slot
' at y292, meta/overview low at y338/386); a movie has no subline, so that slot
' is dead space and the whole block reads bottom-heavy and uncentered. Stack
' only the rows actually present and center the group; center the dots too.
sub reflowHeroText()
    bannerH = 512
    leftX = 80

    h1 = Int(m.heroTitle.boundingRect().height)
    if h1 <= 0 then h1 = 76

    hasSub = (m.heroSubtitle.text <> "")
    hasOverview = (m.heroOverview.text <> "")

    subGap = 0 : subH = 0
    if hasSub
        subGap = 10
        subH = Int(m.heroSubtitle.boundingRect().height)
        if subH <= 0 then subH = 34
    end if
    metaGap = 16 : metaH = 24
    ovGap = 0 : ovH = 0
    if hasOverview
        ovGap = 16
        ovH = Int(m.heroOverview.boundingRect().height)
        if ovH <= 0 then ovH = 58
    end if

    blockH = h1 + subGap + subH + metaGap + metaH + ovGap + ovH
    titleY = Int((bannerH - blockH) / 2)
    if titleY < 44 then titleY = 44

    m.heroTitle.translation = [leftX, titleY]
    y = titleY + h1

    if hasSub
        y += subGap
        m.heroSubtitle.translation = [leftX, y]
        y += subH
    end if

    y += metaGap
    metaY = y
    ' Preserve each meta element's X (set by the rating/YouTube branch); move Y.
    ' The TMDB logo sits +2 so its optical center lands on the meta centerline.
    mt = m.heroMeta.translation : m.heroMeta.translation = [mt[0], metaY]
    lt = m.tmdbLogo.translation : m.tmdbLogo.translation = [lt[0], metaY + 2]
    it = m.ytIcon.translation : m.ytIcon.translation = [it[0], metaY]
    yl = m.ytLabel.translation : m.ytLabel.translation = [yl[0], metaY]
    y += metaH

    if hasOverview
        y += ovGap
        m.heroOverview.translation = [leftX, y]
    end if

    ' Page dots: horizontally centered in the banner, fixed near the bottom
    ' (a rotator's pagination stays put across slides regardless of text height).
    m.dotsY = 470
    totalW = 0
    if m.items.count() > 1 then totalW = 48 + 22 * (m.items.count() - 1)
    m.dotsX = Int((1820 - totalW) / 2)
    m.dotsGroup.translation = [m.dotsX, m.dotsY]
end sub

sub showItem(index as integer)
    if index < 0 or index >= m.items.count() then return

    item = m.items[index]

    ' Set backdrop image (tvOS requests large, fits right 70%)
    itemId = ""
    if item.Id <> invalid then itemId = item.Id
    if YT.isItem(item, false, m.global.youtubePaths) and itemId <> ""
        ' tvOS YouTube hero: the video's own Primary thumbnail first
        m.heroImage.uri = ImageUrl.primary(itemId, 1280)
    else if item.BackdropImageTags <> invalid and item.BackdropImageTags.count() > 0
        m.heroImage.uri = ImageUrl.backdrop(itemId, 1280)
    else if item.ParentBackdropItemId <> invalid
        m.heroImage.uri = ImageUrl.backdrop(item.ParentBackdropItemId, 1280)
    else if item.SeriesId <> invalid and item.SeriesId <> ""
        m.heroImage.uri = ImageUrl.backdrop(item.SeriesId, 1280)
    else if item.HDPosterUrl <> invalid and item.HDPosterUrl <> ""
        m.heroImage.uri = item.HDPosterUrl
    else
        ' Every source above is optional, and the Poster is reused across
        ' slides — without this the previous item's artwork sits behind the
        ' new title.
        m.heroImage.uri = ""
    end if

    ' Detect YouTube content (unified helper; library-membership aware)
    isYouTube = YT.isItem(item, false, m.global.youtubePaths)

    ' Title (tvOS displayTitle: series/channel name for episodes, else item name)
    title = ""
    if item.SeriesName <> invalid and item.SeriesName <> ""
        title = item.SeriesName
        if isYouTube then title = YT.cleanTitle(title)
    else if item.Name <> invalid
        title = item.Name
    end if
    m.heroTitle.text = title

    ' Episode subline (tvOS: "S{n} E{n} • {name}" / YouTube: video title)
    subtitle = ""
    if isYouTube
        if item.Name <> invalid then subtitle = item.Name
    else if item.SeriesName <> invalid and item.SeriesName <> ""
        if item.ParentIndexNumber <> invalid and item.IndexNumber <> invalid
            subtitle = "S" + str(item.ParentIndexNumber).Trim() + " E" + str(item.IndexNumber).Trim()
            if item.Name <> invalid then subtitle += " " + Chr(8226) + " " + item.Name
        else if item.Name <> invalid
            subtitle = item.Name
        end if
    end if
    m.heroSubtitle.text = subtitle

    ' Metadata row (tvOS: TMDB logo + rating, critic %, year + runtime;
    ' YouTube: red badge + date — TMDB/critic scores never apply to videos)
    meta = ""
    if not isYouTube
        if item.CommunityRating <> invalid
            rating = Int(item.CommunityRating * 10) / 10.0
            meta += str(rating).Trim()
        end if
        if item.CriticRating <> invalid
            if meta <> "" then meta += "    "
            meta += str(item.CriticRating).Trim() + "%"
        end if
    end if
    if isYouTube
        ' "YouTube" itself is rendered by ytLabel (brand red); only the date
        ' goes through the shared meta label.
        if item.PremiereDate <> invalid and Len(item.PremiereDate) >= 10
            meta += YT.formatDate(item.PremiereDate)
        end if
    else
        if item.ProductionYear <> invalid
            if meta <> "" then meta += "    "
            meta += str(item.ProductionYear).Trim()
        end if
        if item.RunTimeTicks <> invalid
            ' Double divisor: ticks are LongInteger and 32-bit Float can't hold
            ' 7.2e10 exactly, so a plain divisor can truncate a 120m film to 119.
            minutes = Int(item.RunTimeTicks / 600000000.0#)
            if minutes > 0
                hours = Int(minutes / 60)
                mins = minutes mod 60
                if meta <> "" then meta += "    "
                if hours > 0
                    meta += str(hours).Trim() + "h " + str(mins).Trim() + "m"
                else
                    meta += str(mins).Trim() + "m"
                end if
            end if
        end if
    end if
    m.heroMeta.text = meta
    if isYouTube
        ' YouTube badge: play icon + red "YouTube", then the date after it —
        ' measured, since the wordmark width depends on the font.
        m.tmdbLogo.visible = false
        m.ytIcon.visible = true
        m.ytLabel.visible = true
        m.heroMeta.translation = [126 + Int(m.ytLabel.boundingRect().width) + 16, 338]
    else if item.CommunityRating <> invalid
        ' Show TMDB logo when we have a community rating (tvOS: logo before number)
        m.ytIcon.visible = false
        m.ytLabel.visible = false
        m.tmdbLogo.visible = true
        m.heroMeta.translation = [126, 338]
    else
        m.ytIcon.visible = false
        m.ytLabel.visible = false
        m.tmdbLogo.visible = false
        m.heroMeta.translation = [80, 338]
    end if

    ' Overview (tvOS: 22pt @75% white, 2 lines)
    overview = ""
    if item.Overview <> invalid and item.Overview <> ""
        overview = item.Overview
    end if
    m.heroOverview.text = overview

    ' Rebuild dots for this index, center the text block + dots, then restart
    ' the active-dot progress fill (reflow sets m.dotsX / m.dotsY for the fill).
    buildDots(index)
    reflowHeroText()
    if m.items.count() > 1 and index < m.dotPositions.count()
        m.dotAnim.control = "stop"
        m.dotFill.width = 0
        m.dotFill.translation = [m.dotsX + m.dotPositions[index], m.dotsY]
        m.dotAnim.control = "start"
    end if
end sub

sub onAdvanceTimer()
    if m.items.count() = 0 then return
    m.currentIndex = (m.currentIndex + 1) mod m.items.count()
    showItem(m.currentIndex)
end sub

sub onFocusChanged()
    m.hasFocus = m.top.isInFocusChain()
    if m.hasFocus
        ' tvOS: accent stroke @60% + scale 1.01
        m.focusTop.opacity = 0.6
        m.focusBottom.opacity = 0.6
        m.focusLeft.opacity = 0.6
        m.focusRight.opacity = 0.6
        ' Focus pop multiplies the 70% base — assigning 1.01 outright would
        ' silently undo the scale-down (the hero is focused on load).
        m.top.scale = [m.baseScale * 1.01, m.baseScale * 1.01]
    else
        m.focusTop.opacity = 0.0
        m.focusBottom.opacity = 0.0
        m.focusLeft.opacity = 0.0
        m.focusRight.opacity = 0.0
        m.top.scale = [m.baseScale, m.baseScale]
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if press
        if key = "right"
            if m.items.count() > 0
                m.currentIndex = (m.currentIndex + 1) mod m.items.count()
                showItem(m.currentIndex)
                applyAutoAdvance()
            end if
            return true
        else if key = "left"
            if m.items.count() > 0
                m.currentIndex = m.currentIndex - 1
                if m.currentIndex < 0 then m.currentIndex = m.items.count() - 1
                showItem(m.currentIndex)
                applyAutoAdvance()
            end if
            return true
        else if key = "OK"
            if m.currentIndex >= 0 and m.currentIndex < m.items.count()
                m.top.selectedItem = m.items[m.currentIndex]
            end if
            return true
        end if
    end if
    return false
end function
