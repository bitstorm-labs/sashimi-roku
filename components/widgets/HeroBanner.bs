import "pkg:/source/utils/YouTube.bs"

sub init()
    m.tmdbLogo = m.top.findNode("tmdbLogo")
    m.heroImage = m.top.findNode("heroImage")
    m.heroFadeLeft = m.top.findNode("heroFadeLeft")
    ' Flush-right the whole (scaleToFit) backdrop and park the left-edge feather
    ' at its actual left edge once the decoded bitmap size is known.
    m.heroImage.observeFieldScoped("loadStatus", "onHeroImageStatus")
    m.heroTitle = m.top.findNode("heroTitle")
    m.heroSubtitle = m.top.findNode("heroSubtitle")
    m.heroMeta = m.top.findNode("heroMeta")
    m.heroRating = m.top.findNode("heroRating")
    m.tomatoIcon = m.top.findNode("tomatoIcon")
    m.heroCritic = m.top.findNode("heroCritic")
    m.ytIcon = m.top.findNode("ytIcon")
    m.ytLabel = m.top.findNode("ytLabel")
    m.heroOverview = m.top.findNode("heroOverview")
    m.advanceTimer = m.top.findNode("advanceTimer")

    m.items = []
    m.currentIndex = 0

    ' Ordered artwork candidates for the slide on screen, walked on load failure
    ' (see showItem / tryNextHeroUri).
    m.heroUris = []
    m.heroUriIndex = 0
    m.heroUrisDone = true

    ' Fit the 1820-wide banner into the content area right of the 136px rail
    ' (1920 - 136 = 1784 wide). Anchor to the top-LEFT (scaleRotateCenter [0,0])
    ' and scale 1784/1820 = 0.98 so the left edge butts the rail (HomeScreen
    ' translates us by railWidth) and the right edge lands on the screen edge.
    m.baseScale = 0.98
    m.top.scaleRotateCenter = [0, 0]
    m.top.scale = [m.baseScale, m.baseScale]

    m.advanceTimer.observeFieldScoped("fire", "onAdvanceTimer")

    ' The banner is never destroyed (MainScene caches the home screen for the
    ' whole session), so the 6s rotator has to be stopped explicitly whenever
    ' the banner is off screen — otherwise it keeps pulling a 1280px backdrop
    ' every 6s through an entire movie.
    m.top.observeField("visible", "applyAutoAdvance")
end sub

' Show the backdrop WHOLE (scaleToFit, no crop) and flush-right to the banner's
' right edge (= the screen edge). scaleToFit CENTERS the fitted image in the
' 1274-wide region, so offset by the pillarbox to land the image's right edge on
' 1820, and put the left-edge feather at the image's actual left edge (1820-bw).
sub onHeroImageStatus()
    if m.heroImage.loadStatus <> "ready"
        m.heroImage.translation = [546, 0]
        m.heroFadeLeft.translation = [546, 0]
        ' Jellyfin 404s an image type an item does not have, which is the normal
        ' way this chain advances — not an error worth surfacing.
        if m.heroImage.loadStatus = "failed" then tryNextHeroUri()
        return
    end if
    bw = m.heroImage.bitmapWidth
    if bw = invalid or bw <= 0 or bw > 1274 then bw = 1274
    m.heroImage.translation = [1820 - Int((1274 + bw) / 2), 0]
    m.heroFadeLeft.translation = [1820 - bw, 0]
end sub

' Advance to the next artwork candidate for the current slide. Terminates two
' ways and only two ways: the index runs off the end of a fixed-length list, or
' m.heroUrisDone latches. The latch matters because clearing the uri can itself
' report "failed", which would otherwise re-enter here forever.
sub tryNextHeroUri()
    if m.heroUrisDone then return

    m.heroUriIndex = m.heroUriIndex + 1
    if m.heroUriIndex < m.heroUris.count()
        m.heroImage.uri = m.heroUris[m.heroUriIndex]
        return
    end if

    ' Exhausted. No image is the correct end state — a broken or placeholder
    ' one would read as a bug, and the title block stands on its own.
    m.heroUrisDone = true
    m.heroImage.uri = ""
end sub

' Point the Poster at the first candidate for a slide and arm the fallback.
sub startHeroImage(uris as object)
    m.heroUris = uris
    m.heroUriIndex = 0
    m.heroUrisDone = (uris.count() = 0)
    if m.heroUrisDone
        ' The Poster is reused across slides — without this the previous item's
        ' artwork sits behind the new title.
        m.heroImage.uri = ""
    else
        m.heroImage.uri = uris[0]
    end if
end sub

' Hand back the one decoded 1280px backdrop this banner holds. The latch is set
' FIRST because clearing the uri can itself report "failed", which would
' otherwise walk the candidate list on the way down and re-fetch.
sub releaseArtwork(reason as dynamic) as void
    m.heroUrisDone = true
    m.heroImage.uri = ""
end sub

' showItem re-arms the candidate walk via startHeroImage.
sub restoreArtwork(reason as dynamic) as void
    showItem(m.currentIndex)
end sub

sub onContentChanged()
    contentNode = m.top.content
    if contentNode = invalid then return

    m.items = []
    for i = 0 to contentNode.getChildCount() - 1
        child = contentNode.getChild(i)
        item = {}
        if child.itemJson <> invalid and child.itemJson <> ""
            item = ParseJSON(child.itemJson)
            ' Truncated/garbled JSON returns invalid; dereferencing it here is a
            ' render-thread crash, and an empty hero slide is survivable.
            if type(item) <> "roAssociativeArray" then item = {}
        end if
        item.title = child.title
        item.description = child.description
        item.HDPosterUrl = child.HDPosterUrl
        ' Ordered artwork candidates built by HomeScreen.heroImageCandidates.
        item.heroUris = []
        if child.heroUris <> invalid and child.heroUris <> ""
            uris = ParseJSON(child.heroUris)
            if type(uris) = "roArray" then item.heroUris = uris
        end if
        m.items.push(item)
    end for

    m.currentIndex = 0
    showItem(0)
    applyAutoAdvance()
end sub

' Single gate for the rotator: run only when this node is visible, the owning
' screen says it is on screen, and there is more than one slide to rotate.
sub applyAutoAdvance()
    if m.items = invalid then return
    if m.top.visible and m.top.autoAdvance and m.items.count() > 1
        m.advanceTimer.control = "stop"
        m.advanceTimer.control = "start"
    else
        m.advanceTimer.control = "stop"
    end if
end sub

' Center the text block vertically in the 512px banner. The XML pins fixed
' slots (title y140, an episode-subline slot at y292, meta/overview low at
' y338/386); a movie has no subline, so that slot is dead space and the whole
' block reads bottom-heavy and uncentered. Stack only the rows actually present
' and center the group.
sub reflowHeroText()
    bannerH = 512
    leftX = 40

    h1 = Int(m.heroTitle.boundingRect().height)
    if h1 <= 0 then h1 = 76

    hasSub = (m.heroSubtitle.text <> "")
    hasOverview = (m.heroOverview.text <> "")

    subGap = 0 : subH = 0
    if hasSub
        subGap = 10
        subH = Int(m.heroSubtitle.boundingRect().height)
        if subH <= 0 then subH = 34
    end if
    metaGap = 16 : metaH = 24
    ovGap = 0 : ovH = 0
    if hasOverview
        ovGap = 44
        ovH = Int(m.heroOverview.boundingRect().height)
        if ovH <= 0 then ovH = 58
    end if

    blockH = h1 + subGap + subH + metaGap + metaH + ovGap + ovH
    titleY = Int((bannerH - blockH) / 2)
    if titleY < 44 then titleY = 44

    m.heroTitle.translation = [leftX, titleY]
    y = titleY + h1

    if hasSub
        y += subGap
        m.heroSubtitle.translation = [leftX, y]
        y += subH
    end if

    y += metaGap
    metaY = y
    ' Preserve each meta element's X (set by layoutMetaRow); move Y. Icons are
    ' centered in the 24px row by their own height: the TMDB logo is drawn at
    ' h=20 so it sits +2, the tomato and the YouTube icon are drawn at 24 so
    ' they sit flush.
    mt = m.heroMeta.translation : m.heroMeta.translation = [mt[0], metaY]
    lt = m.tmdbLogo.translation : m.tmdbLogo.translation = [lt[0], metaY + 2]
    rt = m.heroRating.translation : m.heroRating.translation = [rt[0], metaY]
    tt = m.tomatoIcon.translation : m.tomatoIcon.translation = [tt[0], metaY]
    ct = m.heroCritic.translation : m.heroCritic.translation = [ct[0], metaY]
    it = m.ytIcon.translation : m.ytIcon.translation = [it[0], metaY]
    yl = m.ytLabel.translation : m.ytLabel.translation = [yl[0], metaY]
    y += metaH

    if hasOverview
        y += ovGap
        m.heroOverview.translation = [leftX, y]
    end if
end sub

' Width of a Label's TEXT.
'
' boundingRect() reports 0 for a node the render thread has not laid out yet —
' the same hazard reflowHeroText floors its heights against — and a 0 here would
' stack the next segment of the meta row on top of this one. Fall back to a
' rough advance-width estimate instead: all three labels measured by
' layoutMetaRow are Inter-Medium 22, whose glyphs advance ~12px.
'
' Callers must not give these labels an explicit `width` in XML — a Label with
' a width set reports the FIELD width here, not the text's.
function labelWidth(label as object) as integer
    w = Int(label.boundingRect().width)
    if w > 0 then return w
    ' ~13px is a digit's advance at this size, and digits are the widest glyphs
    ' in "6.6" / "54%" — so the estimate errs high, leaving a small gap rather
    ' than an overlap.
    return Len(label.text) * 13
end function

' Lay the metadata row out left to right: [TMDB logo] [rating] [tomato]
' [critic%] [year + runtime]. tvOS renders the two ratings as icon/value pairs
' (HomeView: the tomato emoji then the percentage), and a SceneGraph Label
' cannot hold an inline image, so they are separate nodes here.
'
' Every segment starts where the previous one actually ENDS, measured — the
' value widths change per item ("6.6" vs "10", "54%" vs "100%"), so a fixed
' offset either overlaps or leaves a hole. Only Y is nominal here; reflowHeroText
' runs after this and moves the whole row onto the centered text block.
sub layoutMetaRow(isYouTube as boolean, hasCommunity as boolean, hasCritic as boolean)
    metaY = 338
    leftX = 40
    ' Icon column is 34 wide (TMDB logo, YouTube glyph) with a 12px gap.
    iconRun = 46
    ' The tomato is narrower: 24 wide, same 8px optical gap as the detail screen.
    tomatoRun = 32
    ' Gap between one icon/value pair and whatever follows it, matching the
    ' four-space run the flat string used between segments.
    segGap = 24

    ' Ratings and the YouTube badge are mutually exclusive: a video never has a
    ' TMDB or critic score, and a movie never wears the badge.
    m.ytIcon.visible = isYouTube
    m.ytLabel.visible = isYouTube
    m.tmdbLogo.visible = hasCommunity and not isYouTube
    m.heroRating.visible = m.tmdbLogo.visible
    m.tomatoIcon.visible = hasCritic and not isYouTube
    m.heroCritic.visible = m.tomatoIcon.visible

    if isYouTube
        ' Play icon + the red wordmark (its width depends on the font, so it is
        ' measured too), then the publish date.
        m.heroMeta.translation = [leftX + iconRun + labelWidth(m.ytLabel) + 16, metaY]
        return
    end if

    x = leftX
    if hasCommunity
        m.tmdbLogo.translation = [x, metaY + 2]
        m.heroRating.translation = [x + iconRun, metaY]
        x += iconRun + labelWidth(m.heroRating) + segGap
    end if
    if hasCritic
        m.tomatoIcon.translation = [x, metaY]
        m.heroCritic.translation = [x + tomatoRun, metaY]
        x += tomatoRun + labelWidth(m.heroCritic) + segGap
    end if
    ' With neither rating this lands back on leftX, which is where the year sat
    ' before any of this existed.
    m.heroMeta.translation = [x, metaY]
end sub

sub showItem(index as integer)
    if index < 0 or index >= m.items.count() then return

    item = m.items[index]

    ' Backdrop (tvOS requests large, fits right 70%). The ordered candidate
    ' list comes from the content node; the Poster walks it on load failure.
    uris = []
    if item.heroUris <> invalid and type(item.heroUris) = "roArray" then uris = item.heroUris
    if uris.count() = 0 and item.HDPosterUrl <> invalid and item.HDPosterUrl <> ""
        ' Content assembled by something other than HomeScreen.
        uris = [item.HDPosterUrl]
    end if
    startHeroImage(uris)

    ' Detect YouTube content (unified helper; library-membership aware)
    isYouTube = YT.isItem(item, false, m.global.youtubePaths)

    ' Title (tvOS displayTitle: series/channel name for episodes, else item name)
    title = ""
    if item.SeriesName <> invalid and item.SeriesName <> ""
        title = item.SeriesName
        if isYouTube then title = YT.cleanTitle(title)
    else if item.Name <> invalid
        title = item.Name
        ' A slide can BE a channel: /Items/Latest groups a run of new episodes
        ' into their Series, so the Pinchflat " - Videos" suffix has to be
        ' stripped here too, not only off an episode's SeriesName.
        if isYouTube then title = YT.cleanTitle(title)
    end if
    m.heroTitle.text = title

    ' Episode subline (tvOS: "S{n} E{n} • {name}" / YouTube: video title). Only
    ' an episode gets one — tvOS gates the whole subline on type == .episode.
    ' Without the SeriesName gate a grouped channel printed its own name twice,
    ' as the title AND the subline.
    subtitle = ""
    if item.SeriesName <> invalid and item.SeriesName <> ""
        if isYouTube
            if item.Name <> invalid then subtitle = item.Name
        else if item.ParentIndexNumber <> invalid and item.IndexNumber <> invalid
            subtitle = "S" + str(item.ParentIndexNumber).Trim() + " E" + str(item.IndexNumber).Trim()
            if item.Name <> invalid then subtitle += " " + Chr(8226) + " " + item.Name
        else if item.Name <> invalid
            subtitle = item.Name
        end if
    end if
    m.heroSubtitle.text = subtitle

    ' Metadata row (tvOS: TMDB logo + rating, tomato + critic %, year + runtime;
    ' YouTube: red badge + date — TMDB/critic scores never apply to videos).
    ' The two ratings are icon/value PAIRS and a SceneGraph Label cannot hold an
    ' inline image, so each value gets its own label and layoutMetaRow places
    ' them; only the trailing year/runtime run is still a single string.
    community = invalid
    critic = invalid
    if not isYouTube
        community = item.CommunityRating
        critic = item.CriticRating
    end if
    if community <> invalid
        m.heroRating.text = str(Int(community * 10) / 10.0).Trim()
    else
        m.heroRating.text = ""
    end if
    if critic <> invalid
        ' Int() like the detail screen — Jellyfin can hand back a float here and
        ' the two screens must not disagree about the same score.
        m.heroCritic.text = str(Int(critic)).Trim() + "%"
    else
        m.heroCritic.text = ""
    end if

    meta = ""
    if isYouTube
        ' "YouTube" itself is rendered by ytLabel (brand red); only the date
        ' goes through the shared meta label.
        if item.PremiereDate <> invalid and Len(item.PremiereDate) >= 10
            meta += YT.formatDate(item.PremiereDate)
        end if
    else
        if item.ProductionYear <> invalid
            if meta <> "" then meta += "    "
            meta += str(item.ProductionYear).Trim()
        end if
        if item.RunTimeTicks <> invalid
            ' Double divisor: ticks are LongInteger and 32-bit Float can't hold
            ' 7.2e10 exactly, so a plain divisor can truncate a 120m film to 119.
            minutes = Int(item.RunTimeTicks / 600000000.0#)
            if minutes > 0
                hours = Int(minutes / 60)
                mins = minutes mod 60
                if meta <> "" then meta += "    "
                if hours > 0
                    meta += str(hours).Trim() + "h " + str(mins).Trim() + "m"
                else
                    meta += str(mins).Trim() + "m"
                end if
            end if
        end if
    end if
    m.heroMeta.text = meta
    layoutMetaRow(isYouTube, community <> invalid, critic <> invalid)

    ' Overview (tvOS: 22pt @75% white, 2 lines)
    overview = ""
    if item.Overview <> invalid and item.Overview <> ""
        overview = item.Overview
    end if
    m.heroOverview.text = overview

    reflowHeroText()
end sub

sub onAdvanceTimer()
    if m.items.count() = 0 then return
    m.currentIndex = (m.currentIndex + 1) mod m.items.count()
    showItem(m.currentIndex)
end sub

' The hero is an ambient, non-focusable backdrop: it never enters the focus
' chain, so there is no focus-border/scale-pop handler and no key handler here.
' It rotates on the auto-advance timer only.
