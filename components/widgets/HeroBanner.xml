<?xml version="1.0" encoding="UTF-8" ?>
<component name="HeroBanner" extends="Group">
    <interface>
        <field id="content" type="node" onChange="onContentChanged" />
        <field id="selectedItem" type="assocarray" alwaysNotify="true" />
        <!-- Owning screen's shutter for the rotator: this node's own `visible`
             stays true when the *screen* is hidden (SceneGraph doesn't
             propagate it), so the screen has to say so explicitly. -->
        <field id="autoAdvance" type="boolean" value="true" onChange="applyAutoAdvance" />
    </interface>
    <children>
        <!-- Full-bleed banner (no rounded card mask): flush to the top/right
             screen edges, blended into the page by the bottom fade and the
             scroll dim scrim. A rounded mask here read as an off-centre card. -->
        <Group id="bannerMask">
            <!-- No solid background: the page gradient shows through the text
                 area (tvOS parity), so there is no black rectangle whose edges
                 would show as hard lines against the slightly-lighter page. -->

            <!-- Backdrop shown WHOLE (scaleToFit, no crop — never zooms in and
                 chops heads off the top/bottom), flush-right to the banner's
                 right edge (which now = the screen edge). onHeroImageStatus
                 right-aligns it per image and parks the left feather at its
                 actual left edge. -->
            <Poster
                id="heroImage"
                width="1274"
                height="512"
                loadWidth="1274"
                loadHeight="512"
                loadDisplayMode="scaleToFit"
                translation="[546, 0]"
            />

            <!-- Feather the image's left edge into the page so there is no hard
                 vertical photo edge (the page shows through, tvOS parity). Repositioned to the image's
                 actual left edge in onHeroImageStatus. -->
            <Poster id="heroFadeLeft" uri="pkg:/images/hero_fade_left.png" width="340" height="512" translation="[546, 0]" />

            <!-- Bottom fade -->
            <Poster
                uri="pkg:/images/hero_fade_bottom.png"
                width="1820"
                height="140"
                translation="[0, 372]"
            />
        </Group>

        <!-- Text overlay — left, tvOS type scale -->
        <Label
            id="heroTitle"
            text=""
            color="#FFFFFF"
            width="920"
            maxLines="2"
            translation="[80, 140]"
        >
            <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="54" />
        </Label>
        <Label
            id="heroSubtitle"
            text=""
            color="#E6E6E6"
            width="820"
            maxLines="1"
            translation="[80, 292]"
        >
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="26" />
        </Label>
        <!-- TMDB logo before rating (tvOS: height 24 row). Logo drawn at h=20,
             y+2, so its optical center sits on the meta row's centerline; the
             meta label is vertically centered in the same 24px row instead of
             hanging from a baseline 2px below the logo. -->
        <Poster
            id="tmdbLogo"
            width="34"
            height="20"
            uri="pkg:/images/tmdb_logo_tv.png"
            loadDisplayMode="scaleToFit"
            translation="[40, 340]"
            visible="false"
        />
        <!-- YouTube badge replacing the TMDB/critic segments for YouTube
             items: play icon + the word "YouTube" in brand red. The date
             lives in heroMeta, repositioned after this label in showItem. -->
        <Poster
            id="ytIcon"
            width="34"
            height="24"
            uri="pkg:/images/youtube_icon.png"
            loadDisplayMode="scaleToFit"
            translation="[40, 338]"
            visible="false"
        />
        <Label
            id="ytLabel"
            text="YouTube"
            color="#E62117"
            height="24"
            vertAlign="center"
            translation="[86, 338]"
            visible="false"
        >
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="22" />
        </Label>
        <Label
            id="heroMeta"
            text=""
            color="#D9D9D9"
            width="800"
            maxLines="1"
            height="24"
            vertAlign="center"
            translation="[86, 338]"
        >
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="22" />
        </Label>
        <Label
            id="heroOverview"
            text=""
            color="#BFBFBF"
            width="820"
            maxLines="3"
            wrap="true"
            translation="[80, 386]"
        >
            <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="20" />
        </Label>

        <!-- Auto-advance timer (tvOS: 6s) -->
        <Timer id="advanceTimer" repeat="true" duration="6" />
    </children>
</component>
