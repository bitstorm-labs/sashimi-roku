sub init()
    m.scaleGroup = m.top.findNode("scaleGroup")
    m.cardBg = m.top.findNode("cardBg")
    m.posterMask = m.top.findNode("posterMask")
    m.posterImage = m.top.findNode("posterImage")
    m.cwScrim = m.top.findNode("cwScrim")
    m.playGlyph = m.top.findNode("playGlyph")
    m.remainingLabel = m.top.findNode("remainingLabel")
    m.circularMask = m.top.findNode("circularMask")
    m.circularPoster = m.top.findNode("circularPoster")
    m.circularGlow = m.top.findNode("circularGlow")
    m.focusRing = m.top.findNode("focusRing")
    m.ytBadge = m.top.findNode("ytBadge")
    m.watchedBadge = m.top.findNode("watchedBadge")
    m.newBadge = m.top.findNode("newBadge")
    m.newBadgeLabel = m.top.findNode("newBadgeLabel")
    m.progressBg = m.top.findNode("progressBg")
    m.progressBar = m.top.findNode("progressBar")
    m.qualityMask = m.top.findNode("qualityMask")
    m.qualityBg = m.top.findNode("qualityBg")
    m.qualityLabel = m.top.findNode("qualityLabel")
    m.ratingMask = m.top.findNode("ratingMask")
    m.tmdbLogo = m.top.findNode("tmdbLogo")
    m.ratingLabel = m.top.findNode("ratingLabel")
    m.titleLabel = m.top.findNode("titleLabel")
    m.subtitleLabel = m.top.findNode("subtitleLabel")
    m.channelBadgeMask = m.top.findNode("channelBadgeMask")
    m.channelBadgeBg = m.top.findNode("channelBadgeBg")
    m.channelBadgeLabel = m.top.findNode("channelBadgeLabel")
    m.channelBadgeLogo = m.top.findNode("channelBadgeLogo")
    m.livePillMask = m.top.findNode("livePillMask")
    m.liveDot = m.top.findNode("liveDot")
    m.livePillLabel = m.top.findNode("livePillLabel")
    m.synopsisLabel = m.top.findNode("synopsisLabel")
    m.countdownLabel = m.top.findNode("countdownLabel")
    m.nextLabel = m.top.findNode("nextLabel")
    m.isChannel = false
    m.itemWidth = 220
    m.posterHeight = 330
    m.isCircular = false
    m.isLandscape = false
end sub

sub onSizeChanged()
    w = m.top.width
    h = m.top.height
    if w = 0 or h = 0 then return
    m.itemWidth = w
    applyLayout()
end sub

' Lay out poster, mask, focus ring, badges and labels for the current width +
' card style. Called from BOTH onSizeChanged (width changed) and
' onItemContentChanged (card style may have changed on recycle). The landscape
' vs portrait DECISION comes from m.isLandscape (set from content), never from
' the width — a recycled portrait cell reused as a landscape CW card must not
' keep portrait state just because its onSizeChanged didn't happen to re-fire.
sub applyLayout()
    if m.isCircular then return
    w = m.itemWidth
    if w = 0 then return

    if m.isChannel
        ' Channel card artwork (tvOS: 440x280 — taller than 16:9, so the badge
        ' and the progress bar have room without crowding the frame).
        m.posterHeight = Int(w * 0.6364)
        m.posterMask.maskUri = "pkg:/images/wide_mask_r16.png"
        m.posterMask.maskSize = [w, m.posterHeight]
    else if m.isLandscape
        ' Continue Watching landscape card (tvOS: 440x248, radius 16)
        m.posterHeight = Int(w * 0.5625)
        m.posterMask.maskUri = "pkg:/images/wide_mask_r16.png"
        m.posterMask.maskSize = [w, m.posterHeight]
    else
        ' Portrait poster (tvOS: 220x330, radius 12)
        m.posterHeight = Int(w * 1.5)
        m.posterMask.maskUri = "pkg:/images/poster_mask_r12.png"
        m.posterMask.maskSize = [w, m.posterHeight]
    end if

    m.cardBg.width = w
    m.cardBg.height = m.posterHeight
    m.posterImage.width = w
    m.posterImage.height = m.posterHeight
    m.posterImage.loadWidth = w
    m.posterImage.loadHeight = m.posterHeight
    ' Ring sits at the EXACT card bounds (not larger/offset) so it can't spill
    ' past the RowList cell and get clipped ("cut off in spots"). The 9-patch
    ' stroke hugs the poster's rounded edge; it's on top of the poster and
    ' inside scaleGroup, so it scales with the card.
    m.focusRing.width = w
    m.focusRing.height = m.posterHeight
    m.focusRing.translation = [0, 0]
    m.watchedBadge.translation = [w - 35, 6]
    m.newBadge.translation = [w - 48, 6]
    m.newBadgeLabel.translation = [w - 48, 6]

    ' Scale from card center (tvOS scaleEffect anchors center)
    m.scaleGroup.scaleRotateCenter = [w / 2, m.posterHeight / 2]

    ' Re-evaluate the quality + rating chips now that portrait/landscape + size are known
    applyQualityBadge()
    applyRatingBadge()

    if m.isChannel
        ' Progress across the full width at the artwork's bottom edge, as on
        ' the other clients — no scrim, no play glyph: this is how far the
        ' CHANNEL has got, not how far this viewer has.
        m.progressBg.width = w
        m.progressBg.translation = [0, m.posterHeight - 5]
        m.progressBar.translation = [0, m.posterHeight - 5]

        m.titleLabel.horizAlign = "left"
        setLabelFont(m.titleLabel, "pkg:/fonts/Inter-Bold.ttf", 28)
        m.titleLabel.translation = [0, m.posterHeight + 14]
        m.subtitleLabel.translation = [0, m.posterHeight + 56]
        m.synopsisLabel.translation = [0, m.posterHeight + 92]
        m.synopsisLabel.width = w
        ' A wrapped 20pt line is about 38px tall on this renderer, not the ~26
        ' the font size suggests, so two lines need 76 and the footer has to
        ' clear 92 + 76. Budgeting by font size put the countdown on top of the
        ' second line of synopsis.
        m.countdownLabel.translation = [0, m.posterHeight + 178]
        m.nextLabel.translation = [w - 260, m.posterHeight + 180]
    else if m.isLandscape
        ' CW card internals (tvOS: pad H16/bottom14, progress under time-left row)
        m.cwScrim.width = w
        m.cwScrim.height = 60
        m.cwScrim.translation = [0, m.posterHeight - 60]
        m.playGlyph.translation = [16, m.posterHeight - 42]
        m.remainingLabel.translation = [42, m.posterHeight - 44]
        m.progressBg.width = w - 32
        m.progressBg.translation = [16, m.posterHeight - 19]
        m.progressBar.translation = [16, m.posterHeight - 19]
        ' Title 28 semibold left-aligned + subtitle 20 (tvOS ContinueWatchingCard)
        m.titleLabel.horizAlign = "left"
        setLabelFont(m.titleLabel, "pkg:/fonts/Inter-Bold.ttf", 28)
        m.titleLabel.translation = [0, m.posterHeight + 12]
        m.subtitleLabel.translation = [0, m.posterHeight + 52]
    else
        ' Poster: full-width progress at bottom (tvOS landscape rows only show
        ' progress on landscape cards, but resume posters keep it readable)
        m.progressBg.width = w
        m.progressBg.translation = [0, m.posterHeight - 5]
        m.progressBar.translation = [0, m.posterHeight - 5]
        ' Centered single caption (tvOS MediaPosterButton: 22 medium centered)
        m.titleLabel.horizAlign = "center"
        setLabelFont(m.titleLabel, "pkg:/fonts/Inter-Medium.ttf", 22)
        m.titleLabel.translation = [0, m.posterHeight + 12]
        m.subtitleLabel.translation = [0, m.posterHeight + 44]
    end if
    m.titleLabel.width = w
    m.subtitleLabel.width = w
end sub

sub setLabelFont(label as object, uri as string, size as integer)
    f = CreateObject("roSGNode", "Font")
    f.uri = uri
    f.size = size
    label.font = f
end sub

' Resolution chip (top-left). 4K glows Jellyfin purple; HD/SD sit on dark
' slate. Hidden for circular (channel) cards and when the setting is off.
sub applyQualityBadge()
    content = m.top.itemContent
    q = ""
    if content <> invalid and content.doesExist("quality") and content.quality <> invalid then q = content.quality
    ' Portrait posters only — landscape Continue Watching cards would place the
    ' chip over the title, and (like the Apple clients) we skip landscape.
    show = (q <> "" and not m.isCircular and not m.isLandscape and m.global.showQualityBadges = true)
    m.qualityLabel.text = q
    m.qualityLabel.visible = show
    m.qualityMask.visible = show
    if show
        bx = m.itemWidth - 52 - 8
        by = m.posterHeight - 32 - 8
        m.qualityMask.translation = [bx, by]
        m.qualityLabel.translation = [bx, by]
    end if
    if q = "4K"
        m.qualityBg.color = "#BD3EEDFF"
    else
        m.qualityBg.color = "#0A0A10C8"
    end if
end sub

' Community review rating chip (bottom-left; TMDb logo + rating). Portrait
' posters only — landscape Continue Watching cards would collide with the CW
' scrim/title, matching the quality chip's gating. Left margin mirrors the
' quality chip's right margin; sits just above the full-width progress bar.
sub applyRatingBadge()
    content = m.top.itemContent
    rating = 0.0
    if content <> invalid and content.doesExist("communityRating") and content.communityRating <> invalid then rating = content.communityRating
    ' For episode-of-a-series cards (Recently Added TV), the card shows the
    ' SERIES poster/title, so it must show the SERIES' overall rating — not the
    ' episode's — unless the user opted into episode-level ratings. seriesRating
    ' is only plumbed onto episode cards (>= 0 = series rating, may be 0 = hidden).
    if content <> invalid and not m.global.useEpisodeRatings and content.doesExist("seriesRating") and content.seriesRating <> invalid
        rating = content.seriesRating
    end if
    show = (rating > 0 and not m.isCircular and not m.isLandscape and m.global.showReviewRatings = true)
    m.ratingMask.visible = show
    m.tmdbLogo.visible = show
    m.ratingLabel.visible = show
    if show
        m.ratingLabel.text = formatRating(rating)
        bx = 8
        by = m.posterHeight - 32 - 8
        m.ratingMask.translation = [bx, by]
        m.tmdbLogo.translation = [bx + 8, by + 4]
        m.ratingLabel.translation = [bx + 8 + 34 + 4, by]
    end if
end sub

' 0-10 float to one decimal ("8.0", "7.5") without locale surprises.
function formatRating(r as float) as string
    r10 = Int(r * 10 + 0.5)
    whole = r10 \ 10
    frac = r10 mod 10
    return whole.toStr() + "." + frac.toStr()
end function

sub onItemContentChanged()
    content = m.top.itemContent
    if content = invalid then return

    m.isCircular = false
    if content.doesExist("isCircular") and content.isCircular = true
        m.isCircular = true
    end if

    ' Card style is CONTENT-driven. This handler always fires when RowList
    ' assigns content to a (possibly recycled) cell, so deriving isLandscape
    ' here — not from a width-change in onSizeChanged that may not fire for a
    ' recycled cell — is what keeps a reused portrait cell from rendering the
    ' landscape CW card with stray quality/rating chips.
    m.isLandscape = false
    if content.doesExist("cardStyle") and content.cardStyle = "landscape"
        m.isLandscape = true
    end if
    ' A channel card is landscape too, but it is not a Continue Watching card:
    ' its caption carries a synopsis and a footer, and its artwork carries no
    ' play glyph or scrim, because nothing here was half-watched.
    m.isChannel = false
    if content.doesExist("isChannel") and content.isChannel = true
        m.isChannel = true
        m.isLandscape = true
    end if
    ' Re-apply poster/mask/label sizing for the (now known) style at the current
    ' width, so the mask matches even if onSizeChanged doesn't re-fire.
    applyLayout()

    ' Reset state
    m.focusRing.opacity = 0.0
    m.ytBadge.visible = false
    m.watchedBadge.visible = false
    m.newBadge.visible = false
    m.newBadgeLabel.visible = false
    m.progressBg.visible = false
    m.progressBar.visible = false
    m.cwScrim.visible = false
    m.playGlyph.visible = false
    m.remainingLabel.visible = false
    hideChannelChrome()
    m.synopsisLabel.visible = false
    m.countdownLabel.visible = false
    m.nextLabel.visible = false
    applyQualityBadge()
    applyRatingBadge()

    ' YouTube badge on video cards. Circular cards are the channel avatars —
    ' already visibly YouTube (round + channel name), so the glyph there would
    ' just clutter the corner; the gap the user sees is the landscape Continue
    ' Watching and portrait video cards, which read as ordinary media.
    isYouTubeCard = (content.doesExist("isYouTube") and content.isYouTube = true)
    m.ytBadge.visible = (isYouTubeCard and not m.isCircular)

    if m.isCircular
        m.posterMask.visible = false
        m.circularMask.visible = true
        m.circularGlow.visible = true
        m.circularGlow.opacity = 0.0
        m.cardBg.visible = false
        m.focusRing.visible = false
        if content.HDPosterUrl <> invalid and content.HDPosterUrl <> ""
            m.circularPoster.uri = content.HDPosterUrl
        else
            m.circularPoster.uri = ""
        end if
        ' tvOS circular caption: 20 medium centered
        m.titleLabel.horizAlign = "center"
        setLabelFont(m.titleLabel, "pkg:/fonts/Inter-Medium.ttf", 20)
        m.titleLabel.translation = [0, 212]
        m.titleLabel.width = 200
        m.subtitleLabel.visible = false
    else
        m.posterMask.visible = true
        m.circularMask.visible = false
        m.circularGlow.visible = false
        m.cardBg.visible = true
        m.focusRing.visible = true
        if content.HDPosterUrl <> invalid and content.HDPosterUrl <> ""
            m.posterImage.uri = content.HDPosterUrl
        else
            m.posterImage.uri = ""
        end if
    end if

    if content.title <> invalid
        m.titleLabel.text = content.title
    else
        m.titleLabel.text = ""
    end if

    ' Subtitle only on Continue Watching (landscape) cards — tvOS posters are title-only
    if m.isLandscape and content.description <> invalid and content.description <> ""
        m.subtitleLabel.text = content.description
        m.subtitleLabel.visible = true
    else
        m.subtitleLabel.visible = false
    end if

    ' "X new" badge (tvOS: only when unplayed count > 1; supersedes watched check)
    badgeCount = 0
    if content.doesExist("badgeCount") then badgeCount = content.badgeCount
    if badgeCount >= 1
        m.newBadgeLabel.text = str(badgeCount).Trim() + " new"
        ' Size capsule to text (approx 11px/char at 19pt bold + padding)
        bw = 24 + Len(m.newBadgeLabel.text) * 11
        m.newBadge.width = bw
        m.newBadgeLabel.width = bw
        m.newBadge.translation = [m.itemWidth - bw - 6, 6]
        m.newBadgeLabel.translation = [m.itemWidth - bw - 6, 6]
        m.newBadge.visible = true
        m.newBadgeLabel.visible = true
    else if content.doesExist("isPlayed") and content.isPlayed = true
        ' Watched badge (tvOS: 29px circle, 26 circular, top-trailing)
        m.watchedBadge.visible = true
        if m.isCircular
            m.watchedBadge.width = 26
            m.watchedBadge.height = 26
            m.watchedBadge.translation = [166, 8]
        else
            m.watchedBadge.width = 29
            m.watchedBadge.height = 29
            m.watchedBadge.translation = [m.itemWidth - 35, 6]
        end if
    end if

    ' Progress bar + CW overlay
    if not m.isCircular and content.doesExist("playedPercentage")
        pct = content.playedPercentage
        if pct > 0 and pct < 100
            m.progressBg.visible = true
            m.progressBar.visible = true
            if m.isChannel
                ' Full width, and none of the Continue Watching furniture: the
                ' scrim, play glyph and overlaid time-left all say "you left off
                ' here", which is untrue of a channel. The countdown lives in
                ' the footer instead.
                m.progressBar.width = m.itemWidth * (pct / 100.0)
            else if m.isLandscape
                m.progressBar.width = (m.itemWidth - 32) * (pct / 100.0)
                m.cwScrim.visible = true
                m.playGlyph.visible = true
                if content.doesExist("remainingText") and content.remainingText <> ""
                    m.remainingLabel.text = content.remainingText
                    m.remainingLabel.visible = true
                end if
            else
                m.progressBar.width = m.itemWidth * (pct / 100.0)
            end if
        end if
    end if

    applyChannelChrome(content)
    applyChannelCaption(content)
end sub

' Synopsis and footer. Only channel cards have them; everything else leaves
' these hidden from the reset above.
sub applyChannelCaption(content as object)
    if not m.isChannel then return

    if content.doesExist("synopsis") and content.synopsis <> ""
        m.synopsisLabel.text = content.synopsis
        m.synopsisLabel.visible = true
    end if

    if content.doesExist("remainingText") and content.remainingText <> ""
        m.countdownLabel.text = content.remainingText
        m.countdownLabel.visible = true
    end if

    if content.doesExist("nextTitle") and content.nextTitle <> ""
        m.nextLabel.text = "NEXT  >  " + content.nextTitle
        m.nextLabel.visible = true
    end if
end sub

' Stations cards say which channel they are, and that they are live.
'
' Positioned here rather than in the XML because the card's width is only known
' once the row has been measured, and the pill has to sit against the right
' edge whatever that width turns out to be.
sub applyChannelChrome(content as object)
    if not content.doesExist("channelName") then return
    name = content.channelName
    if name = invalid or name = "" then return

    label = UCase(name)
    ' The channel number leads, the way a cable box labels a station.
    if content.doesExist("channelNumber") and content.channelNumber <> invalid and content.channelNumber > 0
        label = str(content.channelNumber).Trim() + " · " + label
    end if
    ' Roughly 11px per character at 18pt bold, plus padding. Measuring properly
    ' needs a render pass we do not have here, and the badge is a capsule, so
    ' being a few pixels generous costs nothing.
    badgeWidth = 22 + Len(label) * 11
    ' The station's white logo leads the badge when the server has one.
    logoUri = ""
    if content.doesExist("channelLogoUri") and content.channelLogoUri <> invalid then logoUri = content.channelLogoUri
    logoRoom = 0
    if logoUri <> "" then logoRoom = 28
    badgeWidth = badgeWidth + logoRoom
    if badgeWidth > m.itemWidth - 100 then badgeWidth = m.itemWidth - 100

    m.channelBadgeLabel.text = label
    m.channelBadgeMask.maskSize = [badgeWidth, 30]
    m.channelBadgeBg.width = badgeWidth
    m.channelBadgeLabel.width = badgeWidth - logoRoom
    m.channelBadgeMask.translation = [10, 10]
    m.channelBadgeLabel.translation = [10 + logoRoom, 10]
    m.channelBadgeLogo.uri = logoUri
    m.channelBadgeLogo.visible = (logoUri <> "")
    m.channelBadgeMask.visible = true
    m.channelBadgeLabel.visible = true

    isLive = (content.doesExist("isLive") and content.isLive = true)
    if isLive
        pillWidth = 74
        pillX = m.itemWidth - pillWidth - 10
        m.livePillMask.maskSize = [pillWidth, 30]
        m.livePillMask.translation = [pillX, 10]
        m.livePillBg = m.top.findNode("livePillBg")
        if m.livePillBg <> invalid then m.livePillBg.width = pillWidth
        m.liveDot.translation = [pillX + 12, 21]
        m.livePillLabel.translation = [pillX + 28, 10]
        m.livePillMask.visible = true
        m.liveDot.visible = true
        m.livePillLabel.visible = true
    end if
end sub

sub hideChannelChrome()
    if m.channelBadgeMask = invalid then return
    m.channelBadgeMask.visible = false
    m.channelBadgeLabel.visible = false
    if m.channelBadgeLogo <> invalid then m.channelBadgeLogo.visible = false
    m.livePillMask.visible = false
    m.liveDot.visible = false
    m.livePillLabel.visible = false
end sub

sub applyFocusVisuals(fp as float)
    ' No scale on row cards: RowList's fixedFocus clipping cuts scaled edges
    ' (accepted deviation from tvOS scaleEffect 1.05).
    if m.isCircular
        m.circularGlow.opacity = fp * 0.9
        return
    end if

    ' tvOS: accent stroke fades in with focus; no dimming of unfocused cards
    if fp > 0.1
        m.focusRing.opacity = fp
    else
        m.focusRing.opacity = 0.0
    end if
end sub

sub onFocusChanged()
    ' focusPercent FREEZES at its last value when the RowList itself loses
    ' focus (item 0 boots at 1.0) — itemHasFocus is the truthful gate, so a
    ' ring never shows while the hero or another node owns focus.
    if m.top.itemHasFocus
        applyFocusVisuals(m.top.focusPercent)
    else
        applyFocusVisuals(0.0)
    end if
end sub

sub onItemHasFocus()
    if m.top.itemHasFocus
        applyFocusVisuals(m.top.focusPercent)
    else
        applyFocusVisuals(0.0)
    end if
end sub

sub onRowFocusChanged()
    ' Row lost focus: clear. Row (re)gained focus: re-apply from focusPercent —
    ' RowList doesn't always re-fire focusPercent when the row regains focus,
    ' which left the focused card with no visible highlight.
    rfp = m.top.rowFocusPercent
    if rfp < 0.5
        applyFocusVisuals(0.0)
    else
        applyFocusVisuals(m.top.focusPercent)
    end if
end sub
