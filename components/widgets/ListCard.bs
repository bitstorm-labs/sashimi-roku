sub init()
    m.coverMask = m.top.findNode("coverMask")
    m.coverBg = m.top.findNode("coverBg")
    m.cover = m.top.findNode("cover")
    m.cells = []
    for i = 0 to 3
        m.cells.push(m.top.findNode("cell" + i.ToStr()))
    end for
    m.newTileLabel = m.top.findNode("newTileLabel")
    m.focusRing = m.top.findNode("focusRing")
    m.subPill = m.top.findNode("subPill")
    m.subLabel = m.top.findNode("subLabel")
    m.nameLabel = m.top.findNode("nameLabel")
    m.metaLabel = m.top.findNode("metaLabel")
    m.initialized = true
end sub

sub onContentChanged()
    if m.initialized = invalid then return
    c = m.top.itemContent
    if c = invalid then return
    isNewTile = (c.doesExist("isNewTile") and c.isNewTile = true)
    m.newTileLabel.visible = isNewTile
    urls = []
    if not isNewTile and c.doesExist("coverUrls") and c.coverUrls <> invalid then urls = c.coverUrls
    collage = (urls.count() = 4)
    if isNewTile then m.coverBg.color = "#1E1D26" else m.coverBg.color = "#2A2933"
    ' Recycled: every cell is set or cleared on every item.
    if not collage and urls.count() > 0 then m.cover.uri = urls[0] else m.cover.uri = ""
    m.cover.visible = not isNewTile and not collage
    for i = 0 to 3
        if collage then m.cells[i].uri = urls[i] else m.cells[i].uri = ""
        m.cells[i].visible = collage
    end for
    m.nameLabel.text = ""
    if not isNewTile and c.title <> invalid then m.nameLabel.text = c.title
    m.metaLabel.text = ""
    if not isNewTile and c.description <> invalid then m.metaLabel.text = c.description
    subscribed = (c.doesExist("subscribed") and c.subscribed = true)
    m.subPill.visible = subscribed
    m.subLabel.visible = subscribed
    if subscribed then m.subLabel.text = Chr(10003) + " Subscribed"
    onFocusChanged()
end sub

sub onFocusChanged()
    if m.initialized = invalid then return
    fp = m.top.focusPercent
    scale = 1.0 + fp * 0.05
    m.coverMask.scale = [scale, scale]
    m.focusRing.scale = [scale, scale]
    m.focusRing.opacity = fp * 0.9
end sub
