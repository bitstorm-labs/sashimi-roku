<?xml version="1.0" encoding="UTF-8" ?>
<!-- One line of the Requests list (Seerr web's /requests): poster, title,
     what was asked, who and when, the request's state and the title's, and
     download progress. -->
<component name="SeerrRequestItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onItemContentChanged" />
        <field id="focusPercent" type="float" onChange="onFocusChanged" />
    </interface>
    <children>
        <Poster id="bg" uri="pkg:/images/card_r16.9.png" width="1640" height="132" />
        <Poster id="focusBg" uri="pkg:/images/card_r16_focus.9.png" width="1640" height="132" opacity="0" />
        <Poster id="poster" width="80" height="120" translation="[16, 6]" loadDisplayMode="scaleToZoom" loadWidth="80" loadHeight="120" />
        <Label id="titleLabel" text="" color="#FFFFFF" width="900" maxLines="1" translation="[120, 14]">
            <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="28" />
        </Label>
        <Label id="lineLabel" text="" color="#BFBFBF" width="900" maxLines="1" translation="[120, 54]">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="22" />
        </Label>
        <Label id="subLabel" text="" color="#8C8C8C" width="900" maxLines="1" translation="[120, 88]">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="20" />
        </Label>
        <Group id="pills" translation="[1600, 22]" />
        <Rectangle id="progressBg" width="300" height="6" color="#404040FF" translation="[1300, 96]" visible="false" />
        <Rectangle id="progressBar" width="0" height="6" color="#3B6FD6FF" translation="[1300, 96]" visible="false" />
    </children>
</component>
