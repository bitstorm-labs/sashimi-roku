import "pkg:/source/utils/ImageUrl.bs"
import "pkg:/source/utils/YouTube.bs"
import "pkg:/source/utils/Registry.bs"

' Virtual-focus widget (the sidebar node holds focus; rows never do). Up/down
' roams the highlight, switching content on the move (Plex behavior); OK/right
' descends into the content screen. Focus in -> expand; focus out -> collapse.

sub init()
    m.scrim = m.top.findNode("scrim")
    m.railBg = m.top.findNode("railBg")
    m.divider = m.top.findNode("divider")
    m.railContent = m.top.findNode("railContent")
    m.logo = m.top.findNode("logo")
    m.wordmark = m.top.findNode("wordmark")
    m.navGroup = m.top.findNode("navGroup")
    m.avatarBg = m.top.findNode("avatarBg")
    m.avatarImg = m.top.findNode("avatarImg")
    m.avatarLabel = m.top.findNode("avatarLabel")
    m.accountLabel = m.top.findNode("accountLabel")
    m.accountSub = m.top.findNode("accountSub")
    m.versionLabel = m.top.findNode("versionLabel")
    m.apiTask = m.top.findNode("apiTask")

    m.railCollapsed = 136
    m.railExpanded = 470
    m.iconSize = 48
    m.rowPitch = 88
    m.iconX = 40           ' fixed so icons don't jump when expanding
    m.labelX = 118

    m.libraries = []
    m.items = []           ' [{id,kind,title,iconLocal?,iconUri?,libId?,libName?,collectionType?}]
    m.rows = []            ' [{group,hl,icon,label}]
    m.focusIndex = 0
    ' Row drawn as the current screen. Derived from m.top.selectedId (see
    ' syncSelection), not owned here: MainScene switches screens on paths the
    ' rail never sees -- a server switch, sign-in, Back to Home -- and a rail
    ' that tracked its own last roam kept highlighting Settings or TV over Home.
    m.selectedIndex = 0
    ' First nav row drawn, when there are more rows than fit. See layout().
    m.firstVisible = 0
    m.expanded = false

    m.wordmark.font = font("pkg:/fonts/Inter-Bold.ttf", 40)
    m.wordmark.color = "#FFFFFF"

    m.avatarLabel.font = font("pkg:/fonts/Inter-Bold.ttf", 26)
    m.avatarLabel.color = "#FFFFFF"
    m.avatarLabel.horizAlign = "center"
    m.avatarLabel.vertAlign = "center"

    m.accountLabel.font = font("pkg:/fonts/Inter-Bold.ttf", 26)
    m.accountLabel.color = "#FFFFFF"
    m.accountSub.font = font("pkg:/fonts/Inter-Medium.ttf", 20)
    m.accountSub.color = "#8C8C8C"
    m.versionLabel.font = font("pkg:/fonts/Inter-Medium.ttf", 18)
    m.versionLabel.color = "#6A6A72"
    m.versionLabel.vertAlign = "center"
    m.versionLabel.text = "v" + CreateObject("roAppInfo").GetVersion()

    ' Avatar identity — the server URL may not be restored yet at init time,
    ' so also refresh when it becomes available (else the photo never loads).
    setAvatar()
    ' Swap the initial-letter placeholder for the photo only once the photo
    ' has actually decoded; restore it if the load fails.
    m.avatarImg.observeFieldScoped("loadStatus", "onAvatarStatus")
    m.global.observeFieldScoped("serverUrl", "onServerReady")

    m.apiTask.observeFieldScoped("response", "onLibraries")
    refreshLibraries()

    m.top.observeField("focusedChild", "onFocusChanged")

    buildItems()
    syncSelection()
    buildRows()
    layout()
end sub

function font(uri as string, size as integer) as object
    f = CreateObject("roSGNode", "Font")
    f.uri = uri
    f.size = size
    return f
end function

sub reloadSession()
    onServerReady()
end sub

sub onServerReady()
    setAvatar()
    ' Server changed — re-fetch the rail's libraries so a server switch shows
    ' the new libraries without needing an app restart.
    refreshLibraries()
end sub

' Fetch the library list for the active server (init + on every server change).
sub refreshLibraries()
    m.apiTask.control = "RUN"
    m.apiTask.request = { action: "getLibraryViews" }
end sub

sub setAvatar()
    userName = Registry.getUserName()
    ' Reset, not just set: this reruns on every session change, and a letter
    ' left over from the previous user is worse than the placeholder.
    initial = "?"
    if userName <> "" then initial = UCase(Left(userName, 1))
    m.avatarLabel.text = initial
    userId = Registry.getUserId()
    if userId = "" or m.global.serverUrl = invalid or m.global.serverUrl = ""
        m.avatarImg.uri = ""
        m.avatarLabel.visible = true
        m.avatarBg.visible = true
    else
        m.avatarImg.uri = m.global.serverUrl + "/Users/" + userId + "/Images/Primary?maxWidth=140&quality=90"
        ' Roku ignores EXIF orientation — the photo is stored rotated; correct it.
        ' NOTE: server-image dependent — a server whose avatar is stored upright
        ' will render sideways here.
        m.avatarImg.scaleRotateCenter = [28, 28]
        m.avatarImg.rotation = 1.5708
    end if
end sub

sub onAvatarStatus()
    st = m.avatarImg.loadStatus
    if st = "ready"
        ' Photo decoded: the letter (and its accent disc) under the photo would
        ' bleed through the photo's transparent corners — hide both.
        m.avatarLabel.visible = false
        m.avatarBg.visible = false
    else if st = "failed"
        m.avatarLabel.visible = true
        m.avatarBg.visible = true
    end if
end sub

sub onLibraries()
    r = m.apiTask.response
    if r = invalid or r.action <> "getLibraryViews" or not r.success then return
    m.libraries = []
    for each lib in r.items
        ct = ""
        if lib.CollectionType <> invalid then ct = LCase(lib.CollectionType)
        if ct = "movies" or ct = "tvshows" or ct = "music" or ct = "" then m.libraries.push(lib)
    end for
    buildItems()
    ' The rows were rebuilt from a new list, so an index into the old one
    ' can point at a different item now.
    syncSelection()
    buildRows()
    layout()
end sub

sub onSelectedIdChanged()
    syncSelection()
    ' layout, not just styles: a moved focus row may need the list scrolled.
    layout()
end sub

' Resolve m.top.selectedId to a row. An id with no row (a library the list has
' not loaded yet) highlights nothing rather than a stale neighbour. While the
' rail is at rest the focus row follows too, so the next Left opens the rail on
' the screen being shown; while it is being roamed, focus is the user's.
sub syncSelection()
    m.selectedIndex = -1
    for i = 0 to m.items.count() - 1
        if m.items[i].id = m.top.selectedId
            m.selectedIndex = i
            exit for
        end if
    end for
    if not m.top.isInFocusChain() and m.selectedIndex >= 0 then m.focusIndex = m.selectedIndex
end sub

sub buildItems()
    m.items = [{ id: "home", kind: "home", title: "Home", iconLocal: "pkg:/images/nav_home.png", iconSelected: "pkg:/images/nav_home_selected.png" }]
    ' Stations sits directly under Home, as it does on the other clients, with the
    ' same broadcast glyph they use — the TV library's icon read as a duplicate.
    m.items.push({ id: "fintv", kind: "fintv", title: "SashimiTV", iconLocal: "pkg:/images/nav_fintv.png", iconSelected: "pkg:/images/nav_fintv_selected.png" })
    for each lib in m.libraries
        ct = ""
        if lib.CollectionType <> invalid then ct = LCase(lib.CollectionType)
        item = { id: "lib:" + lib.Id, kind: "library", title: lib.Name, libId: lib.Id, libName: lib.Name, collectionType: ct }
        ' Movie/TV/YouTube libraries get monochrome glyphs (with a purple
        ' selected variant) instead of artwork thumbnails — the mixed-media
        ' rail read as clutter. Other libraries keep their artwork, falling
        ' back to the generic stack glyph.
        if YT.isLibraryName(lib.Name)
            item.iconLocal = "pkg:/images/lib_youtube.png"
            item.iconSelected = "pkg:/images/lib_youtube_selected.png"
        else if ct = "movies"
            item.iconLocal = "pkg:/images/lib_movies.png"
            item.iconSelected = "pkg:/images/lib_movies_selected.png"
        else if ct = "tvshows"
            item.iconLocal = "pkg:/images/lib_tv.png"
            item.iconSelected = "pkg:/images/lib_tv_selected.png"
        else
            item.iconLocal = "pkg:/images/lib_generic.png"
            item.iconSelected = "pkg:/images/lib_generic_selected.png"
            if lib.Id <> invalid then item.iconUri = ImageUrl.primary(lib.Id, 120)
        end if
        m.items.push(item)
    end for
    m.items.push({ id: "search", kind: "search", title: "Search", iconLocal: "pkg:/images/nav_search.png", iconSelected: "pkg:/images/nav_search_selected.png" })
    m.items.push({ id: "settings", kind: "settings", title: "Settings", iconLocal: "pkg:/images/nav_settings.png", iconSelected: "pkg:/images/nav_settings_selected.png" })
end sub

sub buildRows()
    while m.navGroup.getChildCount() > 0
        m.navGroup.removeChildIndex(0)
    end while
    m.rows = []

    lf = font("pkg:/fonts/Inter-Medium.ttf", 30)

    for i = 0 to m.items.count() - 1
        it = m.items[i]
        y = i * m.rowPitch

        row = CreateObject("roSGNode", "Group")
        row.translation = [0, y]

        hl = CreateObject("roSGNode", "Poster")
        hl.uri = "pkg:/images/card_r16_focus.9.png"
        hl.height = m.rowPitch - 12
        hl.translation = [m.iconX - 14, 6]
        hl.width = m.iconSize + 28
        hl.visible = false
        row.appendChild(hl)

        iconY = (m.rowPitch - m.iconSize) / 2
        icon = invalid
        if it.kind = "library" and it.iconUri <> invalid
            ' Library artwork with rounded corners (mask)
            mask = CreateObject("roSGNode", "MaskGroup")
            mask.maskUri = "pkg:/images/mask_lib_r12.png"
            mask.maskSize = [m.iconSize, m.iconSize]
            mask.translation = [m.iconX, iconY]
            art = CreateObject("roSGNode", "Poster")
            art.width = m.iconSize
            art.height = m.iconSize
            art.loadDisplayMode = "scaleToZoom"
            art.failedBitmapUri = it.iconLocal
            art.uri = it.iconUri
            mask.appendChild(art)
            row.appendChild(mask)
        else
            icon = CreateObject("roSGNode", "Poster")
            icon.width = m.iconSize
            icon.height = m.iconSize
            icon.translation = [m.iconX, iconY]
            icon.loadDisplayMode = "scaleToFit"
            icon.uri = it.iconLocal
            row.appendChild(icon)
        end if

        label = CreateObject("roSGNode", "Label")
        label.text = it.title
        label.font = lf
        label.color = "#8C8C8C"
        label.translation = [m.labelX, 0]
        label.height = m.rowPitch
        label.width = m.railExpanded - m.labelX - 30
        label.vertAlign = "center"
        label.visible = false
        row.appendChild(label)

        m.navGroup.appendChild(row)
        m.rows.push({ group: row, hl: hl, icon: icon, label: label })
    end for

    updateStyles()
end sub

' Layout: logo top, nav group vertically centered, avatar at foot.
sub layout()
    w = m.railCollapsed
    if m.expanded then w = m.railExpanded
    m.railBg.width = w
    m.divider.translation = [w - 2, 0]

    ' No dimming of the content when the rail is out — keep the preview bright
    m.scrim.opacity = 0

    ' Dim the rail's contents when resting (not engaged); full brightness on
    ' focus. One group opacity — per-layer values multiplied through stacked
    ' nodes (avatar disc under photo) and rendered darker than 0.68.
    if m.expanded
        m.railContent.opacity = 1.0
    else
        m.railContent.opacity = 0.68
    end if

    ' Version sits under the avatar — centered under the circle when collapsed,
    ' aligned with the account text when expanded.
    m.versionLabel.visible = true
    if m.expanded
        m.versionLabel.translation = [118, 1028]
        m.versionLabel.width = 200
        m.versionLabel.horizAlign = "left"
    else
        ' Width 120 (was 56 = avatar width): two-digit patch versions like
        ' "v1.1.10" need ~68px at 18pt and were ellipsizing to "v1.1...".
        ' x=8 keeps the label centered under the avatar circle (center 68).
        m.versionLabel.translation = [8, 1030]
        m.versionLabel.width = 120
        m.versionLabel.horizAlign = "center"
    end if

    m.wordmark.visible = m.expanded
    m.accountLabel.visible = m.expanded
    m.accountSub.visible = m.expanded

    ' Vertically center the nav block between logo (top) and avatar (foot) —
    ' but only while it fits. The band is 790px and a row is 88, so nine or more
    ' items used to run straight through the avatar at 968: the old code clamped
    ' the TOP of the block and let the bottom grow off the end of the rail.
    ' Past that point the list scrolls instead, the way SettingsScreen does.
    count = m.rows.count()
    if count > 0
        topBound = 150
        botBound = 940
        band = botBound - topBound
        ' Derived, not a magic 8: the pitch or the avatar can move.
        m.visibleRows = Int(band / m.rowPitch)
        block = count * m.rowPitch

        if count <= m.visibleRows
            m.firstVisible = 0
            gy = topBound + (band - block) / 2
        else
            clampFirstVisible()
            gy = topBound - m.firstVisible * m.rowPitch
        end if
        m.navGroup.translation = [0, gy]

        ' Clip to the band so a scrolled row cannot paint over the avatar.
        m.navGroup.clippingRect = [0, topBound - gy, m.railExpanded, band]
    end if

    for i = 0 to m.rows.count() - 1
        r = m.rows[i]
        r.label.visible = m.expanded
        focused = (m.expanded and i = m.focusIndex)
        r.hl.visible = focused
        if m.expanded
            r.hl.translation = [20, 6]
            r.hl.width = m.railExpanded - 40
        else
            r.hl.translation = [m.iconX - 14, 6]
            r.hl.width = m.iconSize + 28
        end if
    end for

    updateStyles()
end sub

sub updateStyles()
    hasFocus = m.top.isInFocusChain()
    for i = 0 to m.rows.count() - 1
        r = m.rows[i]
        r.hl.visible = (hasFocus and i = m.focusIndex)
        if i = m.selectedIndex
            r.label.color = "#BD3EED"   ' Jellyfin purple (matches the logo)
        else if hasFocus and i = m.focusIndex
            r.label.color = "#FFFFFF"
        else
            r.label.color = "#8C8C8C"
        end if
        ' Monochrome icons mirror the label states: selected = purple asset,
        ' focused = full white, resting (rail expanded) = 55% white — the icon
        ' equivalent of #8C8C8C. When the rail is collapsed, railContent
        ' already dims everything to 0.68, so icons stay at 1.0 there and the
        ' resting look matches what shipped before. Artwork rows (icon =
        ' invalid) are untouched.
        if r.icon <> invalid
            it = m.items[i]
            if i = m.selectedIndex and it.iconSelected <> invalid
                r.icon.uri = it.iconSelected
                r.icon.opacity = 1.0
            else
                r.icon.uri = it.iconLocal
                if hasFocus and i = m.focusIndex
                    r.icon.opacity = 1.0
                else if hasFocus
                    r.icon.opacity = 0.55
                else
                    r.icon.opacity = 1.0
                end if
            end if
        end if
    end for
    ' Avatar highlight (focus past the last nav item)
    avatarFocused = (hasFocus and m.focusIndex = m.items.count())
    if avatarFocused
        m.accountLabel.color = "#FFFFFF"
    else
        m.accountLabel.color = "#DDDDDD"
    end if
end sub

sub onFocusChanged()
    m.expanded = m.top.isInFocusChain()
    if m.expanded and m.focusIndex > m.items.count() then m.focusIndex = 0
    layout()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if m.items.count() = 0 then return false

    lastIndex = m.items.count()   ' avatar sits at items.count()

    if key = "down"
        if m.focusIndex < lastIndex
            m.focusIndex = m.focusIndex + 1
            onFocusMoved()
        end if
        return true
    else if key = "up"
        if m.focusIndex > 0
            m.focusIndex = m.focusIndex - 1
            onFocusMoved()
        end if
        return true
    else if key = "right" or key = "OK"
        if m.focusIndex = lastIndex
            m.top.switchServer = true
        else
            m.top.descend = true
        end if
        return true
    else if key = "left"
        return true   ' leftmost — consume
    end if
    return false
end function

' Keep the focused row inside the visible band. The avatar sits one past the
' last item, so moving onto it scrolls the list to its end first.
sub clampFirstVisible()
    if m.visibleRows = invalid or m.visibleRows <= 0 then return
    count = m.rows.count()
    maxFirst = count - m.visibleRows
    if maxFirst < 0 then maxFirst = 0

    target = m.focusIndex
    if target > count - 1 then target = count - 1

    if target < m.firstVisible then m.firstVisible = target
    if target > m.firstVisible + m.visibleRows - 1 then m.firstVisible = target - m.visibleRows + 1

    if m.firstVisible > maxFirst then m.firstVisible = maxFirst
    if m.firstVisible < 0 then m.firstVisible = 0
end sub

sub onFocusMoved()
    ' Re-run layout first: the focused row may be outside the band.
    layout()
    ' Roaming switches the content; MainScene answers with selectedId, which is
    ' what moves the highlight (onSelectedIdChanged).
    if m.focusIndex < m.items.count() then emitChoice(m.items[m.focusIndex])
    updateStyles()
end sub

sub emitChoice(it as object)
    if it.kind = "library"
        m.top.navChoice = { kind: "library", library: { id: it.libId, name: it.libName, collectionType: it.collectionType } }
    else
        m.top.navChoice = { kind: it.kind }
    end if
end sub
