import "pkg:/source/utils/AppSettings.bs"

' Theme songs (companion Jellyfin plugin drops theme.mp3 beside each series).
' tvOS/iOS parity in behaviour, with one platform limit called out below.
'
' NO VOLUME CONTROL. SceneGraph's Audio node exposes exactly one audio-level
' field -- the boolean `mute` -- and BrightScript has no gain/amplitude API of
' any kind. The other clients fade in over 1.0s, cross-fade 0.4s on a show
' change, hard-cut in 0.25s and fade out over 1.5s, all at 0.6 volume; none of
' that is expressible here. The theme therefore starts and stops abruptly at
' system volume. That is the platform, not an oversight: do not simulate it by
' toggling mute, re-encoding the audio, or adding a volume control.
'
' VISIT STATE is keyed on the SERIES id and depth-counted. MainScene calls
' enterSeries() when a detail screen for a show becomes current and
' exitSeries() when one goes away; the theme starts on the 0 -> 1 edge and
' stops on the edge back to 0. That one rule gives both "drilling series ->
' episode doesn't restart the theme" (depth 1 -> 2, no edge) and "returning
' from the player is silent" (the player never entered, so popping it is not
' an edge either) without special-casing either.
'
' EVERY FAILURE PATH IS SILENCE. Roughly 41% of a typical library has no theme
' at all, so "this show has no theme" is the ordinary answer, not an error.
' Nothing here raises a dialog or a toast.

sub init()
    m.audio = m.top.findNode("audio")
    m.startTimer = m.top.findNode("startTimer")
    m.apiTask = m.top.findNode("apiTask")

    m.startTimer.observeFieldScoped("fire", "onStartTimer")
    m.apiTask.observeFieldScoped("response", "onApiResponse")
    m.apiTask.control = "RUN"

    m.depth = {}        ' seriesId -> how many detail screens are visiting it
    m.activeKey = ""    ' the series whose visit currently owns the player
    m.wantPlay = false  ' a start is armed or in flight for m.activeKey
    ' seriesId -> stream url for the session. A MISS is cached too (as ""), so
    ' a themeless show is asked about once and never again.
    m.cache = {}
    m.reqQueue = []
    m.reqActive = false
end sub

' ---------- Public interface (callFunc) ----------

' A detail screen for `key` became current.
function enterSeries(key as string) as void
    if key = "" then return
    visits = 0
    if m.depth.DoesExist(key) then visits = m.depth[key]
    m.depth[key] = visits + 1
    ' Already inside this show -- drilling down, so the visit continues and the
    ' theme keeps playing untouched.
    if visits > 0 then return
    beginVisit(key)
end function

' A detail screen for `key` went away.
function exitSeries(key as string) as void
    if key = "" then return
    if not m.depth.DoesExist(key) then return
    visits = m.depth[key] - 1
    if visits > 0
        m.depth[key] = visits
        return
    end if
    m.depth.Delete(key)
    if m.activeKey = key then stopAndDisarm()
end function

' Video or a trailer is about to start. The Audio and Video nodes mix rather
' than displace each other, so the theme has to be off BEFORE the player opens
' its stream. Visit depth is deliberately left alone: the screen underneath is
' still being visited, and because a restart only happens on the 0 -> 1 edge,
' coming back out of the player stays silent on its own.
function stopPlayback(reason as string) as void
    #if DEBUG
        print "[Theme] stop (" + reason + ")"
    #end if
    stopAndDisarm()
end function

' Sign-out or server switch: the cached URLs carry the previous server's token,
' and the visit depths belong to a screen stack that no longer exists.
function resetSession(reason as string) as void
    #if DEBUG
        print "[Theme] reset (" + reason + ")"
    #end if
    stopAndDisarm()
    m.depth = {}
    m.cache = {}
end function

' ---------- Playback ----------

sub beginVisit(key as string)
    stopAndDisarm()
    if not themesEnabled() then return
    m.activeKey = key
    m.wantPlay = true
    ' A non-repeating timer that already fired needs the explicit stop before
    ' start to re-arm.
    m.startTimer.control = "stop"
    m.startTimer.control = "start"
end sub

sub onStartTimer()
    if not m.wantPlay then return
    key = m.activeKey
    if key = "" then return
    if m.cache.DoesExist(key)
        playStream(m.cache[key])
        return
    end if
    enqueue({ action: "getThemeMedia", itemId: key })
end sub

sub playStream(url as dynamic)
    ' "" is a cached miss: this show simply has no theme.
    if url = invalid or url = "" then return
    content = CreateObject("roSGNode", "ContentNode")
    content.url = url
    ' The Audio node does not sniff the body; the format has to be declared.
    content.streamFormat = "mp3"
    m.audio.content = content
    m.audio.control = "play"
end sub

sub stopAndDisarm()
    m.wantPlay = false
    m.activeKey = ""
    m.startTimer.control = "stop"
    m.audio.control = "stop"
end sub

function themesEnabled() as boolean
    enabled = m.global.playThemeSongs
    ' The global is mirrored by MainScene at startup; fall back to the stored
    ' value so this is still correct if it is ever asked before that runs.
    if enabled = invalid then return AppSettings.playThemeSongs()
    return enabled = true
end function

' ---------- API ----------
' Same serialized queue as the screens: the task reads only the latest request
' per tick, so two lookups set in one tick would silently drop the first.

sub enqueue(req as object)
    m.reqQueue.push(req)
    pumpQueue()
end sub

sub pumpQueue()
    if m.reqActive then return
    if m.reqQueue.count() = 0 then return
    m.reqActive = true
    m.apiTask.request = m.reqQueue.shift()
end sub

sub onApiResponse()
    response = m.apiTask.response
    if response = invalid then return
    m.reqActive = false

    if response.action = "getThemeMedia"
        ' Cache the miss as well as the hit, but only when the server actually
        ' answered: caching a dropped request would convince the session that a
        ' show has no theme for as long as the channel stays open.
        if response.resolved = true then m.cache[response.itemId] = response.streamUrl
        ' The visit may have ended (or moved to another show) while this was in
        ' flight -- in which case the answer is cached and nothing else happens.
        if m.wantPlay and m.activeKey = response.itemId then playStream(response.streamUrl)
    end if

    pumpQueue()
end sub
