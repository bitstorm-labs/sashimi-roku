<?xml version="1.0" encoding="UTF-8" ?>
<component name="ThemeSongPlayer" extends="Group">
    <!-- App-level service, owned by MainScene. Non-visual: it only exists to
         hold the Audio node, the start timer and its own API task. Every entry
         point is a callFunc rather than a field, because a single tick can
         carry several visit transitions (clearAllScreens pops a whole stack)
         and field writes coalesce. Each takes exactly one argument. -->
    <interface>
        <function name="enterSeries" />
        <function name="exitSeries" />
        <function name="stopPlayback" />
        <function name="resetSession" />
    </interface>
    <children>
        <Audio id="audio" />
        <!-- Grace period before the first note, so flicking into a title and
             straight back out never blips a fragment of audio. -->
        <Timer id="startTimer" repeat="false" duration="0.75" />
        <JellyfinApi id="apiTask" />
    </children>
</component>
