<?xml version="1.0" encoding="UTF-8" ?>
<component name="ToastOverlay" extends="Group">
    <interface>
        <field id="showToast" type="assocarray" alwaysNotify="true" />
    </interface>
    <children>
        <Rectangle
            id="toastBg"
            visible="false"
            color="#333333"
            opacity="0.9"
            width="900"
            height="80"
            translation="[510, 50]"

        >
            <!-- 560 clipped every toast past ~34 characters mid-word, e.g.
                 "Couldn't update. Check your connec...". Widened (and kept
                 centred: (1920-900)/2 = 510) so the copy that ships is the
                 copy that is read. -->
            <Label
                id="toastLabel"
                text=""
                font="font:SmallSystemFont"
                color="#FFFFFF"
                width="860"
                height="80"
                horizAlign="center"
                vertAlign="center"
                translation="[20, 0]"
            />
        </Rectangle>
        <Timer id="dismissTimer" repeat="false" duration="3" />
    </children>
</component>
