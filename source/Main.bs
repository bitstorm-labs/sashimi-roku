sub main(args as dynamic)
    screen = CreateObject("roSGScreen")
    m.port = CreateObject("roMessagePort")
    screen.setMessagePort(m.port)

    scene = screen.createScene("MainScene")

    if args <> invalid
        scene.launchArgs = args
    end if

    screen.show()
    scene.signalBeacon("AppLaunchComplete")

    ' Deep links while the channel is already running arrive as roInput
    ' events (cert 5.2); route them through the same launchArgs path.
    input = CreateObject("roInput")
    input.setMessagePort(m.port)

    ' Memory monitoring. SceneGraph components have no message loop, so this is
    ' the only place the low-memory events can be received; the loop below
    ' forwards them to the scene, which frees off-screen artwork (MainScene
    ' onLowMemory). The launch-time budget is read in MainScene.readMemoryBudget.
    ' Guarded: roAppMemoryMonitor requires run_as_process=1 and is only
    ' supported on current models. Unguarded, an invalid here threw before the
    ' message loop below was ever reached -- no loop means no isScreenClosed()
    ' and no roInput deep links, i.e. the channel exits at launch. Monitoring
    ' must never be able to take down startup.
    di = CreateObject("roDeviceInfo")
    if di <> invalid
        di.setMessagePort(m.port)
        di.EnableLowGeneralMemoryEvent(true)
    end if
    appMem = CreateObject("roAppMemoryMonitor")
    if appMem <> invalid
        appMem.setMessagePort(m.port)
        appMem.EnableMemoryWarningEvent(true)
    end if

    while true
        msg = wait(0, m.port)
        msgType = type(msg)
        if msgType = "roSGScreenEvent"
            if msg.isScreenClosed()
                return
            end if
        else if msgType = "roDeviceInfoEvent"
            ' roDeviceInfoEvent carries several unrelated notifications, so the
            ' payload is what identifies a memory one. isLowGeneralMemoryEvent()
            ' is NOT a member on this firmware (verified: Roku OS 15.3.4 throws
            ' "Member function not found" and takes the channel down with it) --
            ' the presence of generalMemoryLevel is the portable test.
            info = msg.getInfo()
            if info <> invalid and info.doesExist("generalMemoryLevel")
                level = info.generalMemoryLevel
                #if DEBUG
                    print "[Mem] generalMemoryLevel: " + level
                #end if
                ' The same event carries the all-clear on the way back down.
                if level <> "normal" then scene.lowMemory = true
            end if
        else if msgType = "roAppMemoryNotificationEvent"
            #if DEBUG
                print "[Mem] memory warning"
            #end if
            scene.lowMemory = true
        else if msgType = "roInputEvent"
            info = msg.getInfo()
            if info <> invalid and info.doesExist("contentId")
                scene.launchArgs = info
            end if
        end if
    end while
end sub
