' Continue Watching: Resume + Next Up, most recent activity first, one entry per
' series. Port of sashimi-apple's mergeAndSortContinueItems. Pure functions
' only, so tests/ContinueWatchingTests.brs can run them off-device.
'
' Every candidate gets a real activity date. Resume items, and Next Up items the
' server dates, use their own LastPlayedDate. An unstarted Next Up episode has
' none (nor does its Series item), so it takes its series' last finished episode
' (seriesDates, from getNextUp's recently played lookup). Failing that it sits a
' second below the item before it -- Next Up is ordered by series activity --
' starting just below the newest real date.
'
' Stamping the first undated Next Up "now" let an unstarted next episode outrank
' the episode just stopped part-way, and replace it when it was the same show.
' Anchoring without the series date put a show binged all evening behind any
' other show with a date (sashimi-apple#647).
namespace ContinueWatching

    ' Epoch seconds of an ISO 8601 timestamp, or 0. Jellyfin stamps 7-digit
    ' fractional seconds ("...T04:48:25.0000000Z") which FromISO8601String
    ' won't parse, so the timestamp is trimmed to whole seconds.
    function isoSeconds(raw as dynamic) as integer
        if raw = invalid or raw = "" or Len(raw) < 19 then return 0
        dt = CreateObject("roDateTime")
        dt.FromISO8601String(Left(raw, 19) + "Z")
        return dt.AsSeconds()
    end function

    ' Epoch seconds of an item's last play, or 0 when it has never been played.
    function playedSeconds(item as object) as integer
        if item = invalid or item.UserData = invalid then return 0
        return isoSeconds(item.UserData.LastPlayedDate)
    end function

    ' Sortable key: zero-padded seconds so string order matches time order, plus
    ' a trailing digit so Resume outranks Next Up at an identical timestamp.
    function activityKey(secs as integer, isResume as boolean) as string
        if secs <= 0 then return "00000000000"
        padded = Right("0000000000" + str(secs).Trim(), 10)
        if isResume then return padded + "1"
        return padded + "0"
    end function

    ' Folders (a partly watched Season or Series from Resume) can't be resumed.
    function isPlayable(item as object) as boolean
        if item = invalid then return false
        t = item.Type
        if t = invalid then return true
        return not (t = "Season" or t = "Series" or t = "BoxSet" or t = "Folder" or t = "CollectionFolder")
    end function

    ' SeriesId -> epoch seconds of that series' latest finished episode.
    function seriesLastPlayed(episodes as dynamic) as object
        dates = {}
        if episodes = invalid then return dates
        for each ep in episodes
            if ep.SeriesId <> invalid
                secs = playedSeconds(ep)
                if secs > 0
                    if not dates.DoesExist(ep.SeriesId) or dates[ep.SeriesId] < secs then dates[ep.SeriesId] = secs
                end if
            end if
        end for
        return dates
    end function

    function merge(resume as object, nextUp as object, seriesDates as object) as object
        candidates = []
        newestKnown = 0
        for each item in resume
            if isPlayable(item)
                secs = playedSeconds(item)
                if secs > newestKnown then newestKnown = secs
                candidates.push({ item: item, sortKey: activityKey(secs, true) })
            end if
        end for
        for each item in nextUp
            secs = playedSeconds(item)
            if secs > newestKnown then newestKnown = secs
        end for

        carried = newestKnown
        if carried = 0 then carried = CreateObject("roDateTime").AsSeconds()
        for each item in nextUp
            if isPlayable(item)
                ' An episode opened weeks ago keeps that stale date while the
                ' season before it is binged: take the newer of its own and its
                ' series' last watch.
                secs = playedSeconds(item)
                if item.SeriesId <> invalid and seriesDates.DoesExist(item.SeriesId)
                    if seriesDates[item.SeriesId] > secs then secs = seriesDates[item.SeriesId]
                end if
                if secs > 0
                    carried = secs
                else
                    carried = carried - 1
                end if
                candidates.push({ item: item, sortKey: activityKey(carried, false) })
            end if
        end for

        ' Newest first. Fixed-width zero-padded keys compare as strings in
        ' timestamp order, which sidesteps 32-bit overflow on epoch-seconds
        ' arithmetic; the trailing digit breaks ties toward Resume, so a
        ' part-watched episode is offered for resuming rather than skipped past.
        ' A stable insertion sort (the row is ~40 candidates) rather than
        ' roArray.SortBy, which the off-device interpreter gets wrong for
        ' camelCase keys, so the tests run the code the device runs.
        for i = 1 to candidates.count() - 1
            current = candidates[i]
            j = i - 1
            while j >= 0 and candidates[j].sortKey < current.sortKey
                candidates[j + 1] = candidates[j]
                j = j - 1
            end while
            candidates[j + 1] = current
        end for

        merged = []
        seenSeries = {}
        seenIds = {}
        for each candidate in candidates
            item = candidate.item
            itemId = ""
            if item.Id <> invalid then itemId = item.Id
            seriesId = ""
            if item.SeriesId <> invalid then seriesId = item.SeriesId

            isDupe = (itemId <> "" and seenIds.DoesExist(itemId))
            if not isDupe and seriesId <> "" and seenSeries.DoesExist(seriesId) then isDupe = true

            if not isDupe
                if itemId <> "" then seenIds[itemId] = true
                if seriesId <> "" then seenSeries[seriesId] = true
                merged.push(item)
            end if
        end for
        return merged
    end function

    ' The server's Continue Watching plugin
    ' (bitstorm-labs/jellyfin-plugin-continue-watching) ranks the whole row, so
    ' every client shows the same order. Path and query for its endpoint:
    function serverRowPath(userId as string, limit as integer) as string
        path = "/ContinueWatching?userId=" + userId
        path += "&limit=" + str(limit).Trim()
        path += "&fields=Overview,PrimaryImageAspectRatio,CommunityRating,OfficialRating,Genres,UserData,ParentBackdropImageTags,Path,MediaStreams"
        path += "&enableImageTypes=Primary,Backdrop,Thumb"
        return path
    end function

    ' The plugin's items, or invalid when there is no usable answer (no plugin:
    ' 404 -> invalid from Http.getJson), so the caller merges the row itself.
    function serverRowItems(response as dynamic) as dynamic
        if response = invalid or type(response) <> "roAssociativeArray" then return invalid
        if response.Items = invalid or type(response.Items) <> "roArray" then return invalid
        return response.Items
    end function

    ' ---------- Remove from Continue Watching ----------
    ' The contract every Sashimi client and the plugin share
    ' (sashimi-apple#742): clear a resume position, and hide an episode's series
    ' from Next Up while that episode is still its Next Up.

    ' What removing this card has to do. Watched state is never touched.
    function removalPlan(item as dynamic) as object
        plan = { itemId: "", clearResume: false, hide: false, seriesId: "", episodeId: "" }
        if item = invalid or item.Id = invalid or item.Id = "" then return plan
        plan.itemId = item.Id
        if item.UserData <> invalid and item.UserData.PlaybackPositionTicks <> invalid
            plan.clearResume = (item.UserData.PlaybackPositionTicks > 0)
        end if
        if item.Type <> invalid and item.Type = "Episode" and item.SeriesId <> invalid and item.SeriesId <> ""
            plan.hide = true
            plan.seriesId = item.SeriesId
            plan.episodeId = item.Id
        end if
        return plan
    end function

    ' The plugin's hide endpoint (POST to hide, DELETE to undo).
    function hiddenPath(episodeId as string) as string
        return "/ContinueWatching/Hidden/" + episodeId
    end function

    ' 2xx means the plugin holds the hide. Anything else -- 404 from a server
    ' without the plugin (or an older one), an error, a timeout -- keeps the
    ' local entry, so the card stays gone either way.
    function hiddenOnServer(statusCode as integer) as boolean
        return statusCode >= 200 and statusCode < 300
    end function

    ' Registry key for the local hide list: per server and per user, so one
    ' household member's hides never leak into another's row.
    function hiddenStoreKey(serverUrl as string, userId as string) as string
        return userId + "@" + serverUrl
    end function

    ' The stored list with this series hidden at this episode. One entry per
    ' series (a newer hide replaces an older one); the oldest go past the cap.
    function addHidden(entries as dynamic, seriesId as string, episodeId as string, cap = 500 as integer) as object
        out = removeHiddenSeries(entries, seriesId)
        out.push({ seriesId: seriesId, episodeId: episodeId })
        while out.count() > cap
            out.shift()
        end while
        return out
    end function

    ' The stored list without this series: the plugin took the hide over, or an
    ' episode of the series started playing on this device.
    function removeHiddenSeries(entries as dynamic, seriesId as string) as object
        out = []
        if type(entries) <> "roArray" then return out
        for each e in entries
            if type(e) = "roAssociativeArray" and e.seriesId <> invalid and e.episodeId <> invalid and e.seriesId <> seriesId
                out.push({ seriesId: e.seriesId, episodeId: e.episodeId })
            end if
        end for
        return out
    end function

    ' Drop hidden cards from a list of row items, and the entries that have gone
    ' stale. A series stays hidden only while the episode it offers is the one
    ' that was hidden: once a different episode of it turns up (watched
    ' elsewhere, or a resume moved on), the hide has done its job and the
    ' series shows again. A series absent from the list says nothing either
    ' way (the row is capped), so its entry is kept.
    ' Returns { items, entries, changed } -- changed: entries needs saving.
    function filterHidden(items as dynamic, entries as dynamic) as object
        result = { items: [], entries: [], changed: false }
        if type(items) = "roArray" then result.items = items
        if type(entries) <> "roArray" or entries.count() = 0 then return result

        hidden = {}
        for each e in entries
            if type(e) = "roAssociativeArray" and e.seriesId <> invalid and e.episodeId <> invalid
                hidden[e.seriesId] = e.episodeId
            end if
        end for

        stale = {}
        kept = []
        for each item in result.items
            seriesId = invalid
            if item <> invalid then seriesId = item.SeriesId
            if seriesId <> invalid and hidden.DoesExist(seriesId)
                if item.Id <> invalid and item.Id = hidden[seriesId]
                    continue for
                end if
                stale[seriesId] = true
                hidden.Delete(seriesId)
            end if
            kept.push(item)
        end for
        result.items = kept

        for each e in entries
            if type(e) = "roAssociativeArray" and e.seriesId <> invalid and e.episodeId <> invalid and not stale.DoesExist(e.seriesId)
                result.entries.push(e)
            else
                result.changed = true
            end if
        end for
        return result
    end function

    ' Home's options (*) menu. On a Continue Watching card it leads with the
    ' remove action; anywhere else it is Refresh alone, as before.
    function optionsButtons(onContinueWatchingCard as boolean) as object
        if onContinueWatchingCard then return [REMOVE_LABEL(), "Refresh", "Cancel"]
        return ["Refresh", "Cancel"]
    end function

    function REMOVE_LABEL() as string
        return "Remove from Continue Watching"
    end function

    function REMOVED_TOAST() as string
        return "Removed from Continue Watching"
    end function

end namespace
