namespace Http

    ' Percent-encode a value for use in a query string. roUrlTransfer.Escape is
    ' the platform's encoder; anything interpolated into a URL must go through
    ' it. A raw multi-word search term turned the space into a literal space,
    ' which truncated the request at the first word.
    function escape(value as string) as string
        if value = "" then return ""
        return CreateObject("roUrlTransfer").Escape(value)
    end function

    function authHeader() as string
        parts = []
        parts.push("MediaBrowser Client=""Sashimi""")
        parts.push("Device=""Sashimi Roku""")
        parts.push("DeviceId=""" + m.global.deviceId + """")
        ' Real channel version (manifest), not a hardcoded literal -- every
        ' session previously showed as 0.1.0 in the Jellyfin dashboard.
        ver = "0.0.0"
        appInfo = CreateObject("roAppInfo")
        if appInfo <> invalid then ver = appInfo.GetVersion()
        parts.push("Version=""" + ver + """")
        token = m.global.authToken
        if token <> "" and token <> invalid
            parts.push("Token=""" + token + """")
        end if

        result = ""
        for i = 0 to parts.count() - 1
            if i > 0 then result += ", "
            result += parts[i]
        end for
        return result
    end function

    ' meta (optional): an AA that receives { statusCode } so callers can tell a
    ' 401 from a timeout from a 5xx. Collapsing everything to invalid is what
    ' made an expired token indistinguishable from "server down" and left the
    ' home screen spinning forever.
    function getJson(url as string, meta = invalid as object) as dynamic
        request = CreateObject("roUrlTransfer")
        port = CreateObject("roMessagePort")
        request.SetMessagePort(port)
        request.SetCertificatesFile("common:/certs/ca-bundle.crt")
        request.InitClientCertificates()
        request.SetUrl(url)
        request.AddHeader("Authorization", authHeader())
        request.AddHeader("Accept", "application/json")
        request.RetainBodyOnError(true)

        if request.AsyncGetToString()
            msg = wait(30000, port)
            if msg <> invalid and type(msg) = "roUrlEvent"
                code = msg.GetResponseCode()
                if meta <> invalid then meta.statusCode = code
                if code >= 200 and code < 300
                    return ParseJSON(msg.GetString())
                else
                    #if DEBUG
                        print "HTTP GET error: " + str(code)
                    #end if
                    return invalid
                end if
            else
                ' Timed out: cancel so the transfer does not linger on the thread
                request.AsyncCancel()
                if meta <> invalid then meta.statusCode = 0
                #if DEBUG
                    print "HTTP GET timeout"
                #end if
                return invalid
            end if
        end if
        if meta <> invalid then meta.statusCode = -1
        return invalid
    end function

    ' Raw response body, for the endpoints that answer with something ParseJSON
    ' cannot be trusted with. /QuickConnect/Enabled replies with a bare `true`:
    ' a valid JSON document under RFC 7159 but not an object or array, and
    ' Roku's parser is not guaranteed to accept a scalar root. Returns invalid
    ' on any non-2xx, with the same { statusCode } meta convention as getJson.
    function getText(url as string, meta = invalid as object) as dynamic
        request = CreateObject("roUrlTransfer")
        port = CreateObject("roMessagePort")
        request.SetMessagePort(port)
        request.SetCertificatesFile("common:/certs/ca-bundle.crt")
        request.InitClientCertificates()
        request.SetUrl(url)
        request.AddHeader("Authorization", authHeader())
        request.AddHeader("Accept", "application/json")
        request.RetainBodyOnError(true)

        if request.AsyncGetToString()
            msg = wait(30000, port)
            if msg <> invalid and type(msg) = "roUrlEvent"
                code = msg.GetResponseCode()
                if meta <> invalid then meta.statusCode = code
                if code >= 200 and code < 300 then return msg.GetString()
                #if DEBUG
                    print "HTTP GET error: " + str(code)
                #end if
                return invalid
            end if
            request.AsyncCancel()
            if meta <> invalid then meta.statusCode = 0
            #if DEBUG
                print "HTTP GET timeout"
            #end if
            return invalid
        end if
        if meta <> invalid then meta.statusCode = -1
        return invalid
    end function

    ' meta (optional): the same { statusCode } convention as getJson. A POST
    ' that returns invalid can mean rejected credentials, a redirect, a dead
    ' server or a timeout, and the sign-in screen has to say which.
    function postJson(url as string, body as dynamic, meta = invalid as object) as dynamic
        request = CreateObject("roUrlTransfer")
        port = CreateObject("roMessagePort")
        request.SetMessagePort(port)
        request.SetCertificatesFile("common:/certs/ca-bundle.crt")
        request.InitClientCertificates()
        request.SetUrl(url)
        request.AddHeader("Authorization", authHeader())
        request.AddHeader("Content-Type", "application/json")
        request.AddHeader("Accept", "application/json")
        request.RetainBodyOnError(true)

        bodyStr = ""
        if body <> invalid
            bodyStr = FormatJSON(body)
        end if

        if request.AsyncPostFromString(bodyStr)
            msg = wait(30000, port)
            if msg <> invalid and type(msg) = "roUrlEvent"
                code = msg.GetResponseCode()
                if meta <> invalid then meta.statusCode = code
                if code >= 200 and code < 300
                    responseStr = msg.GetString()
                    if responseStr <> "" and responseStr <> invalid
                        return ParseJSON(responseStr)
                    end if
                    return { _statusCode: code }
                else
                    #if DEBUG
                        print "HTTP POST error: " + str(code) + " for " + url
                    #end if
                    return invalid
                end if
            else
                if meta <> invalid then meta.statusCode = 0
                #if DEBUG
                    print "HTTP POST timeout for " + url
                #end if
                return invalid
            end if
        end if
        if meta <> invalid then meta.statusCode = -1
        return invalid
    end function

    function deleteRequest(url as string) as integer
        request = CreateObject("roUrlTransfer")
        port = CreateObject("roMessagePort")
        request.SetMessagePort(port)
        request.SetCertificatesFile("common:/certs/ca-bundle.crt")
        request.InitClientCertificates()
        request.SetUrl(url)
        request.AddHeader("Authorization", authHeader())
        request.SetRequest("DELETE")
        request.RetainBodyOnError(true)

        if request.AsyncGetToString()
            msg = wait(30000, port)
            if msg <> invalid and type(msg) = "roUrlEvent"
                return msg.GetResponseCode()
            end if
        end if
        return -1
    end function

    ' Turn whatever the user (or LAN discovery) gave us into a usable API base.
    ' Jellyfin's discovery reply carries its PublishedServerUrl, which is often
    ' a bare "host" or "host:port" with no scheme, and users type the same on a
    ' D-pad -- neither is a URL roUrlTransfer can POST to. Default to http and
    ' leave the rest alone: the port belongs to the host, so an explicit
    ' non-default one (9096) survives and no default is ever assumed.
    function normalizeServerUrl(url as string) as string
        url = url.Trim()
        if url = "" then return ""
        lower = LCase(url)
        if Left(lower, 7) <> "http://" and Left(lower, 8) <> "https://"
            url = "http://" + url
        end if
        if Right(url, 1) = "/"
            url = Left(url, Len(url) - 1)
        end if
        return url
    end function

    ' The https twin of an http base URL: same host, SAME port -- only the
    ' scheme changes. Returns "" for anything already https, so a caller can
    ' read "" as "nothing else to try". It deliberately never substitutes 443
    ' for an explicit port; a server on 9096 has nothing to do with whatever
    ' answers on 443, and guessing there is how you break a LAN setup.
    function httpsVariant(url as string) as string
        if Left(LCase(url), 7) <> "http://" then return ""
        return "https://" + Mid(url, 8)
    end function

    function apiUrl(path as string) as string
        serverUrl = m.global.serverUrl
        if Right(serverUrl, 1) = "/"
            serverUrl = Left(serverUrl, Len(serverUrl) - 1)
        end if
        if Left(path, 1) <> "/"
            path = "/" + path
        end if
        return serverUrl + path
    end function

end namespace
