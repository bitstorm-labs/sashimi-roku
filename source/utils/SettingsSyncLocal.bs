import "pkg:/source/utils/RailItems.bs"
import "pkg:/source/utils/Registry.bs"
import "pkg:/source/utils/SettingsSync.bs"

' The device side of settings sync (SettingsSync holds the rules): the
' registry values, this device's stamps and the on/off toggle, none of which
' is ever synced itself. Used from the render thread (a setting changed here)
' and from SettingsSyncTask (a reconcile), so every stamp write re-reads the
' map first instead of trusting a copy.
namespace SettingsSyncLocal

    const ENABLED_KEY = "settingsSyncEnabled"
    const STAMPS_KEY = "settingsSyncStamps"
    ' SettingsSync.SEED_VERSION the stamps were seeded at; absent beside a
    ' stamp map means v1.7.4's (1).
    const SEEDED_KEY = "settingsSyncSeeded"

    function enabled() as boolean
        return Registry.read("settings", ENABLED_KEY) <> "false"
    end function

    ' Unix epoch ms. AsSeconds() is an Integer; the product is not.
    function nowMs() as dynamic
        dt = CreateObject("roDateTime")
        secs& = dt.AsSeconds()
        return secs& * 1000 + dt.GetMilliseconds()
    end function

    ' Every synced setting's stored string, "" when never set.
    function localValues() as object
        out = {}
        for each s in SettingsSync.specs()
            if s.kind <> "layout" and s.kind <> "menu" then out[s.local] = Registry.read("settings", s.local)
        end for
        return out
    end function

    ' homeRowOrder as Home and the side menu see it: with the built-in
    ' entries a config saved before them lacks (Search on top and the
    ' Watchlist under it, ...), so a synced value is applied to, and its
    ' result saved with, what that one-time migration would make anyway,
    ' and the migration never runs over it afterwards. invalid or empty
    ' stays as it is: no config means Home hasn't loaded yet.
    function layoutConfig() as dynamic
        cfg = Registry.readJson("settings", SettingsSync.LAYOUT_LOCAL_KEY)
        if type(cfg) <> "roArray" or cfg.count() = 0 then return cfg
        return RailItems.withBuiltIns(cfg)
    end function

    ' The stamp map, seeded (and saved) the first time it is asked for, and
    ' for keys added since it was (sideMenu, after v1.7.4) -- never over a
    ' stamp it already has.
    function stamps() as object
        stored = SettingsSync.decodeStamps(Registry.read("settings", STAMPS_KEY))
        version = 0
        if stored <> invalid
            version = 1
            raw = Registry.read("settings", SEEDED_KEY)
            if raw <> "" then version = raw.toInt()
        end if
        if stored <> invalid and version >= SettingsSync.SEED_VERSION then return stored
        if stored = invalid then stored = {}
        seeded = SettingsSync.seedStamps(localValues(), layoutConfig(), version)
        for each k in seeded
            if not stored.DoesExist(k) then stored[k] = seeded[k]
        end for
        saveStamps(stored)
        Registry.write("settings", SEEDED_KEY, StrI(SettingsSync.SEED_VERSION))
        return stored
    end function

    sub saveStamps(map as object)
        Registry.write("settings", STAMPS_KEY, SettingsSync.encodeStamps(map))
    end sub

    ' Call after writing a setting this device's person chose. Unsynced keys
    ' are ignored; with sync off the stamp is still kept (pushed later).
    sub recordChange(localKey as string)
        spec = SettingsSync.specForLocal(localKey)
        if spec = invalid then return
        recordKeys([spec.key])
    end sub

    ' The same by shared key, several stamped with one time and one request:
    ' an edit of homeRowOrder (SettingsSync.layoutChanges) can change both
    ' homeRows and sideMenu.
    sub recordKeys(sharedKeys as object)
        if sharedKeys.count() = 0 then return
        map = stamps()
        now = nowMs()
        request = false
        for each k in sharedKeys
            change = SettingsSync.recordChange(map, k, now, enabled())
            map = change.stamps
            request = change.request
        end for
        saveStamps(map)
        if request then requestSync()
    end sub

    ' Asks MainScene's SettingsSyncTask for a reconcile.
    sub requestSync()
        if m.global = invalid or not m.global.hasField("settingsSyncPing") then return
        m.global.settingsSyncPing = m.global.settingsSyncPing + 1
    end sub

end namespace
