' Streaming quality rules: the tier table, the Auto cap, the stall step-down
' ladder and the bandwidth-probe arithmetic. Pure functions only (no nodes, no
' registry, no network) so tests/StreamQualityTests.brs can run them off-device.
' Tier values match the Apple client's QualityOption.
namespace StreamQuality

    const FLOOR_BPS = 720000
    const AUTO_CEILING_BPS = 100000000
    ' Auto with nothing measured. A LAN server is fast until proven otherwise;
    ' over the internet a high guess is what stalls, and the old 20 Mbps default
    ' landed on exactly the links too slow to finish the probe.
    const UNMEASURED_LOCAL_BPS = 20000000
    const UNMEASURED_REMOTE_BPS = 4000000
    const PROBE_PILOT_BYTES = 250000
    const PROBE_MAX_BYTES = 8000000

    ' Highest first. width is the tier's pixel-width cap: a bitrate cap alone
    ' leaves the server encoding at the source resolution, so "720p" on a
    ' 1080p file used to be 1080p at a lower bitrate.
    function tiers() as object
        return [
            { bps: 20000000, width: 1920, name: "1080p" },
            { bps: 8000000, width: 1280, name: "720p" },
            { bps: 4000000, width: 854, name: "480p" },
            { bps: 2000000, width: 1280, name: "720p" },
            { bps: 1000000, width: 854, name: "480p" },
            { bps: 720000, width: 640, name: "360p" }
        ]
    end function

    ' "20 Mbps", "2.5 Mbps", "720 kbps".
    function bitrateLabel(bps as integer) as string
        if bps < 1000000 then return Int(bps / 1000 + 0.5).ToStr() + " kbps"
        tenths = Int(bps / 100000 + 0.5)
        whole = tenths \ 10
        frac = tenths mod 10
        if frac = 0 or whole >= 10 then return Int(bps / 1000000 + 0.5).ToStr() + " Mbps"
        return whole.ToStr() + "." + frac.ToStr() + " Mbps"
    end function

    ' "720p · 2 Mbps" for a tier, the bare bitrate for any other cap.
    function label(bps as integer) as string
        for each t in tiers()
            if t.bps = bps then return t.name + " " + Chr(183) + " " + bitrateLabel(bps)
        end for
        return bitrateLabel(bps)
    end function

    ' Width cap that goes with an explicit bitrate cap (a tier, or a Settings
    ' value). 0 = none: above the 1080p tier nothing should be scaled down.
    function widthForCap(bps as integer) as integer
        if bps <= 0 or bps > 20000000 then return 0
        width = 0
        ' Lowest tier at or above the cap, so an in-between cap gets the tier
        ' it sits under.
        for each t in tiers()
            if t.bps >= bps then width = t.width
        end for
        return width
    end function

    ' Width cap for Auto. Auto sends none while the link can carry a full
    ' picture: a width condition also blocks direct play of anything wider.
    ' Below 3 Mbps a re-encode is certain and a smaller frame is the better
    ' use of the bits.
    function autoMaxWidth(capBps as integer) as integer
        if capBps <= 0 or capBps >= 3000000 then return 0
        if capBps >= 1500000 then return 1280
        if capBps >= 900000 then return 854
        return 640
    end function

    ' The Auto cap: 85% of the measured downstream, clamped to the lowest tier
    ' and a sane ceiling. Unmeasured (<= 0) falls back on where the server is.
    function autoCapBps(measuredBps as integer, isLocal as boolean) as integer
        if measuredBps <= 0
            if isLocal then return UNMEASURED_LOCAL_BPS
            return UNMEASURED_REMOTE_BPS
        end if
        cap = Int(measuredBps * 0.85)
        if cap < FLOOR_BPS then cap = FLOOR_BPS
        if cap > AUTO_CEILING_BPS then cap = AUTO_CEILING_BPS
        return cap
    end function

    ' Next cap after a stall at currentBps, or 0 when there is nowhere lower.
    ' Each step roughly halves: the highest tier at or under half the current
    ' rate, then the floor. 20 -> 8 -> 4 -> 2 -> 1 Mbps -> 720 kbps.
    function nextStepDownBps(currentBps as integer) as integer
        if currentBps <= FLOOR_BPS then return 0
        for each t in tiers()
            if t.bps * 2 <= currentBps then return t.bps
        end for
        return FLOOR_BPS
    end function

    ' The Maximum Bitrate setting is stored in Mbps as a string ("20", "0.72");
    ' "0"/"" is Auto. "3" is the pre-1.6.3 "480p (3 Mbps)" option, which is now
    ' the 4 Mbps tier.
    function settingsCapBps(stored as string) as integer
        stored = stored.Trim()
        if stored = "3" then return 4000000
        ' Whole Mbps stay in integer arithmetic; a single-precision float
        ' cannot hold 8000000.5, so rounding there lands on 8000001.
        if Instr(1, stored, ".") = 0 then return stored.ToInt() * 1000000
        kbps = Int(Val(stored) * 1000 + 0.5)
        if kbps <= 0 then return 0
        return kbps * 1000
    end function

    ' Loopback, RFC 1918, link-local, .local and single-label hosts: none of
    ' them resolve anywhere but the local network. Everything else, Tailscale's
    ' 100.64/10 included, is a remote link.
    function isLocalServer(url as string) as boolean
        host = LCase(url.Trim())
        p = Instr(1, host, "://")
        if p > 0 then host = Mid(host, p + 3)
        p = Instr(1, host, "/")
        if p > 0 then host = Left(host, p - 1)
        if host = "" then return false
        if Left(host, 1) = "["
            ' IPv6 literal: ::1, fe80::/10 link-local, fc00::/7 unique-local.
            closeAt = Instr(1, host, "]")
            if closeAt = 0 then return false
            v6 = Mid(host, 2, closeAt - 2)
            return v6 = "::1" or Left(v6, 5) = "fe80:" or Left(v6, 2) = "fc" or Left(v6, 2) = "fd"
        end if
        p = Instr(1, host, ":")
        if p > 0 then host = Left(host, p - 1)
        if host = "localhost" or Right(host, 6) = ".local" then return true
        parts = host.Split(".")
        if parts.Count() = 1 then return true
        if parts.Count() <> 4 then return false
        octets = []
        for each part in parts
            if part = "" or part.Len() > 3 then return false
            for i = 1 to part.Len()
                c = Asc(Mid(part, i, 1))
                if c < 48 or c > 57 then return false
            end for
            octets.push(part.ToInt())
        end for
        a = octets[0]
        b = octets[1]
        if a = 127 or a = 10 then return true
        if a = 192 and b = 168 then return true
        if a = 169 and b = 254 then return true
        return a = 172 and b >= 16 and b <= 31
    end function

    ' ---------- Bandwidth probe ----------

    ' Bits per second for bytes received over elapsedMs. 0 when there is
    ' nothing to divide.
    function probeRateBps(bytes as integer, elapsedMs as integer) as integer
        if bytes <= 0 or elapsedMs <= 0 then return 0
        rate = (bytes * 8.0) / (elapsedMs / 1000.0)
        ' Past a gigabit the number is timer noise, and it overflows an integer.
        if rate > 1000000000 then return 1000000000
        return Int(rate)
    end function

    ' Size of the second download, from the pilot's result: about six seconds
    ' at the pilot's rate, so a fast link still gets the full-size sample and a
    ' slow one is never asked for more than it can finish. 0 = the pilot alone
    ' ran long enough to be the measurement.
    function probeFollowUpBytes(pilotBps as integer, pilotMs as integer) as integer
        if pilotBps <= 0 or pilotMs >= 3000 then return 0
        bytes = Int((pilotBps / 8.0) * 6)
        if bytes < 500000 then bytes = 500000
        if bytes > PROBE_MAX_BYTES then bytes = PROBE_MAX_BYTES
        return bytes
    end function

    ' A download that ran out of time is still a measurement: the link is at
    ' best what would have finished the request in that time, and no faster
    ' than an earlier completed sample said. (The platform does not expose the
    ' bytes that did arrive, so the bound is all there is.)
    function probeTimeoutEstimateBps(requestedBytes as integer, elapsedMs as integer, earlierBps as integer) as integer
        bound = probeRateBps(requestedBytes, elapsedMs)
        if earlierBps > 0 and (bound = 0 or earlierBps < bound) then return earlierBps
        return bound
    end function

    ' ---------- Adaptive Auto (what playback itself downloaded at) ----------

    ' A light, smooth 4K transcode: what a wireless link is trusted to carry
    ' until playback there has shown more.
    const SMOOTH_4K_BPS = 24000000
    ' Readings kept per server and link kind. Few and recent: a link that
    ' changes (a new router, another room) should not be judged by last month.
    const SUSTAINED_SAMPLE_LIMIT = 5
    ' A reading counts only over this much video: the first segments of a
    ' stream arrive in a burst that says little about the link.
    const SUSTAINED_MIN_BYTES = 16000000
    ' Up only when it pays: the link carries the source, or twice the cap.
    const UPGRADE_MIN_RATIO = 2
    ' Quiet time after a rebuffer or stall before stepping back up.
    const RECOVERY_QUIET_SECS = 15
    ' Between automatic quality changes. Each rebuilds the server's stream, so
    ' they must not see-saw.
    const ADAPTIVE_COOLDOWN_SECS = 120

    ' roDeviceInfo.GetConnectionType(): "WiredConnection", "WiFiConnection",
    ' or "" offline. Anything not Ethernet is treated as wireless.
    function isWiredConnection(connectionType as string) as boolean
        return connectionType = "WiredConnection"
    end function

    ' Registry key for one server over one kind of link: scheme, host and
    ' port lower-cased plus any base path, without a trailing slash.
    function sustainedKey(serverUrl as string, isWired as boolean) as string
        url = serverUrl.Trim()
        p = Instr(1, url, "://")
        rest = url
        scheme = ""
        if p > 0
            scheme = LCase(Left(url, p - 1)) + "://"
            rest = Mid(url, p + 3)
        end if
        slash = Instr(1, rest, "/")
        host = rest
        path = ""
        if slash > 0
            host = Left(rest, slash - 1)
            path = Mid(rest, slash)
        end if
        while Right(path, 1) = "/"
            path = Left(path, path.Len() - 1)
        end while
        kind = "|wireless"
        if isWired then kind = "|wired"
        return scheme + LCase(host) + path + kind
    end function

    ' Adds one HLS segment (Video.downloadedSegment SegSize / DownloadDuration)
    ' to a {bytes, ms} window. Returns the window's rate once it holds
    ' SUSTAINED_MIN_BYTES of video, and starts a fresh window; 0 until then.
    function addSegment(window as object, segBytes as integer, downloadMs as integer) as integer
        if segBytes <= 0 or downloadMs < 0 then return 0
        window.bytes = window.bytes + segBytes
        window.ms = window.ms + downloadMs
        if window.bytes < SUSTAINED_MIN_BYTES then return 0
        rate = probeRateBps(window.bytes, window.ms)
        window.bytes = 0
        window.ms = 0
        return rate
    end function

    ' Registry JSON hands numbers back as Integer, LongInteger or Double.
    function isNumber(value as dynamic) as boolean
        t = LCase(type(value))
        return t = "integer" or t = "roint" or t = "rointeger" or t = "longinteger" or t = "rolonginteger" or t = "float" or t = "rofloat" or t = "double" or t = "rodouble"
    end function

    ' Whether a transcode re-encodes the VIDEO, from its TranscodeReasons
    ' (the TranscodingUrl's comma-separated, maybe %2C-encoded, value). A
    ' re-encode's segments arrive no faster than the server encodes them, so
    ' its readings are the encoder's pace, not the link's: remembered, they
    ' would hold every later Auto start on that link down to it (seen on the
    ' dev Roku: a 10 Mbps 4K re-encode read 14 Mbps on an 80 Mbps link). A
    ' remux (video copied) or an audio-only change is not paced that way.
    ' DirectPlayError alone only says direct play was not allowed.
    function reencodesVideo(reasons as string) as boolean
        list = LCase(reasons).Replace("%2c", ",").Split(",")
        for each r in list
            r = r.Trim()
            if Left(r, 5) = "video" then return true
            if r = "containerbitrateexceedslimit" or r = "interlacedvideonotsupported" or r = "anamorphicvideonotsupported" or r = "refframesnotsupported" then return true
        end for
        return false
    end function

    ' The remembered readings with one more, newest last, at most
    ' SUSTAINED_SAMPLE_LIMIT of them.
    function addSustainedSample(samples as object, bps as integer) as object
        kept = []
        if type(samples) = "roArray"
            for each s in samples
                if isNumber(s) and s > 0 then kept.push(Int(s))
            end for
        end if
        if bps > 0 then kept.push(bps)
        while kept.Count() > SUSTAINED_SAMPLE_LIMIT
            kept.Shift()
        end while
        return kept
    end function

    ' The link's sustained rate: the LOWEST recent reading, not the average.
    ' One slow stretch (a stall) is the evidence that matters. 0 = none.
    function sustainedBps(samples as object) as integer
        if type(samples) <> "roArray" then return 0
        low = 0
        for each s in samples
            if isNumber(s) and s > 0 and (low = 0 or s < low) then low = Int(s)
        end for
        return low
    end function

    ' The most a wireless link is trusted to carry: half its sustained rate
    ' (a 4K remux's VBR peaks run to about twice its average), never more than
    ' the Auto cap; the smooth-4K rate while nothing is remembered.
    function wirelessCeilingBps(capBps as integer, sustained as integer) as integer
        if sustained <= 0
            if capBps < SMOOTH_4K_BPS then return capBps
            return SMOOTH_4K_BPS
        end if
        half = sustained \ 2
        if capBps < half then return capBps
        return half
    end function

    ' The Auto request's bitrate. Ethernet carries what the probe measured;
    ' Wi-Fi is held to wirelessCeilingBps, because the burst probe reads
    ' Wi-Fi's peak and a copied 4K source then stalls on its VBR peaks.
    function linkCapBps(capBps as integer, isWired as boolean, sustained as integer) as integer
        if isWired then return capBps
        return wirelessCeilingBps(capBps, sustained)
    end function

    ' Doubles after every upgrade that stalled straight back down, to 32x.
    function adaptiveCooldownSecs(failedUpgrades as integer) as integer
        n = failedUpgrades
        if n < 0 then n = 0
        if n > 5 then n = 5
        secs = ADAPTIVE_COOLDOWN_SECS
        for i = 1 to n
            secs = secs * 2
        end for
        return secs
    end function

    ' Whether to rebuild a stream that Auto (or a stall step-down from Auto)
    ' holds below its source, now that playback shows the link carries more.
    ' -1 = no; 0 = now; n = not for another n seconds. ctx:
    '   isAuto, isWired, isTranscoding, isBusy (booleans);
    '   autoCap, activeCap, sourceBps, sustainedBps (bps, 0 = unknown);
    '   secondsSinceRecovery, secondsSinceQualityChange (-1 = never);
    '   failedUpgrades.
    function sustainedUpgrade(ctx as object) as integer
        if not ctx.isAuto or not ctx.isTranscoding then return -1
        if ctx.sourceBps <= 0 or ctx.activeCap <= 0 or ctx.sustainedBps <= 0 then return -1
        if ctx.activeCap >= ctx.sourceBps then return -1
        if ctx.isWired
            ceiling = ctx.autoCap
            if ctx.sustainedBps < ceiling then ceiling = ctx.sustainedBps
        else
            ceiling = wirelessCeilingBps(ctx.autoCap, ctx.sustainedBps)
        end if
        if ceiling < ctx.sourceBps and ceiling < ctx.activeCap * UPGRADE_MIN_RATIO then return -1
        wait = 0
        if ctx.isBusy then wait = RECOVERY_QUIET_SECS
        if ctx.secondsSinceRecovery >= 0 and RECOVERY_QUIET_SECS - ctx.secondsSinceRecovery > wait then wait = RECOVERY_QUIET_SECS - ctx.secondsSinceRecovery
        if ctx.secondsSinceQualityChange >= 0
            remaining = adaptiveCooldownSecs(ctx.failedUpgrades) - ctx.secondsSinceQualityChange
            if remaining > wait then wait = remaining
        end if
        return wait
    end function

    ' ---------- Device profile ----------

    ' HEVC VideoRangeType values the server may hand over untouched. Dolby
    ' Vision with an HDR10/HLG/SDR base layer plays as that base layer on any
    ' HEVC Roku. Left off the list, Jellyfin answered
    ' VideoRangeTypeNotSupported and re-encoded the whole 4K picture. Bare
    ' DOVI (Profile 5) has no base layer, so it is offered only to a display
    ' that does Dolby Vision; anywhere else it is green and purple.
    function hevcRangeTypes(dolbyVision as boolean) as string
        types = "SDR|HDR10|HDR10Plus|HLG|DOVIWithHDR10|DOVIWithHDR10Plus|DOVIWithHLG|DOVIWithSDR"
        if dolbyVision then types += "|DOVI"
        return types
    end function

    ' IsRequired false: a stream whose range the server could not work out
    ' still direct-plays, as it did before this condition existed.
    function videoRangeProfile(dolbyVision as boolean) as object
        return { Type: "Video", Codec: "hevc", Conditions: [{ Condition: "EqualsAny", Property: "VideoRangeType", Value: hevcRangeTypes(dolbyVision), IsRequired: false }] }
    end function

    ' The HLS transcode's video codecs. H.264 stays first, so a re-encode is
    ' still H.264; HEVC after it lets the server COPY an HEVC source into the
    ' segments (a remux) when only the audio or container needs changing,
    ' instead of re-encoding 4K ("300": DTS audio re-encoded the 44 Mbps 4K
    ' picture to H.264). The retry after a rejected direct play therefore
    ' tries a remux first; if that fails too, the step-down re-encodes.
    function transcodeVideoCodecs(hevc as boolean) as string
        if hevc then return "h264,hevc"
        return "h264"
    end function

    ' Video CodecProfile conditions: the HD-output limit, tightened by a
    ' tier's width cap. [] = unconstrained.
    function videoConditions(uhd as boolean, maxWidth as integer) as object
        width = 0
        if not uhd then width = 1920
        if maxWidth > 0 and (width = 0 or maxWidth < width) then width = maxWidth
        conditions = []
        if width > 0 then conditions.push({ Condition: "LessThanEqual", Property: "Width", Value: width.ToStr(), IsRequired: true })
        ' An HD-only device can't direct-play 4K; ask the server to scale it.
        if not uhd then conditions.push({ Condition: "LessThanEqual", Property: "Height", Value: "1080", IsRequired: true })
        return conditions
    end function

    ' The audio half of the profile, from rokuCapabilities: codecs to direct
    ' play, codecs to stream (the server encodes to the FIRST one it can't
    ' copy), the channel cap, and the AAC CodecProfile.
    ' Surround goes out as Dolby when the device takes it. Offering "aac,ac3"
    ' let the server turn E-AC3 5.1 into 5.1 AAC, which a Roku that can't
    ' decode it plays for two seconds and then freezes on, with no error to
    ' retry from (Oct 2026, a remote viewer's every episode). AAC is held to
    ' stereo unless the device says it decodes six channels.
    function audioProfile(caps as object) as object
        dolby = []
        if caps.ac3 then dolby.push("ac3")
        if caps.eac3 then dolby.push("eac3")
        surroundAac = caps.surround and caps.aac6
        channels = "2"
        if caps.surround and (surroundAac or dolby.Count() > 0) then channels = "6"
        stream = "aac"
        if dolby.Count() > 0
            if channels = "6"
                stream = dolby.Join(",") + ",aac"
            else
                stream = "aac," + dolby.Join(",")
            end if
        end if
        direct = "aac,mp3"
        if dolby.Count() > 0 then direct += "," + dolby.Join(",")
        profiles = []
        if not surroundAac
            profiles.push({ Type: "VideoAudio", Codec: "aac", Conditions: [{ Condition: "LessThanEqual", Property: "AudioChannels", Value: "2", IsRequired: true }] })
        end if
        return { direct: direct, stream: stream, channels: channels, profiles: profiles }
    end function

end namespace
