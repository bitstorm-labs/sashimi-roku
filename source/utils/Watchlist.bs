import "pkg:/source/utils/Seerr.bs"

' The Watchlist (the Sashimi Lists plugin's /SashimiLists/Watchlist): one
' private list per person that can hold titles the server doesn't have,
' stored by external id, with optional two-way Plex sync run by the plugin.
' Every decision the screens and tasks make about it lives here as a pure
' function, so tests/WatchlistTests.brs runs them off-device: the plugin's
' 404 (no Watchlist on this server), which titles qualify, the add bodies,
' the any-agreeing-id check, tiles and their pills, what OK does, the Plex
' card, line and * menu, and the link outcomes.
'
' The Plex token never passes through here: SeerrTask hands it to the plugin
' on its own thread and nothing it returns carries it.
namespace Watchlist

    const PATH = "/SashimiLists/Watchlist"

    function NAME() as string
        return "Watchlist"
    end function

    function CARD_TITLE() as string
        return "Use Plex too?"
    end function

    function CARD_BODY() as string
        return "Connect it and your Plex watchlist and this one stay the same."
    end function

    function CONNECT_LABEL() as string
        return "Connect Plex"
    end function

    function NOT_NOW_LABEL() as string
        return "Not now"
    end function

    function LINKED_TOAST() as string
        return "Your Watchlist now syncs with Plex"
    end function

    function EMPTY_TEXT() as string
        return "Nothing on your Watchlist yet. Add titles with Add to List on any movie or show."
    end function

    ' ---------- Reading the plugin ----------

    ' GET /SashimiLists/Watchlist. A 404 means the plugin (0.2+) isn't there,
    ' so the Watchlist is hidden; anything else that isn't a 2xx with a body
    ' is a failure that hides it for this load only.
    function fromResponse(code as integer, data as dynamic) as object
        v = { available: false, failed: false, plex: invalid, cardDismissed: false, plexOptedOut: false, entries: [] }
        if code = 404 then return v
        if code < 200 or code >= 300 or not Seerr.isAA(data)
            v.failed = true
            return v
        end if
        v.available = true
        if Seerr.isAA(data.plex)
            v.plex = { username: Seerr.getStr(data.plex, "username"), needsReconnect: isTrue(data.plex.needsReconnect) }
        end if
        v.cardDismissed = isTrue(data.cardDismissed)
        ' Plugin 0.2.2+: set when the person disconnected Plex. Older plugins
        ' leave it out, which reads as false.
        v.plexOptedOut = isTrue(data.plexOptedOut)
        for each e in Seerr.getArr(data, "entries")
            n = normalised(e)
            if n <> invalid then v.entries.push(n)
        end for
        return v
    end function

    function normalised(e as dynamic) as dynamic
        if not Seerr.isAA(e) then return invalid
        id = Seerr.getStr(e, "id")
        kind = Seerr.getStr(e, "type")
        if id = "" or (kind <> "Movie" and kind <> "Series") then return invalid
        return {
            id: id, type: kind, title: Seerr.getStr(e, "title"), year: Seerr.getInt(e, "year", -1),
            posterUrl: Seerr.getStr(e, "posterUrl"), tmdbId: idStr(e.tmdbId), tvdbId: idStr(e.tvdbId),
            imdbId: idStr(e.imdbId), addedAt: Seerr.getStr(e, "addedAt"), itemId: Seerr.getStr(e, "itemId")
        }
    end function

    ' A missing field is invalid, and invalid = true is a type mismatch on the device.
    function isTrue(v as dynamic) as boolean
        if v = invalid or GetInterface(v, "ifBoolean") = invalid then return false
        return v
    end function

    ' An id as a string, whether it arrived as one or as a number.
    function idStr(v as dynamic) as string
        if Seerr.isStr(v) then return v
        if Seerr.isNum(v) then return Seerr.numStr(Int(v))
        return ""
    end function

    ' ---------- Which titles qualify ----------

    function idsOfItem(item as dynamic) as object
        ids = { tmdbId: "", tvdbId: "", imdbId: "" }
        if not Seerr.isAA(item) or not Seerr.isAA(item.ProviderIds) then return ids
        for each k in item.ProviderIds
            key = LCase(k)
            v = idStr(item.ProviderIds[k])
            if key = "tmdb" then ids.tmdbId = v
            if key = "tvdb" then ids.tvdbId = v
            if key = "imdb" then ids.imdbId = v
        end for
        return ids
    end function

    function hasAnyId(ids as object) as boolean
        return ids.tmdbId <> "" or ids.tvdbId <> "" or ids.imdbId <> ""
    end function

    ' Movies and shows with an id the plugin can match on. Episodes, seasons,
    ' home videos and YouTube never see the Watchlist, so nothing is accepted
    ' and then silently dropped.
    function accepts(item as dynamic) as boolean
        if not Seerr.isAA(item) then return false
        t = Seerr.getStr(item, "Type")
        if t <> "Movie" and t <> "Series" then return false
        return hasAnyId(idsOfItem(item))
    end function

    ' ---------- Add bodies ----------

    ' A library title. No posterUrl: Jellyfin items have no TMDB path, and the
    ' plugin fills one from the server's remote images.
    function bodyForItem(item as dynamic) as object
        b = { type: Seerr.getStr(item, "Type"), title: Seerr.getStr(item, "Name") }
        y = Seerr.getInt(item, "ProductionYear", -1)
        if y > 0 then b.year = y
        putIds(b, idsOfItem(item))
        return b
    end function

    ' A Seerr title (a Seerr.details result).
    function bodyForSeerr(d as object) as object
        kind = "Movie"
        if d.kind = "tv" then kind = "Series"
        b = { type: kind, title: d.title }
        if Seerr.isNum(d.year) and d.year > 0 then b.year = d.year
        putIds(b, { tmdbId: idStr(d.tmdbId), tvdbId: idStr(d.tvdbId), imdbId: idStr(d.imdbId) })
        poster = Seerr.posterUrl(d.posterPath, 500)
        if poster <> "" then b.posterUrl = poster
        return b
    end function

    sub putIds(b as object, ids as object)
        if ids.tmdbId <> "" then b.tmdbId = ids.tmdbId
        if ids.tvdbId <> "" then b.tvdbId = ids.tvdbId
        if ids.imdbId <> "" then b.imdbId = ids.imdbId
    end sub

    ' ---------- Already on it ----------

    ' The plugin's rule: one agreeing non-empty id is the same title.
    function contains(entries as object, ids as object) as boolean
        for each e in entries
            if ids.tmdbId <> "" and e.tmdbId = ids.tmdbId then return true
            if ids.tvdbId <> "" and e.tvdbId = ids.tvdbId then return true
            if ids.imdbId <> "" and LCase(e.imdbId) = LCase(ids.imdbId) then return true
        end for
        return false
    end function

    ' The Add to List picker's first row.
    function pickerRow(view as object, ids as object) as object
        return { isWatchlist: true, id: "", name: NAME(), count: view.entries.count(), already: contains(view.entries, ids) }
    end function

    ' ---------- Requested status ----------

    function seerrKind(entry as object) as string
        if entry.type = "Series" then return "tv"
        return "movie"
    end function

    function seerrKey(entry as object) as string
        if entry.tmdbId = "" then return ""
        return Seerr.itemKey(seerrKind(entry), Val(entry.tmdbId))
    end function

    ' The titles worth asking Seerr about: not on the server and with a TMDB
    ' id (the only id Seerr pages take), each once.
    function statusTargets(entries as object) as object
        out = []
        seen = {}
        for each e in entries
            if e.itemId <> "" then continue for
            key = seerrKey(e)
            if key = "" or seen.DoesExist(key) then continue for
            seen[key] = true
            out.push({ kind: seerrKind(e), tmdbId: Int(Val(e.tmdbId)) })
        end for
        return out
    end function

    function isRequested(badge as string) as boolean
        return badge = "pending" or badge = "coming"
    end function

    ' ---------- Tiles and OK ----------

    function tile(entry as object, requested as boolean) as object
        t = { title: entry.title, itemId: entry.itemId, posterUrl: entry.posterUrl, dimmed: false, pill: "" }
        if entry.itemId = ""
            t.dimmed = true
            t.pill = "Not on server"
            if requested then t.pill = "Requested"
        end if
        return t
    end function

    ' What OK on a tile does: a title the server has opens its page; one it
    ' doesn't opens the Watchlist's own title page (WatchlistTitleScreen,
    ' Watchlist v2), which explains itself when the plugin is too old.
    function onSelect(entry as object, seerrActive as boolean) as object
        if entry.itemId <> "" then return { kind: "item", itemId: entry.itemId }
        return { kind: "details", entry: entry }
    end function

    ' Seerr's page for a title (Request), or invalid with no TMDB id: Seerr
    ' pages take nothing else.
    function seerrTarget(entry as object) as dynamic
        if entry.tmdbId = "" then return invalid
        return { kind: seerrKind(entry), tmdbId: Int(Val(entry.tmdbId)), title: entry.title, posterPath: "" }
    end function

    ' ---------- Plex card, line and menu ----------

    function showCard(view as object) as boolean
        return view.plex = invalid and not view.cardDismissed
    end function

    ' The spec keeps Reconnect in the * menu; on a TV that is easy to miss, so
    ' a paused sync says where it is.
    function plexLine(view as object) as string
        if view.plex = invalid then return ""
        if view.plex.needsReconnect then return "Plex sync is paused. Press * to reconnect."
        return Chr(10003) + " Synced with Plex"
    end function

    ' The page's line under its title: how many, then the Plex state.
    function metaLine(count as integer, view as object) as string
        parts = []
        if count = 1 then parts.push("1 title")
        if count > 1 then parts.push(count.ToStr() + " titles")
        line = plexLine(view)
        if line <> "" then parts.push(line)
        return parts.Join("   " + Chr(183) + "   ")
    end function

    function optionsMenu(view as object, tileFocused as boolean) as object
        out = []
        if tileFocused then out.push({ kind: "remove", label: "Remove from Watchlist" })
        if view.plex = invalid
            out.push({ kind: "connect", label: CONNECT_LABEL() })
        else
            if view.plex.needsReconnect then out.push({ kind: "reconnect", label: "Reconnect Plex" })
            out.push({ kind: "disconnect", label: "Disconnect Plex" })
        end if
        return out
    end function

    ' ---------- Linking ----------

    ' POST /SashimiLists/Watchlist/Plex. The plugin answers 422 when plex.tv
    ' rejects the token (a 401 would read as an expired Jellyfin session) and
    ' 409 { username, newUsername } when the Watchlist syncs with a different
    ' Plex account, and 503 when it can't reach plex.tv.
    function linkOutcome(code as integer, data as dynamic) as object
        if code >= 200 and code < 300 then return { kind: "linked", username: Seerr.getStr(data, "username") }
        if code = 409 then return { kind: "conflict", username: Seerr.getStr(data, "username"), newUsername: Seerr.getStr(data, "newUsername") }
        if code = 422 then return { kind: "rejected" }
        if code = 404 then return { kind: "unavailable" }
        ' The plugin answers 503 when plex.tv is down: Plex, not the token.
        if code >= 500 and code < 600 then return { kind: "unreachable" }
        return { kind: "failed" }
    end function

    ' What linking came to, as the task's response fields. auto (a Requests
    ' sign-in) never reports a failure, so the Watchlist can't fail or hold
    ' up that sign-in; a re-sent token for the same account stays quiet.
    function linkResult(o as object, auto as boolean, stage as string) as object
        ' watchlistLinked is the toast; watchlistChanged is "re-read the link":
        ' a quiet same-account refresh still clears a paused sync.
        if o.kind = "linked" then return { watchlistLinked: (not auto) or stage = "first", watchlistChanged: true }
        if o.kind = "conflict"
            return { watchlistConflict: { current: Seerr.getStr(o, "username"), wanted: Seerr.getStr(o, "newUsername") } }
        end if
        if auto then return {}
        return { watchlistError: o.kind }
    end function

    ' Connect Plex says why a link failed; a Requests sign-in's auto-link is
    ' quiet, but a switch the person confirmed always reports a failure.
    function showsLinkError(action as string, connecting as boolean) as boolean
        return connecting or action = "watchlistReplace"
    end function

    function linkErrorText(kind as string) as string
        if kind = "rejected" then return "Plex didn't accept that sign-in. Try again."
        if kind = "unreachable" then return "Couldn't reach Plex. Try again."
        return "Couldn't connect Plex. Check your connection."
    end function

    ' A Requests Plex sign-in links the Watchlist too, but never silently
    ' over a different account: "first" links, "refresh" re-sends the token
    ' (the plugin answers 409 if it is someone else), "skip" does nothing.
    function autoLinkStep(view as object) as string
        if not view.available then return "skip"
        ' Disconnected on purpose: a Requests sign-in must not undo that. An
        ' explicit Connect (card, * menu, Settings) never asks this.
        if view.DoesExist("plexOptedOut") and isTrue(view.plexOptedOut) then return "skip"
        if view.plex = invalid then return "first"
        return "refresh"
    end function

    function replacePrompt(wanted as string, current as string) as object
        who = "this Plex account"
        if wanted <> "" then who = "Plex account " + wanted
        msg = "It syncs with another Plex account now."
        if current <> "" then msg = "It syncs with " + current + " now."
        return { title: "Sync your Watchlist with " + who + " instead?", message: msg }
    end function

    function switchLabel(wanted as string) as string
        if wanted = "" then return "Switch Account"
        return "Switch to " + wanted
    end function

    ' The on-server entries' ids for /Items?Ids=, comma-joined, at most
    ' `size` per batch: a few hundred ids in one request line would pass a
    ' server's 8 KB limit and lose every tile's artwork at once.
    function itemIdBatches(entries as object, size as integer) as object
        out = []
        cur = []
        for each e in entries
            if e.itemId = "" then continue for
            cur.push(e.itemId)
            if cur.count() = size
                out.push(cur.Join(","))
                cur = []
            end if
        end for
        if cur.count() > 0 then out.push(cur.Join(","))
        return out
    end function

    ' The on-server ids among the Lists card's posters, for one /Items lookup.
    function coverItemIds(cover as object) as string
        ids = []
        for each c in cover
            if c.itemId <> "" then ids.push(c.itemId)
        end for
        return ids.Join(",")
    end function

    ' The card's posters with their Primary image tag (items: itemId ->
    ' library item), so ImageUrl's &tag= changes when a poster is replaced.
    function tagCover(cover as object, items as dynamic) as object
        out = []
        for each c in cover
            tag = ""
            if c.itemId <> "" and Seerr.isAA(items)
                it = items[c.itemId]
                if Seerr.isAA(it) and Seerr.isAA(it.ImageTags) then tag = Seerr.getStr(it.ImageTags, "Primary")
            end if
            out.push({ itemId: c.itemId, posterUrl: c.posterUrl, tag: tag, dimmed: c.itemId = "" })
        end for
        return out
    end function

    ' ---------- Settings > Plex ----------

    ' The Plex row in Settings: a second way to the same link as the card, so
    ' anyone who pressed "Not now" can still find it. Hidden when the server
    ' has no Watchlist.
    function settingsRow(view as object) as object
        row = { visible: view.available = true, title: "Plex", value: "Not connected", detail: "Keeps your Watchlist in sync with your Plex watchlist.", actions: [] }
        if view.plex = invalid
            row.actions.push({ kind: "connect", label: CONNECT_LABEL() })
            return row
        end if
        row.value = "Connected"
        if view.plex.username <> "" then row.value = "Connected as " + view.plex.username
        if view.plex.needsReconnect then row.actions.push({ kind: "reconnect", label: "Reconnect Plex" })
        row.actions.push({ kind: "disconnect", label: "Disconnect" })
        return row
    end function

    ' ---------- The Lists page card ----------

    function cardMeta(count as integer) as string
        return "Private " + Chr(183) + " " + count.ToStr()
    end function

    ' Same rule as ListsModel.coverArt: the first three drawable entries. A
    ' poster draws from its library item or, when missing, its stored poster,
    ' dimmed like the page's "Not on server" tiles.
    function coverSources(entries as object) as object
        out = []
        for each e in entries
            if e.itemId = "" and e.posterUrl = "" then continue for
            out.push({ itemId: e.itemId, posterUrl: e.posterUrl, dimmed: e.itemId = "" })
            if out.count() = 3 then exit for
        end for
        return out
    end function

    ' ---------- v2: + Add search ----------

    ' The server takes 1-200 characters; under two isn't worth a TMDB call.
    function searchReady(text as string) as boolean
        n = Len(text.Trim())
        return n >= 2 and n <= 200
    end function

    ' GET /SashimiLists/Watchlist/Search. A 404 means a plugin older than
    ' 0.3.0: no + Add.
    function searchFromResponse(code as integer, data as dynamic) as object
        r = { available: false, failed: false, query: "", onServer: [], notOnServer: [] }
        if code = 404 then return r
        if code < 200 or code >= 300 or not Seerr.isAA(data)
            r.failed = true
            return r
        end if
        r.available = true
        r.query = Seerr.getStr(data, "query")
        for each h in Seerr.getArr(data, "onServer")
            n = hitFrom(h)
            if n <> invalid then r.onServer.push(n)
        end for
        for each h in Seerr.getArr(data, "notOnServer")
            n = hitFrom(h)
            if n <> invalid then r.notOnServer.push(n)
        end for
        return r
    end function

    function hitFrom(h as dynamic) as dynamic
        if not Seerr.isAA(h) then return invalid
        kind = Seerr.getStr(h, "type")
        title = Seerr.getStr(h, "title")
        if (kind <> "Movie" and kind <> "Series") or title = "" then return invalid
        n = { type: kind, title: title, year: Seerr.getInt(h, "year", -1), tmdbId: idStr(h.tmdbId), tvdbId: idStr(h.tvdbId), imdbId: idStr(h.imdbId), posterUrl: Seerr.getStr(h, "posterUrl"), overview: Seerr.getStr(h, "overview"), itemId: Seerr.getStr(h, "itemId"), onWatchlist: isTrue(h.onWatchlist), entryId: Seerr.getStr(h, "watchlistEntryId") }
        if not hasAnyId(n) then return invalid
        return n
    end function

    ' Which titles were added on this screen, so their + turns to Added.
    function hitKey(hit as object) as string
        return hit.type + "|" + hit.tmdbId + "|" + hit.tvdbId + "|" + LCase(hit.imdbId)
    end function

    ' The results list: each group under its header, "No results" when empty.
    function searchRows(r as object, added as object) as object
        rows = []
        groups = [{ text: "On your server", hits: r.onServer }, { text: "Not on server", hits: r.notOnServer }]
        for each g in groups
            rows.push({ kind: "header", text: g.text })
            if g.hits.count() = 0 then rows.push({ kind: "empty", text: "No results" })
            for each h in g.hits
                rows.push({ kind: "hit", hit: h, added: h.onWatchlist or added.DoesExist(hitKey(h)) })
            end for
        end for
        return rows
    end function

    function hitLine(hit as object) as string
        parts = []
        if Seerr.isNum(hit.year) and hit.year > 0 then parts.push(Int(hit.year).ToStr())
        if hit.type = "Series" then parts.push("Show") else parts.push("Movie")
        return parts.Join(" " + Chr(183) + " ")
    end function

    function addLabel(added as boolean) as string
        if added then return Chr(10003) + " Added"
        return "+ Add"
    end function

    ' The add body: the hit's own fields, which match the add route's.
    function hitBody(hit as object) as object
        b = { type: hit.type, title: hit.title }
        if Seerr.isNum(hit.year) and hit.year > 0 then b.year = hit.year
        if hit.posterUrl <> "" then b.posterUrl = hit.posterUrl
        putIds(b, hit)
        return b
    end function

    ' A library title opens its own page; one the server doesn't have, the
    ' Watchlist's title page.
    function hitOpen(hit as object) as object
        if hit.itemId <> "" then return { kind: "item", item: { Id: hit.itemId, Type: hit.type, Name: hit.title } }
        return { kind: "details", hit: hit }
    end function

    ' ---------- v2: the title page for titles not on the server ----------

    ' What the title page starts from (it draws this at once and fills the
    ' rest from /Details): a Watchlist entry, which is on the Watchlist...
    function entrySource(e as object) as object
        return { type: e.type, title: e.title, year: e.year, posterUrl: e.posterUrl, tmdbId: e.tmdbId, tvdbId: e.tvdbId, imdbId: e.imdbId, onWatchlist: true, entryId: e.id }
    end function

    ' ...or a search hit, which may have just been added on the search screen.
    function hitSource(h as object, added as boolean) as object
        return { type: h.type, title: h.title, year: h.year, posterUrl: h.posterUrl, tmdbId: h.tmdbId, tvdbId: h.tvdbId, imdbId: h.imdbId, onWatchlist: h.onWatchlist or added, entryId: h.entryId }
    end function

    function emptyText(canAdd as boolean) as string
        if canAdd then return "Nothing on your Watchlist yet. Choose + Add to find something."
        return EMPTY_TEXT()
    end function

    ' GET /SashimiLists/Watchlist/Details?<this>: every id there is.
    function detailsQuery(x as object) as string
        q = "type=" + LCase(x.type)
        if x.tmdbId <> "" then q = q + "&tmdbId=" + x.tmdbId
        if x.tvdbId <> "" then q = q + "&tvdbId=" + x.tvdbId
        if x.imdbId <> "" then q = q + "&imdbId=" + x.imdbId
        return q
    end function

    ' found=false on a 404: no provider knows it, or the plugin is too old;
    ' the page then draws what the entry knows and keeps Add/Remove working.
    function detailsFromResponse(code as integer, data as dynamic) as object
        d = { found: false, failed: false, type: "", title: "", year: -1, overview: "", posterUrl: "", backdropUrl: "", runtimeMinutes: 0, seasonCount: 0, officialRating: "", genres: [], communityRating: 0, source: "", tmdbId: "", tvdbId: "", imdbId: "", itemId: "", onWatchlist: false, entryId: "" }
        if code = 404 then return d
        if code < 200 or code >= 300 or not Seerr.isAA(data)
            d.failed = true
            return d
        end if
        d.found = true
        d.type = Seerr.getStr(data, "type")
        d.title = Seerr.getStr(data, "title")
        d.year = Seerr.getInt(data, "year", -1)
        d.overview = Seerr.getStr(data, "overview")
        d.posterUrl = Seerr.getStr(data, "posterUrl")
        d.backdropUrl = Seerr.getStr(data, "backdropUrl")
        d.runtimeMinutes = Seerr.getInt(data, "runtimeMinutes", 0)
        d.seasonCount = Seerr.getInt(data, "seasonCount", 0)
        d.officialRating = Seerr.getStr(data, "officialRating")
        for each g in Seerr.getArr(data, "genres")
            if Seerr.isStr(g) and g <> "" then d.genres.push(g)
        end for
        if Seerr.isNum(data.communityRating) then d.communityRating = data.communityRating
        d.source = Seerr.getStr(data, "source")
        d.tmdbId = idStr(data.tmdbId)
        d.tvdbId = idStr(data.tvdbId)
        d.imdbId = idStr(data.imdbId)
        d.itemId = Seerr.getStr(data, "itemId")
        d.onWatchlist = isTrue(data.onWatchlist)
        d.entryId = Seerr.getStr(data, "watchlistEntryId")
        return d
    end function

    ' "2021 · 2h 35m · PG-13 · Science Fiction, Adventure · ★ 7.8"; a show
    ' gives its seasons. What the provider lacks is left out.
    function detailsMeta(d as object) as string
        parts = []
        if Seerr.isNum(d.year) and d.year > 0 then parts.push(Int(d.year).ToStr())
        length = lengthText(d)
        if length <> "" then parts.push(length)
        if d.officialRating <> "" then parts.push(d.officialRating)
        g = ""
        n = 0
        for each genre in d.genres
            if n > 0 then g = g + ", "
            g = g + genre
            n = n + 1
            if n = 2 then exit for
        end for
        if g <> "" then parts.push(g)
        if d.communityRating > 0 then parts.push(Chr(9733) + " " + ratingText(d.communityRating))
        return parts.Join(" " + Chr(183) + " ")
    end function

    ' "2h 35m" for a movie, "4 Seasons" for a show, "" when unknown.
    function lengthText(d as object) as string
        if d.type = "Series"
            if d.seasonCount = 1 then return "1 Season"
            if d.seasonCount > 1 then return d.seasonCount.ToStr() + " Seasons"
            return ""
        end if
        if not Seerr.isNum(d.runtimeMinutes) or d.runtimeMinutes <= 0 then return ""
        h = Int(d.runtimeMinutes / 60)
        mins = d.runtimeMinutes - h * 60
        if h = 0 then return mins.ToStr() + "m"
        if mins = 0 then return h.ToStr() + "h"
        return h.ToStr() + "h " + mins.ToStr() + "m"
    end function

    ' The title page is laid out like a movie's detail screen, so it splits
    ' detailsMeta's one line the same way: "2021 • 2h 35m" under the title,
    ' the score beside the TMDB logo, and the age rating and genres as chips.
    function titlePageMeta(d as object) as string
        parts = []
        if Seerr.isNum(d.year) and d.year > 0 then parts.push(Int(d.year).ToStr())
        length = lengthText(d)
        if length <> "" then parts.push(length)
        return parts.Join(" " + Chr(8226) + " ")
    end function

    ' "" when the provider has no score.
    function titlePageScore(d as object) as string
        if not Seerr.isNum(d.communityRating) or d.communityRating <= 0 then return ""
        return ratingText(d.communityRating)
    end function

    ' The age rating, then genres: four chips at most, as on the detail screen.
    function titlePageTags(d as object) as object
        tags = []
        if Seerr.isStr(d.officialRating) and d.officialRating <> "" then tags.push(d.officialRating)
        if d.genres <> invalid
            for each g in d.genres
                if tags.count() >= 4 then exit for
                tags.push(g)
            end for
        end if
        return tags
    end function

    ' 7.8 -> "7.8", 8 -> "8.0".
    function ratingText(v as dynamic) as string
        tenths = Int(v * 10 + 0.5)
        return Int(tenths / 10).ToStr() + "." + (tenths - Int(tenths / 10) * 10).ToStr()
    end function

    function detailsSource(d as object) as string
        if d.source = "" then return ""
        return "Details from " + d.source
    end function

    ' Add / On Watchlist toggles; Request, Requested or Sign in to Requests
    ' when there is a TMDB id for Seerr. Adding never requests.
    function detailsButtons(isOn as boolean, seerrActive as boolean, requested as boolean, hasTmdb as boolean) as object
        defs = []
        if isOn
            defs.push({ kind: "toggle", label: Chr(10003) + " On Watchlist", primary: false })
        else
            defs.push({ kind: "toggle", label: "Add to Watchlist", primary: true })
        end if
        if not hasTmdb then return defs
        if not seerrActive
            defs.push({ kind: "signin", label: "Sign in to Requests", primary: false })
        else if requested
            defs.push({ kind: "requested", label: "Requested", primary: false })
        else
            defs.push({ kind: "request", label: "Request", primary: isOn })
        end if
        return defs
    end function

    ' ---------- v2: the Requests address set by the server ----------

    ' GET /SashimiLists/Config: the address when the admin set one, "" when
    ' not, or on a 404 (older plugin) or any failure: today's address box.
    function requestsAddress(code as integer, data as dynamic) as string
        if code < 200 or code >= 300 or not Seerr.isAA(data) then return ""
        url = Seerr.getStr(data, "requestsUrl")
        if url = "" then return ""
        scheme = LCase(Left(url, Instr(1, url, "://") - 1))
        if Instr(1, url, "://") = 0 or (scheme <> "http" and scheme <> "https") then return ""
        return Seerr.normalizedServer(url)
    end function

end namespace
